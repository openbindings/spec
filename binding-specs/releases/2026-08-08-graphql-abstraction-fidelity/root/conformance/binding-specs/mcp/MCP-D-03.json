{
  "rule": "MCP-D-03",
  "bindingSpec": "openbindings.mcp@2",
  "section": "7",
  "description": "`ref` is present and is `tools/<name>`; the non-empty remainder after the first slash is matched byte-exactly and unambiguously against the tool listing.",
  "notes": "Resolution-dependent tests carry a pinned listing so the verdict is offline-decidable. Eligibility under outputSchema and task support is processor rule MCP-P-04/MCP-P-08, not document grammar.",
  "tests": [
    {
      "description": "tool ref resolves byte-exactly against the pinned listing",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getWeather": {} },
        "sources": { "server": {
          "bindingSpec": "openbindings.mcp@2",
          "location": "https://mcp.example.com/mcp",
          "content": { "tools": [{ "name": "get_weather", "outputSchema": { "type": "object" } }] }
        } },
        "bindings": { "getWeather.server": { "operation": "getWeather", "source": "server", "ref": "tools/get_weather" } }
      },
      "valid": true
    },
    {
      "description": "the tool-name remainder may contain slashes and is taken verbatim",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "run": {} },
        "sources": { "server": {
          "bindingSpec": "openbindings.mcp@2",
          "location": "https://mcp.example.com/mcp",
          "content": { "tools": [{ "name": "group/run", "outputSchema": { "type": "object" } }] }
        } },
        "bindings": { "run.server": { "operation": "run", "source": "server", "ref": "tools/group/run" } }
      },
      "valid": true
    },
    {
      "description": "grammar-valid tool ref on a location-only source remains unverifiable offline",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getWeather": {} },
        "sources": { "server": { "bindingSpec": "openbindings.mcp@2", "location": "https://mcp.example.com/mcp" } },
        "bindings": { "getWeather.server": { "operation": "getWeather", "source": "server", "ref": "tools/get_weather" } }
      },
      "valid": true
    },
    {
      "description": "ref is required",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getWeather": {} },
        "sources": { "server": { "bindingSpec": "openbindings.mcp@2", "location": "https://mcp.example.com/mcp" } },
        "bindings": { "getWeather.server": { "operation": "getWeather", "source": "server" } }
      },
      "valid": false,
      "violates": ["MCP-D-03"]
    },
    {
      "description": "ref without the tools/name separator is invalid",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getWeather": {} },
        "sources": { "server": { "bindingSpec": "openbindings.mcp@2", "location": "https://mcp.example.com/mcp" } },
        "bindings": { "getWeather.server": { "operation": "getWeather", "source": "server", "ref": "tools" } }
      },
      "valid": false,
      "violates": ["MCP-D-03"]
    },
    {
      "description": "a non-tool entity token is outside revision-2 ref grammar",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "read": {} },
        "sources": { "server": { "bindingSpec": "openbindings.mcp@2", "location": "https://mcp.example.com/mcp" } },
        "bindings": { "read.server": { "operation": "read", "source": "server", "ref": "resources/file:///x" } }
      },
      "valid": false,
      "violates": ["MCP-D-03"]
    },
    {
      "description": "a ref matching nothing in the pinned listing is unresolvable",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "forecast": {} },
        "sources": { "server": {
          "bindingSpec": "openbindings.mcp@2",
          "location": "https://mcp.example.com/mcp",
          "content": { "tools": [{ "name": "weather", "outputSchema": { "type": "object" } }] }
        } },
        "bindings": { "forecast.server": { "operation": "forecast", "source": "server", "ref": "tools/forecast" } }
      },
      "valid": false,
      "violates": ["MCP-D-03"]
    },
    {
      "description": "matching is byte-exact",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "weather": {} },
        "sources": { "server": {
          "bindingSpec": "openbindings.mcp@2",
          "location": "https://mcp.example.com/mcp",
          "content": { "tools": [{ "name": "weather", "outputSchema": { "type": "object" } }] }
        } },
        "bindings": { "weather.server": { "operation": "weather", "source": "server", "ref": "tools/Weather" } }
      },
      "valid": false,
      "violates": ["MCP-D-03"]
    },
    {
      "description": "duplicate matching tools make the ref ambiguous",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "weather": {} },
        "sources": { "server": {
          "bindingSpec": "openbindings.mcp@2",
          "location": "https://mcp.example.com/mcp",
          "content": { "tools": [
            { "name": "weather", "outputSchema": { "type": "object" } },
            { "name": "weather", "outputSchema": { "type": "object" } }
          ] }
        } },
        "bindings": { "weather.server": { "operation": "weather", "source": "server", "ref": "tools/weather" } }
      },
      "valid": false,
      "violates": ["MCP-D-03"]
    },
    {
      "description": "empty remainder is invalid",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "weather": {} },
        "sources": { "server": { "bindingSpec": "openbindings.mcp@2", "location": "https://mcp.example.com/mcp" } },
        "bindings": { "weather.server": { "operation": "weather", "source": "server", "ref": "tools/" } }
      },
      "valid": false,
      "violates": ["MCP-D-03"]
    }
  ]
}
