          "paths": {
            "/items": {
              "post": {
                "operationId": "createItem",
                "requestBody": {
                  "required": true,
                  "content": {
                    "*/*": {
                      "schema": {
                        "type": "object",
                        "properties": { "name": { "type": "string" } },
                        "required": ["name"]
                      }
