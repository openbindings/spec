          "info": { "title": "Parameter content soundness", "version": "1" },
          "servers": [{ "url": "https://api.example.test" }],
          "paths": {
            "/search": {
              "get": {
                "operationId": "search",
                "parameters": [
                  {
                    "name": "filter",
                    "in": "query",
                    "content": {
                      "application/xml": {
                        "schema": { "type": "string" }
                      }
                    }
                  }
