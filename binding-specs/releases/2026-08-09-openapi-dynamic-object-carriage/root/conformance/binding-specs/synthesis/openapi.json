    {
      "id": "OAPI-SS-08",
      "description": "OAS 3.1 schema-omitted raw bytes and schema-declared encoded text are both represented without collapsing their distinct wire carriage.",
      "source": {
        "bindingSpec": "openbindings.openapi@5",
        "content": {
          "openapi": "3.1.2",
          "info": { "title": "OAS 3.1 binary synthesis", "version": "1" },
          "servers": [{ "url": "https://api.example.test" }],
          "paths": {
            "/raw": {
              "put": {
                "operationId": "uploadRaw",
                "requestBody": {
                  "required": true,
                  "content": { "image/png": {} }
                },
                "responses": { "204": { "description": "stored" } }
              }
            },
            "/encoded": {
              "put": {
                "operationId": "uploadEncoded",
                "requestBody": {
                  "required": true,
                  "content": {
                    "image/png": {
                      "schema": {
                        "type": "string",
                        "contentMediaType": "image/png",
                        "contentEncoding": "base64"
                      }
                    }
                  }
                },
                "responses": { "204": { "description": "stored" } }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["uploadEncoded", "uploadRaw"],
        "bindings": [
          {
            "operationKey": "uploadEncoded",
            "bindingRef": "#/paths/~1encoded/put"
          },
          {
            "operationKey": "uploadRaw",
            "bindingRef": "#/paths/~1raw/put"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1encoded/put",
              "scope": "target",
              "status": "represented",
              "operationKey": "uploadEncoded",
              "bindingRef": "#/paths/~1encoded/put",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1encoded/put/requestBody/content/image~1png",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "uploadEncoded",
              "bindingRef": "#/paths/~1encoded/put",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1raw/put",
              "scope": "target",
              "status": "represented",
              "operationKey": "uploadRaw",
              "bindingRef": "#/paths/~1raw/put",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1raw/put/requestBody/content/image~1png",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "uploadRaw",
              "bindingRef": "#/paths/~1raw/put",
              "requirements": []
            }
          ]
        }
      }
    },
    {
      "id": "OAPI-SS-09",
      "description": "A range-only request body remains a represented protocol-blind operation while coverage records the concrete request-media choice required for invocation.",
      "source": {
        "bindingSpec": "openbindings.openapi@5",
        "content": {
