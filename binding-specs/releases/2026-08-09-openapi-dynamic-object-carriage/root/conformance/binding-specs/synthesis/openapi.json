        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1items/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "createItem",
              "bindingRef": "#/paths/~1items/post",
              "requirements": ["configuration.requestMedia"]
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1items/post/requestBody/content/*~1*",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "createItem",
              "bindingRef": "#/paths/~1items/post",
              "requirements": ["configuration.requestMedia"]
            }
          ]
        }
      }
    },
