      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"3.1.0","info":{"title":"Bad"}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
