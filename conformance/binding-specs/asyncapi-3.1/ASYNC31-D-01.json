      "document": {"openbindings":"0.2.0","operations":{"call":{}} ,"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"asyncapi: 3.1.0\ninfo: {title: Core, version: '1'}\nyes: yes\n01: 1\nservers: {}\nchannels: {}\noperations: {}\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": true
    },
    {
      "description": "a relative co-present location is invalid even though content has primacy",
      "document": {"openbindings":"0.2.0","operations":{"call":{}} ,"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","location":"relative.yaml","content":{"asyncapi":"3.1.0","info":{"title":"Bad base","version":"1"}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01", "OBI-D-05"]
    },
