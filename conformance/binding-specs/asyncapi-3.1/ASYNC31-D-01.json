    },
    {
      "description": "the exact-edition gate rejects AsyncAPI 3.0.0",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"3.0.0","info":{"title":"Old","version":"1"}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "flow and block collections comments indentation and an alias compose as one YAML 1.2.2 document",
      "document": {"openbindings":"0.2.0","operations":{"call":{}} ,"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"# complete YAML composition\nasyncapi: 3.1.0\ninfo: {title: Flow, version: '1'}\nserver: &server\n  host: example.test\n  protocol: http\nservers:\n  s: *server\nchannels: {c: {}}\noperations:\n  op: {action: send, channel: {$ref: '#/channels/c'}}\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": true
    },
    {
      "description": "JSON-compatible explicit YAML tags compose without enabling application tags",
      "document": {"openbindings":"0.2.0","operations":{"call":{}} ,"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"asyncapi: !!str 3.1.0\ninfo: !!map {title: !!str Tagged, version: !!str '1'}\nservers: {}\nchannels: {}\noperations: {}\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": true
    },
    {
