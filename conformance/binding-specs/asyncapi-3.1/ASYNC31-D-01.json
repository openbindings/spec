      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"3.1.0"}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "Info with a non-string version is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"3.1.0","info":{"title":"Bad","version":1}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "a non-map root operations container is rejected globally",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"3.1.0","info":{"title":"Bad","version":"1"},"operations":[]}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "duplicate YAML mapping keys are rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"asyncapi: 3.1.0\nasyncapi: 3.1.0\ninfo: {title: Duplicate, version: '1'}\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
