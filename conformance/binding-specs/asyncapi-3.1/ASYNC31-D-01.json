      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"3.2.0","info":{"title":"Bad","version":"1"}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "a later major edition is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"4.0.0","info":{"title":"Bad","version":"1"}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "Info missing required title is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"3.1.0","info":{"version":"1"}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "negative infinity with no JSON image is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"asyncapi: 3.1.0\ninfo: {title: Bad, version: '1'}\nvalue: -.inf\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "NaN with no JSON image is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"asyncapi: 3.1.0\ninfo: {title: Bad, version: '1'}\nvalue: .nan\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
