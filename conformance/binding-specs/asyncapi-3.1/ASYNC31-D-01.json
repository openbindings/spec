{
  "rule": "ASYNC31-D-01",
  "bindingSpec": "openbindings.asyncapi-3.1@1",
  "section": "3",
  "description": "Source carriage, deterministic object/YAML representation, exact edition, Info envelope, and root map-container shapes satisfy the closed load gate.",
  "tests": [
    {
      "description": "exact 3.1.0 object content passes the load gate",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"3.1.0","info":{"title":"Kernel","version":"1"},"servers":{"s":{"host":"example.test","protocol":"test"}},"channels":{"c":{}},"operations":{"op":{"action":"send","channel":{"$ref":"#/channels/c"}}}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": true
    },
    {
      "description": "a leading BOM and one YAML 1.2.2 document are accepted",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"﻿asyncapi: 3.1.0\ninfo: {title: Kernel, version: '1'}\nservers: {s: {host: example.test, protocol: test}}\nchannels: {c: {}}\noperations: {op: {action: send, channel: {$ref: '#/channels/c'}}}\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": true
    },
    {
      "description": "a location-only source uses the absolute entry URI and UTF-8 representation convention",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","location":"https://example.test/api.yaml"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": true
    },
    {
      "description": "a YAML non-scalar mapping key is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"asyncapi: 3.1.0\ninfo: {title: Bad, version: '1'}\n? [bad, key]\n: value\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "an explicit application tag is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"asyncapi: 3.1.0\ninfo: !example {title: Bad, version: '1'}\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "positive infinity with no JSON image is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"asyncapi: 3.1.0\ninfo: {title: Bad, version: '1'}\nvalue: .inf\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "a multi-document YAML stream is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":"asyncapi: 3.1.0\ninfo: {title: One, version: '1'}\n---\nasyncapi: 3.1.0\ninfo: {title: Two, version: '1'}\n"}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "a prerelease edition is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":"3.1.0-rc.1","info":{"title":"Bad","version":"1"}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
      "description": "a non-string edition is rejected",
      "document": {"openbindings":"0.2.0","operations":{"call":{}},"sources":{"api":{"bindingSpec":"openbindings.asyncapi-3.1@1","content":{"asyncapi":3.1,"info":{"title":"Bad","version":"1"}}}},"bindings":{"call.api":{"operation":"call","source":"api","selector":"#/servers/s/operations/op"}}},
      "valid": false,
      "violates": ["ASYNC31-D-01"]
    },
    {
