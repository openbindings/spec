              },
              "operations": {
                "op%2Fpart": {
                  "action": "receive",
                  "channel": {
                    "$ref": "#/channels/c"
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "call.api": {
            "operation": "call",
            "source": "api",
            "selector": "#/servers/s/operations/op%2Fpart"
          }
        }
      },
      "valid": true
    },
