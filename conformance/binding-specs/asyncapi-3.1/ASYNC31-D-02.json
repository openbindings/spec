{
  "rule": "ASYNC31-D-02",
  "bindingSpec": "openbindings.asyncapi-3.1@1",
  "section": "4",
  "description": "A present selector has the canonical conceptual server/operation cell spelling; absence applies the represented-cell zero/one/many rule.",
  "tests": [
    {
      "description": "a canonical selector escapes only the operation token",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "call": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.asyncapi-3.1@1",
            "content": {
              "asyncapi": "3.1.0",
              "info": {
                "title": "Selector",
                "version": "1"
              },
              "servers": {
                "s": {
                  "host": "example.test",
                  "protocol": "test"
                }
              },
              "channels": {
                "c": {}
              },
              "operations": {
                "op/a~b": {
                  "action": "receive",
                  "channel": {
                    "$ref": "#/channels/c"
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "call.api": {
            "operation": "call",
            "source": "api",
            "selector": "#/servers/s/operations/op~1a~0b"
          }
        }
      },
      "valid": true
    },
    {
      "description": "a percent triplet is literal and is not decoded into a slash",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "call": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.asyncapi-3.1@1",
