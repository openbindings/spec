{
  "rule": "ASYNC31-D-06",
  "bindingSpec": "openbindings.asyncapi-3.1@1",
  "section": "5",
  "description": "Static origin-form and exact bodyless HTTP request.",
  "tests": [
    {
      "description": "the static server base and channel address form one origin path",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "call": {
            "input": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          }
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.asyncapi-3.1@1",
            "content": {
              "asyncapi": "3.1.0",
              "info": {
                "title": "C21",
                "version": "1"
              },
              "servers": {
                "s": {
                  "host": "example.test",
                  "protocol": "http",
                  "pathname": "/api"
                }
              },
              "channels": {
                "c": {
                  "address": "/events",
                  "messages": {
                    "m": {}
                  }
                }
              },
              "operations": {
                "op": {
                  "action": "receive",
                  "channel": {
                    "$ref": "#/channels/c"
                  },
                  "bindings": {
                    "http": {}
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "call.api": {
            "operation": "call",
            "source": "api",
            "selector": "#/servers/s/operations/op"
          }
        }
      },
      "valid": true
    },
