{
  "rule": "ASYNC31-D-07",
  "bindingSpec": "openbindings.asyncapi-3.1@1",
  "section": "5",
  "description": "HTTP response, terminal outcome, and zero-output boundary.",
  "tests": [
    {
      "description": "a zero-content 204 completion has no output",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "call": {
            "input": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          }
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.asyncapi-3.1@1",
            "content": {
              "asyncapi": "3.1.0",
              "info": {
                "title": "C21",
                "version": "1"
              },
              "servers": {
                "s": {
                  "host": "example.test",
                  "protocol": "http",
                  "pathname": "/api"
                }
              },
              "channels": {
                "c": {
                  "address": "/events",
                  "messages": {
                    "m": {}
                  }
                }
              },
              "operations": {
                "op": {
                  "action": "receive",
                  "channel": {
                    "$ref": "#/channels/c"
                  },
                  "bindings": {
                    "http": {}
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "call.api": {
            "operation": "call",
            "source": "api",
            "selector": "#/servers/s/operations/op"
          }
        }
      },
      "valid": true
    },
