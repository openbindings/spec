        "sources": {
          "api": {
            "bindingSpec": "openbindings.graphql@1",
            "location": "https://api.example.test/graphql",
            "content": {
              "document": "query Viewer($id: ID!) { viewer(id: $id) { id name } }\nquery Status { status }\nquery Find($filter: Filter!) { find(filter: $filter) { id } }\nmutation Rename($id: ID!, $name: String!) { rename(id: $id, name: $name) { id name } }\n",
              "schema": "type Query { viewer(id: ID!): User status: String find(filter: Filter!): User }\ntype Mutation { rename(id: ID!, name: String!): User }\ntype User { id: ID! name: String }\ninput Filter @oneOf { byId: ID byName: String }\n"
            }
          }
        },
        "bindings": {
          "Viewer.api": {
            "operation": "Viewer",
            "source": "api",
            "selector": "Viewer"
          }
        }
      },
      "valid": true
    },
