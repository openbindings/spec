{
  "rule": "GQL-D-03",
  "bindingSpec": "openbindings.graphql@1",
  "section": "3.2",
  "description": "Each such source's `document` parses as an executable document under §2 of the governing edition and contains no type-system definition or extension, and its `schema`, when present, parses as a type-system document when a string or carries an object at `data.__schema` and no `errors` entry when an object.",
  "tests": [
    {
      "description": "well-formed executable document, type-system-language schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "Viewer": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.graphql@1",
            "location": "https://api.example.test/graphql",
            "content": {
              "document": "query Viewer($id: ID!) { viewer(id: $id) { id name } }\nquery Status { status }\nquery Find($filter: Filter!) { find(filter: $filter) { id } }\nmutation Rename($id: ID!, $name: String!) { rename(id: $id, name: $name) { id name } }\n",
              "schema": "type Query { viewer(id: ID!): User status: String find(filter: Filter!): User }\ntype Mutation { rename(id: ID!, name: String!): User }\ntype User { id: ID! name: String }\ninput Filter @oneOf { byId: ID byName: String }\n"
            }
          }
        },
        "bindings": {
          "Viewer.api": {
            "operation": "Viewer",
            "source": "api",
            "selector": "Viewer"
          }
        }
      },
      "valid": true
    },
