{
  "rule": "GRPC-D-01",
  "bindingSpec": "openbindings.grpc@1",
  "section": "3",
  "description": "`content`, when present, is exactly single-file proto text, strict ProtoJSON FileDescriptorSet, or the disjoint canonical-Base64 `$fileDescriptorSet` carrier; absent content selects reflection.",
  "notes": "Verifying the proto and descriptor forms requires Protobuf capability. A validator without it reports those cases unverified rather than guessing. Descriptor-range and smallest-owner cases are exercised by portable processor and synthesis evidence.",
  "tests": [
    {
      "description": "string content: single-file proto3 source text with no imports",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getMenu": {} },
        "sources": {
          "shop": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "api.example.com:443",
            "content": "syntax = \"proto3\";\npackage blend;\nservice CoffeeShop {\n  rpc GetMenu(MenuRequest) returns (Menu);\n}\nmessage MenuRequest {}\nmessage Menu {\n  repeated string items = 1;\n}\n"
          }
        },
        "bindings": {
          "getMenu.shop": {
            "operation": "getMenu",
            "source": "shop",
            "selector": "blend.CoffeeShop/GetMenu"
          }
        }
      },
      "valid": true
    },
    {
      "description": "string content importing one file from the exact google/protobuf allowlist, which processors resolve from their bundled copies",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "ping": {} },
        "sources": {
          "shop": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "api.example.com:443",
            "content": "syntax = \"proto3\";\npackage blend;\nimport \"google/protobuf/empty.proto\";\nservice CoffeeShop {\n  rpc Ping(google.protobuf.Empty) returns (google.protobuf.Empty);\n}\n"
          }
        },
        "bindings": {
          "ping.shop": {
            "operation": "ping",
            "source": "shop",
            "selector": "blend.CoffeeShop/Ping"
          }
        }
      },
      "valid": true
    },
    {
      "description": "object content: a FileDescriptorSet in canonical protobuf JSON",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getMenu": {} },
        "sources": {
          "shop": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "api.example.com:443",
            "content": {
              "file": [
                {
                  "name": "coffee.proto",
                  "package": "blend",
                  "syntax": "proto3",
                  "messageType": [
                    { "name": "MenuRequest" },
                    {
                      "name": "Menu",
                      "field": [
                        {
                          "name": "items",
                          "number": 1,
                          "label": "LABEL_REPEATED",
                          "type": "TYPE_STRING",
                          "jsonName": "items"
                        }
                      ]
                    }
                  ],
                  "service": [
                    {
                      "name": "CoffeeShop",
                      "method": [
                        {
                          "name": "GetMenu",
                          "inputType": ".blend.MenuRequest",
                          "outputType": ".blend.Menu"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "bindings": {
          "getMenu.shop": {
            "operation": "getMenu",
            "source": "shop",
            "selector": "blend.CoffeeShop/GetMenu"
          }
        }
      },
      "valid": true
    },
    {
      "description": "string content: a user message type reused in two sibling fields (Pair.a and Pair.b are both Point) compiles and is accepted — DAG reuse in the source is not a bind-time defect",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getPair": {} },
        "sources": {
          "shop": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "api.example.com:443",
            "content": "syntax = \"proto3\";\npackage blend;\nservice CoffeeShop {\n  rpc GetPair(PairRequest) returns (Pair);\n}\nmessage PairRequest {}\nmessage Point {\n  string label = 1;\n}\nmessage Pair {\n  Point a = 1;\n  Point b = 2;\n}\n"
          }
        },
        "bindings": {
          "getPair.shop": {
            "operation": "getPair",
            "source": "shop",
            "selector": "blend.CoffeeShop/GetPair"
          }
        }
      },
      "valid": true
    },
    {
      "description": "string content importing outside the exact google/protobuf allowlist is refused loudly at load: a schema needing more carries the descriptor-set form",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getMenu": {} },
        "sources": {
          "shop": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "api.example.com:443",
            "content": "syntax = \"proto3\";\npackage blend;\nimport \"acme/common.proto\";\nservice CoffeeShop {\n  rpc GetMenu(acme.Empty) returns (acme.Menu);\n}\n"
          }
        },
        "bindings": {
          "getMenu.shop": {
            "operation": "getMenu",
            "source": "shop",
            "selector": "blend.CoffeeShop/GetMenu"
          }
        }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    },
    {
      "description": "content carrying a JSON number is neither carriage",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getMenu": {} },
        "sources": {
          "shop": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "api.example.com:443",
            "content": 42
          }
        },
        "bindings": {
          "getMenu.shop": {
            "operation": "getMenu",
            "source": "shop",
            "selector": "blend.CoffeeShop/GetMenu"
          }
        }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    },
    {
      "description": "content carrying a JSON array is neither carriage",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getMenu": {} },
        "sources": {
          "shop": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "api.example.com:443",
            "content": [{ "name": "coffee.proto" }]
          }
        },
        "bindings": {
          "getMenu.shop": {
            "operation": "getMenu",
            "source": "shop",
            "selector": "blend.CoffeeShop/GetMenu"
          }
        }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    },
    {
      "description": "unknown member in the content object is refused loudly, matching this family's input posture",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getMenu": {} },
        "sources": {
          "shop": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "api.example.com:443",
            "content": {
              "file": [
                {
                  "name": "coffee.proto",
                  "package": "blend",
                  "syntax": "proto3",
                  "messageType": [{ "name": "MenuRequest" }, { "name": "Menu" }],
                  "service": [
                    {
                      "name": "CoffeeShop",
                      "method": [
                        {
                          "name": "GetMenu",
                          "inputType": ".blend.MenuRequest",
                          "outputType": ".blend.Menu"
                        }
                      ]
                    }
                  ]
                }
              ],
              "registry": "internal"
            }
          }
        },
        "bindings": {
          "getMenu.shop": {
            "operation": "getMenu",
            "source": "shop",
            "selector": "blend.CoffeeShop/GetMenu"
          }
        }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    },
    {
      "description": "tagged binary FileDescriptorSet uses canonical padded Base64 and resolves the selected method",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "get": {} },
        "sources": {
          "svc": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "grpc://localhost:50051",
            "content": {
              "$fileDescriptorSet": "CkwKDHNvdXJjZS5wcm90bxIEZGVtbyIFCgNSZXEiBQoDUmVzMiAKAVMSGwoDR2V0EgkuZGVtby5SZXEaCS5kZW1vLlJlc2IGcHJvdG8z"
            }
          }
        },
        "bindings": {
          "get.svc": {
            "operation": "get",
            "source": "svc",
            "selector": "demo.S/Get"
          }
        }
      },
      "valid": true
    },
    {
      "description": "tagged descriptor carrier rejects omitted canonical Base64 padding",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "get": {} },
        "sources": {
          "svc": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "grpc://localhost:50051",
            "content": { "$fileDescriptorSet": "CgA" }
          }
        },
        "bindings": {
          "get.svc": {
            "operation": "get",
            "source": "svc",
            "selector": "demo.S/Get"
          }
        }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    },
    {
      "description": "tagged descriptor carrier is closed and rejects a second member",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "get": {} },
        "sources": {
          "svc": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "grpc://localhost:50051",
            "content": { "$fileDescriptorSet": "CgA=", "format": "protobuf" }
          }
        },
        "bindings": {
          "get.svc": {
            "operation": "get",
            "source": "svc",
            "selector": "demo.S/Get"
          }
        }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    },
    {
      "description": "a google/protobuf prefix does not widen the exact import allowlist",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "get": {} },
        "sources": {
          "svc": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "grpc://localhost:50051",
            "content": "syntax = \"proto3\"; import \"google/protobuf/cpp_features.proto\"; package demo; service S { rpc Get(Req) returns (Res); } message Req {} message Res {}"
          }
        },
        "bindings": {
          "get.svc": {
            "operation": "get",
            "source": "svc",
            "selector": "demo.S/Get"
          }
        }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    },
    {
      "description": "bracket-keyed extension member (compiled custom option) is refused loudly: a conformant pin carries option-stripped descriptors",
      "document": {
        "openbindings": "0.2.0",
        "operations": { "getMenu": {} },
        "sources": {
          "shop": {
            "bindingSpec": "openbindings.grpc@1",
            "location": "api.example.com:443",
            "content": {
              "file": [
                {
                  "name": "coffee.proto",
                  "package": "blend",
                  "syntax": "proto3",
                  "options": { "[acme.file_audit]": true },
                  "messageType": [{ "name": "MenuRequest" }, { "name": "Menu" }],
                  "service": [
                    {
                      "name": "CoffeeShop",
                      "method": [
                        {
                          "name": "GetMenu",
                          "inputType": ".blend.MenuRequest",
                          "outputType": ".blend.Menu"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "bindings": {
          "getMenu.shop": {
            "operation": "getMenu",
            "source": "shop",
            "selector": "blend.CoffeeShop/GetMenu"
          }
        }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    },
    {
      "description": "strict Edition 2026 JSON-FDS admits the exact pb.enumvalue.json option at its EnumValueOptions owner",
      "document": {
        "openbindings": "0.2.0", "operations": { "get": {} },
        "sources": { "svc": { "bindingSpec": "openbindings.grpc@1", "location": "grpc://localhost:50051", "content": {
          "file": [{
            "name": "enum.proto", "package": "demo", "syntax": "editions", "edition": "EDITION_2026",
            "enumType": [{ "name": "State", "value": [{ "name": "STATE_UNSPECIFIED", "number": 0 }, { "name": "STATE_READY", "number": 1, "options": { "[pb.enumvalue.json]": { "string": "ready" } } }] }],
            "messageType": [{ "name": "Req" }, { "name": "Res" }],
            "service": [{ "name": "S", "method": [{ "name": "Get", "inputType": ".demo.Req", "outputType": ".demo.Res" }] }]
          }]
        } } },
        "bindings": { "get.svc": { "operation": "get", "source": "svc", "selector": "demo.S/Get" } }
      },
      "valid": true
    },
    {
      "description": "pb.enumvalue.json is refused at a non-EnumValueOptions owner",
      "document": {
        "openbindings": "0.2.0", "operations": { "get": {} },
        "sources": { "svc": { "bindingSpec": "openbindings.grpc@1", "location": "grpc://localhost:50051", "content": {
          "file": [{ "name": "bad.proto", "package": "demo", "syntax": "editions", "edition": "EDITION_2026", "options": { "[pb.enumvalue.json]": { "string": "bad" } }, "messageType": [{ "name": "Req" }, { "name": "Res" }], "service": [{ "name": "S", "method": [{ "name": "Get", "inputType": ".demo.Req", "outputType": ".demo.Res" }] }] }]
        } } },
        "bindings": { "get.svc": { "operation": "get", "source": "svc", "selector": "demo.S/Get" } }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    },
    {
      "description": "an arbitrary bracket-keyed EnumValueOptions extension is outside the closed JSON-FDS registry",
      "document": {
        "openbindings": "0.2.0", "operations": { "get": {} },
        "sources": { "svc": { "bindingSpec": "openbindings.grpc@1", "location": "grpc://localhost:50051", "content": {
          "file": [{ "name": "bad.proto", "package": "demo", "syntax": "editions", "edition": "EDITION_2026", "enumType": [{ "name": "State", "value": [{ "name": "STATE_UNSPECIFIED", "number": 0, "options": { "[acme.enum_json]": { "string": "bad" } } }] }], "messageType": [{ "name": "Req" }, { "name": "Res" }], "service": [{ "name": "S", "method": [{ "name": "Get", "inputType": ".demo.Req", "outputType": ".demo.Res" }] }] }]
        } } },
        "bindings": { "get.svc": { "operation": "get", "source": "svc", "selector": "demo.S/Get" } }
      },
      "valid": false,
      "violates": ["GRPC-D-01"]
    }
  ]
}
