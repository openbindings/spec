{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/binding-specs/harness-probes/processor-v7.schema.json",
  "title": "Processor-scenario revision-7 HTTP scaffold qualification probes",
  "description": "Schema and version-isolation qualification for the staged AsyncAPI HTTP peer/native revision-2 and runtime vocabulary. This artifact does not claim TLS path validation or the future HTTP semantic trial matrix.",
  "type": "object",
  "required": ["format", "description", "cases"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "openbindings.binding-spec-harness-probes@2" },
    "description": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "validator", "valid", "description", "subject"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^V7-SCAFFOLD-[A-Z0-9-]+-[0-9]{2,}$" },
        "validator": {
          "enum": [
            "http-peer@2",
            "http-native@2",
            "http-runtime@2",
            "processor-scenario",
            "synthesis-scenario",
            "dialect-correlation",
            "http-peer-mapper@2",
            "key-materialization-path"
          ]
        },
        "valid": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "subject": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "validator": { "const": "dialect-correlation" } },
            "required": ["validator"]
          },
          "then": {
            "properties": {
              "subject": {
                "type": "object",
                "required": ["peerDialect", "nativeDialect"],
                "additionalProperties": false,
                "properties": {
                  "peerDialect": { "type": "string", "minLength": 1 },
                  "nativeDialect": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "validator": { "const": "http-peer-mapper@2" } },
            "required": ["validator"]
          },
          "then": {
            "properties": {
              "subject": {
                "type": "object",
                "required": ["script", "expected"],
                "additionalProperties": false,
                "properties": {
                  "script": { "$ref": "../peer-dialects/asyncapi-http-peer-2.schema.json" },
                  "expected": {
                    "type": "object",
                    "required": ["classification", "coverageTokens"],
                    "additionalProperties": false,
                    "properties": {
                      "classification": {
                        "enum": ["successful-final", "unsuccessful-final", "incomplete", "peer-disconnect", "protocol-error"]
                      },
                      "coverageTokens": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "http-peer@2:map", "http-peer@2:response-head", "http-peer@2:interim",
                            "http-peer@2:final", "http-peer@2:body", "http-peer@2:disconnect",
                            "http-peer@2:successful-final", "http-peer@2:unsuccessful-final",
                            "http-peer@2:incomplete", "http-peer@2:peer-disconnect", "http-peer@2:protocol-error"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "validator": { "const": "key-materialization-path" } },
            "required": ["validator"]
          },
          "then": {
            "properties": {
              "subject": {
                "type": "object",
                "required": ["context", "path"],
                "additionalProperties": false,
                "properties": {
                  "context": { "enum": ["processor", "synthesis"] },
                  "path": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
