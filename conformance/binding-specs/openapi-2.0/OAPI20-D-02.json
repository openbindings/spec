{
  "rule": "OAPI20-D-02",
  "bindingSpec": "openbindings.openapi-2.0@1",
  "section": "6",
  "description": "The binding names this exact binding specification, carries a literal selector admitted by the sibling, and identifies a source inside its exact edition gate.",
  "notes": "Resolution-dependent tests embed the artifact so the verdict is offline-decidable. The two explicit gate negatives keep family identifiers and accepted editions exact rather than inferred from adjacent siblings.",
  "tests": [
    {
      "description": "pointer addressing a declared operation, path escaped per RFC 6901",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-2.0@1",
            "content": {
              "swagger": "2.0",
              "info": {
                "title": "Tasks",
                "version": "1.0.0"
              },
              "paths": {
                "/tasks": {
                  "post": {
                    "responses": {
                      "200": {
                        "description": "Created"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "createTask.api": {
            "operation": "createTask",
            "source": "api",
            "selector": "#/paths/~1tasks/post"
          }
        }
      },
      "valid": true
    },
    {
      "description": "templated multi-segment path, every / escaped as ~1",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getUser": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-2.0@1",
            "content": {
              "swagger": "2.0",
              "info": {
                "title": "Users",
                "version": "1.0.0"
              },
              "paths": {
                "/users/{userId}": {
                  "get": {
                    "parameters": [
                      {
                        "name": "userId",
                        "in": "path",
                        "required": true,
                        "schema": {
                          "type": "string"
                        }
                      }
                    ],
                    "responses": {
                      "200": {
                        "description": "OK"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "source": "api",
            "selector": "#/paths/~1users~1{userId}/get"
          }
        }
      },
      "valid": true
    },
    {
      "description": "selector is required: the OAS defines no whole-artifact invocation",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-2.0@1",
            "content": {
              "swagger": "2.0",
              "info": {
                "title": "Tasks",
                "version": "1.0.0"
              },
              "paths": {
                "/tasks": {
                  "post": {
                    "responses": {
                      "200": {
                        "description": "Created"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "createTask.api": {
            "operation": "createTask",
            "source": "api"
          }
        }
      },
      "valid": false,
      "violates": [
        "OAPI20-D-02"
      ]
    },
    {
      "description": "uppercase method is refused, never case-folded: methods are lowercase exactly as the artifact spells them",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-2.0@1",
            "content": {
              "swagger": "2.0",
              "info": {
                "title": "Tasks",
                "version": "1.0.0"
              },
              "paths": {
                "/tasks": {
                  "post": {
                    "responses": {
                      "200": {
                        "description": "Created"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "createTask.api": {
            "operation": "createTask",
            "source": "api",
            "selector": "#/paths/~1tasks/POST"
          }
        }
      },
      "valid": false,
      "violates": [
        "OAPI20-D-02"
      ]
    },
    {
      "description": "pointer without the # fragment prefix is not the required form",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-2.0@1",
            "content": {
              "swagger": "2.0",
              "info": {
                "title": "Tasks",
