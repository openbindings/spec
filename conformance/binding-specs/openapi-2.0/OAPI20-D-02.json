            "source": "api",
            "selector": "/paths/~1tasks/post"
          }
        }
      },
      "valid": false,
      "violates": [
        "OAPI20-D-02"
      ]
    },
    {
      "description": "unescaped path slash breaks the two-segment form: the path segment carries RFC 6901 escaping",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getUser": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-2.0@1",
            "content": {
              "swagger": "2.0",
              "info": {
                "title": "Users",
                "version": "1.0.0"
              },
              "paths": {
                "/users/{userId}": {
                  "get": {
                    "parameters": [
                      {
                        "name": "userId",
                        "in": "path",
                        "required": true,
                        "schema": {
                          "type": "string"
                        }
                      }
                    ],
                    "responses": {
                      "200": {
                        "description": "OK"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "source": "api",
            "selector": "#/paths//users/{userId}/get"
          }
        }
      },
      "valid": false,
      "violates": [
        "OAPI20-D-02"
      ]
    },
    {
      "description": "percent-encoded rendering of an otherwise-valid target denotes nothing: the pointer is a verbatim string, never percent-decoded, and `#/paths/~1users~1%7BuserId%7D/get` is not the one spelling `#/paths/~1users~1{userId}/get`",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getUser": {}
        },
        "sources": {
          "api": {
            "bindingSpec": "openbindings.openapi-2.0@1",
            "content": {
              "swagger": "2.0",
              "info": {
                "title": "Users",
                "version": "1.0.0"
              },
              "paths": {
                "/users/{userId}": {
                  "get": {
                    "parameters": [
                      {
                        "name": "userId",
                        "in": "path",
                        "required": true,
                        "schema": {
                          "type": "string"
                        }
                      }
                    ],
                    "responses": {
                      "200": {
                        "description": "OK"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "source": "api",
            "selector": "#/paths/~1users~1%7BuserId%7D/get"
          }
        }
      },
      "valid": false,
      "violates": [
        "OAPI20-D-02"
      ]
    },
    {
      "description": "pointer missing the method segment does not address an operation object",
