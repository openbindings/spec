{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/binding-specs/peer-dialects/asyncapi-http-native-1.schema.json",
  "title": "AsyncAPI HTTP normalized native observation revision 1",
  "oneOf": [
    {
      "$ref": "#/$defs/dispatch"
    },
    {
      "$ref": "#/$defs/acknowledgement"
    },
    {
      "$ref": "#/$defs/connection"
    },
    {
      "$ref": "#/$defs/cancellation"
    }
  ],
  "$defs": {
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "string" }
        }
      }
    },
    "dispatch": {
      "type": "object",
      "required": ["kind", "name", "facts"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" },
        "name": { "const": "dispatch" },
        "facts": {
          "type": "object",
          "required": ["method", "target", "headers", "bodyBase64"],
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "headers": { "$ref": "#/$defs/headers" },
            "bodyBase64": { "$ref": "#/$defs/base64" }
          }
        }
      }
    },
    "acknowledgement": {
      "type": "object",
      "required": ["kind", "name", "facts"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" },
        "name": { "const": "acknowledgement" },
        "facts": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "integer", "minimum": 200, "maximum": 599 }
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "required": ["kind", "name", "facts"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" },
        "name": { "enum": ["connection-opened", "connection-closed"] },
        "facts": {
          "type": "object",
          "required": ["origin"],
          "additionalProperties": false,
          "properties": { "origin": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "cancellation": {
      "type": "object",
      "required": ["kind", "name", "facts"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" },
        "name": { "const": "cancellation-propagated" },
        "facts": { "type": "object", "maxProperties": 0 }
      }
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
