{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/binding-specs/peer-dialects/asyncapi-http-peer-1.schema.json",
  "title": "AsyncAPI HTTP peer script revision 1",
  "type": "object",
  "required": ["after", "outcome"],
  "additionalProperties": false,
  "properties": {
    "after": { "$ref": "#/$defs/trigger" },
    "outcome": { "enum": ["response", "disconnect"] },
    "status": {
      "type": "integer",
      "minimum": 200,
      "maximum": 599,
      "description": "One final response status; revision 1 does not model interim 1xx sequences."
    },
    "headers": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    },
    "bodyBase64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "disconnectAt": {
      "enum": ["before-request", "after-request", "before-response", "during-response-body"]
    }
  },
  "$defs": {
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "start" } }
        },
        {
          "type": "object",
          "required": ["kind", "index"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "action" },
            "index": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "count"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "native" },
            "name": {
              "enum": [
                "dispatch",
                "acknowledgement",
                "connection-opened",
                "connection-closed",
                "cancellation-propagated"
              ]
            },
            "count": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "response" } },
        "required": ["outcome"]
      },
      "then": {
        "required": ["status", "headers", "bodyBase64"],
        "not": { "required": ["disconnectAt"] }
      },
      "else": {
        "required": ["disconnectAt"],
        "not": {
          "anyOf": [
            { "required": ["status"] },
            { "required": ["headers"] },
            { "required": ["bodyBase64"] }
          ]
        }
      }
    }
  ]
}
