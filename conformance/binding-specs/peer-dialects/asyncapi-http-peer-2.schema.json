{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/binding-specs/peer-dialects/asyncapi-http-peer-2.schema.json",
  "title": "AsyncAPI HTTP peer script revision 2",
  "description": "Closed HTTP/1.1 cleartext/TLS stimulus scaffold for processor scenarios revision 7. Shape validity does not claim certificate-path or profile-semantic validity.",
  "type": "object",
  "required": ["transport", "events"],
  "additionalProperties": false,
  "properties": {
    "transport": { "enum": ["cleartext", "tls"] },
    "tls": { "$ref": "#/$defs/tls" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "transport": { "const": "tls" } },
        "required": ["transport"]
      },
      "then": { "required": ["tls"] },
      "else": { "not": { "required": ["tls"] } }
    },
    {
      "if": {
        "properties": {
          "transport": { "const": "tls" },
          "tls": {
            "properties": { "serverTlsVersionSelected": { "type": "null" } },
            "required": ["serverTlsVersionSelected"]
          }
        },
        "required": ["transport", "tls"]
      },
      "then": {
        "properties": {
          "tls": {
            "properties": { "serverAlpnSelected": { "type": "null" } },
            "required": ["serverAlpnSelected"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": { "const": "tls" },
          "events": {
            "contains": {
              "anyOf": [
                {
                  "properties": { "kind": { "enum": ["response-head", "body-chunk"] } },
                  "required": ["kind"]
                },
                {
                  "properties": {
                    "kind": { "const": "disconnect" },
                    "stage": { "enum": ["during-request", "before-response", "during-response"] }
                  },
                  "required": ["kind", "stage"]
                },
                {
                  "properties": {
                    "kind": { "const": "disconnect" },
                    "after": {
                      "properties": {
                        "kind": { "const": "native" },
                        "name": { "enum": ["dispatch", "request-started", "acknowledgement", "delivery"] }
                      },
                      "required": ["kind", "name"]
                    }
                  },
                  "required": ["kind", "after"]
                }
              ]
            }
          }
        },
        "required": ["transport", "events"]
      },
      "then": {
        "properties": {
          "tls": {
            "properties": {
              "serverTlsVersionSelected": { "const": "1.3" },
              "serverAlpnSelected": { "const": "http/1.1" }
            },
            "required": ["serverTlsVersionSelected", "serverAlpnSelected"]
          }
        }
      }
    }
  ],
  "$defs": {
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "field": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
        "value": { "type": "string" }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "start" } }
        },
        {
          "type": "object",
          "required": ["kind", "index"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "action" },
            "index": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "count"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "native" },
            "name": {
              "enum": [
                "connection-attempted",
                "connection-opened",
                "request-started",
                "dispatch",
                "acknowledgement",
                "delivery",
                "connection-closed",
                "cancellation-propagated"
              ]
            },
            "count": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "tls": {
      "type": "object",
      "required": [
        "serverCertificateChainDerBase64",
        "serverPrivateKeyCapability",
        "clientTlsVersionsOffered",
        "observedSni",
        "clientAlpnOffered",
        "serverTlsVersionSelected",
        "serverAlpnSelected"
      ],
      "additionalProperties": false,
      "properties": {
        "serverCertificateChainDerBase64": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/base64" }
        },
        "serverPrivateKeyCapability": { "type": "string", "minLength": 1 },
        "clientTlsVersionsOffered": { "const": ["1.3"] },
        "observedSni": { "type": ["string", "null"], "minLength": 1 },
        "clientAlpnOffered": { "const": ["http/1.1"] },
        "serverTlsVersionSelected": { "enum": ["1.3", null] },
        "serverAlpnSelected": { "enum": ["http/1.1", null] },
        "requireClientCertificate": { "const": true },
        "clientTrustAnchorsDerBase64": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/base64" }
        }
      },
      "dependentRequired": {
        "requireClientCertificate": ["clientTrustAnchorsDerBase64"],
        "clientTrustAnchorsDerBase64": ["requireClientCertificate"]
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "after", "httpVersion", "status", "headers"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "response-head" },
            "after": { "$ref": "#/$defs/trigger" },
            "httpVersion": { "const": "1.1" },
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "headers": { "type": "array", "items": { "$ref": "#/$defs/field" } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "after", "dataBase64"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "body-chunk" },
            "after": { "$ref": "#/$defs/trigger" },
            "dataBase64": { "$ref": "#/$defs/base64" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "after", "stage"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "disconnect" },
            "after": { "$ref": "#/$defs/trigger" },
            "stage": {
              "enum": ["before-connect", "during-tls", "before-request", "during-request", "before-response", "during-response"]
            }
          }
        }
      ]
    }
  }
}
