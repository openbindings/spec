{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/binding-specs/peer-dialects/asyncapi-kafka-peer-1.schema.json",
  "title": "AsyncAPI Kafka peer script revision 1",
  "type": "object",
  "required": ["events"],
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["after", "kind", "topic", "partition", "offset"],
            "additionalProperties": false,
            "properties": {
              "after": { "$ref": "#/$defs/trigger" },
              "kind": { "const": "produce-ack" },
              "topic": { "type": "string", "minLength": 1 },
              "partition": { "type": "integer", "minimum": 0 },
              "offset": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,18})$" }
            }
          },
          {
            "type": "object",
            "required": ["after", "kind", "topic", "partition", "offset", "valueBase64", "redelivered"],
            "additionalProperties": false,
            "properties": {
              "after": { "$ref": "#/$defs/trigger" },
              "kind": { "const": "record" },
              "topic": { "type": "string", "minLength": 1 },
              "partition": { "type": "integer", "minimum": 0 },
              "offset": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,18})$" },
              "valueBase64": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              },
              "keyBase64": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "valueBase64"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "valueBase64": {
                      "type": "string",
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    }
                  }
                }
              },
              "redelivered": { "type": "boolean" }
            }
          },
          {
            "type": "object",
            "required": ["after", "kind"],
            "additionalProperties": false,
            "properties": {
              "after": { "$ref": "#/$defs/trigger" },
              "kind": { "enum": ["disconnect", "reconnect"] },
              "attempt": { "type": "integer", "minimum": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "reconnect" } }, "required": ["kind"] },
                "then": { "required": ["attempt"] },
                "else": { "not": { "required": ["attempt"] } }
              }
            ]
          },
          {
            "type": "object",
            "required": ["after", "kind", "topic", "partitions"],
            "additionalProperties": false,
            "properties": {
              "after": { "$ref": "#/$defs/trigger" },
              "kind": { "const": "rebalance" },
              "topic": { "type": "string", "minLength": 1 },
              "partitions": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 0 }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "start" } }
        },
        {
          "type": "object",
          "required": ["kind", "index"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "action" },
            "index": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "count"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "native" },
            "name": {
              "enum": [
                "dispatch",
                "acknowledgement",
                "subscription-opened",
                "subscription-closed",
                "input-half-closed",
                "cancellation-propagated",
                "connection-opened",
                "connection-closed",
                "reconnected",
                "delivery"
              ]
            },
            "count": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
