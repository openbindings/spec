{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/binding-specs/peer-dialects/asyncapi-mqtt311-native-1.schema.json",
  "title": "AsyncAPI MQTT 3.1.1 normalized native observation revision 1",
  "oneOf": [
    { "$ref": "#/$defs/connect" }, { "$ref": "#/$defs/disconnectDispatch" },
    { "$ref": "#/$defs/publish" }, { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/subscriptionPacket" }, { "$ref": "#/$defs/subscriptionBoundary" },
    { "$ref": "#/$defs/connection" }, { "$ref": "#/$defs/reconnected" }, { "$ref": "#/$defs/empty" }
  ],
  "$defs": {
    "base64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "connect": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "const": "dispatch" },
        "facts": {
          "type": "object",
          "required": ["packetType", "clientId", "cleanSession", "keepAlive", "usernamePresent", "passwordPresent"],
          "additionalProperties": false,
          "properties": {
            "packetType": { "const": "CONNECT" },
            "clientId": { "type": "string", "maxLength": 23, "pattern": "^[A-Za-z0-9]*$" },
            "cleanSession": { "type": "boolean" },
            "keepAlive": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "usernamePresent": { "type": "boolean" },
            "passwordPresent": { "type": "boolean" },
            "usernameSha256": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
            "passwordSha256": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] }
          },
          "allOf": [
            { "if": { "properties": { "clientId": { "const": "" } }, "required": ["clientId"] }, "then": { "properties": { "cleanSession": { "const": true } } } },
            { "if": { "properties": { "usernamePresent": { "const": true } }, "required": ["usernamePresent"] }, "then": { "required": ["usernameSha256"], "properties": { "usernameSha256": { "type": "string" } } }, "else": { "properties": { "usernameSha256": { "type": "null" } } } },
            { "if": { "properties": { "passwordPresent": { "const": true } }, "required": ["passwordPresent"] }, "then": { "required": ["passwordSha256"], "properties": { "usernamePresent": { "const": true }, "passwordSha256": { "type": "string" } } }, "else": { "properties": { "passwordSha256": { "type": "null" } } } }
          ]
        }
      }
    },
    "disconnectDispatch": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "const": "dispatch" },
        "facts": { "type": "object", "required": ["packetType"], "additionalProperties": false, "properties": { "packetType": { "const": "DISCONNECT" } } }
      }
    },
    "publish": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "enum": ["dispatch", "delivery"] },
        "facts": {
          "type": "object", "required": ["packetType", "packetId", "topic", "qos", "duplicate", "retain", "payloadBase64"], "additionalProperties": false,
          "properties": {
            "packetType": { "const": "PUBLISH" }, "packetId": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "topic": { "type": "string", "minLength": 1 }, "qos": { "type": "integer", "minimum": 0, "maximum": 2 },
            "duplicate": { "type": "boolean" }, "retain": { "type": "boolean" }, "payloadBase64": { "$ref": "#/$defs/base64" }
          },
          "allOf": [{ "if": { "properties": { "qos": { "const": 0 } }, "required": ["qos"] }, "then": { "properties": { "packetId": { "type": "null" }, "duplicate": { "const": false } } }, "else": { "properties": { "packetId": { "type": "integer" } } } }]
        }
      }
    },
    "ack": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "enum": ["dispatch", "acknowledgement"] },
        "facts": {
          "type": "object", "required": ["packetType", "packetId", "grantedQos"], "additionalProperties": false,
          "properties": {
            "packetType": { "enum": ["PUBACK", "PUBREC", "PUBREL", "PUBCOMP", "SUBACK", "UNSUBACK"] },
            "packetId": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "grantedQos": { "anyOf": [{ "enum": [0, 1, 2, 128] }, { "type": "null" }] }
          },
          "allOf": [{ "if": { "properties": { "packetType": { "const": "SUBACK" } }, "required": ["packetType"] }, "then": { "properties": { "grantedQos": { "type": "integer" } } }, "else": { "properties": { "grantedQos": { "type": "null" } } } }]
        }
      },
      "allOf": [{
        "if": { "properties": { "name": { "const": "dispatch" } }, "required": ["name"] },
        "then": { "properties": { "facts": { "properties": { "packetType": { "enum": ["PUBACK", "PUBREC", "PUBREL", "PUBCOMP"] } } } } }
      }]
    },
    "subscriptionPacket": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "const": "dispatch" },
        "facts": {
          "oneOf": [
            { "type": "object", "required": ["packetType", "packetId", "topic", "qos"], "additionalProperties": false, "properties": { "packetType": { "const": "SUBSCRIBE" }, "packetId": { "type": "integer", "minimum": 1, "maximum": 65535 }, "topic": { "type": "string", "minLength": 1 }, "qos": { "type": "integer", "minimum": 0, "maximum": 2 } } },
            { "type": "object", "required": ["packetType", "packetId", "topic"], "additionalProperties": false, "properties": { "packetType": { "const": "UNSUBSCRIBE" }, "packetId": { "type": "integer", "minimum": 1, "maximum": 65535 }, "topic": { "type": "string", "minLength": 1 } } }
          ]
        }
      }
    },
    "subscriptionBoundary": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": { "kind": { "const": "native" }, "name": { "enum": ["subscription-opened", "subscription-closed"] }, "facts": { "type": "object", "required": ["topic", "qos"], "additionalProperties": false, "properties": { "topic": { "type": "string", "minLength": 1 }, "qos": { "type": "integer", "minimum": 0, "maximum": 2 } } } }
    },
    "connection": {
      "oneOf": [
        { "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false, "properties": { "kind": { "const": "native" }, "name": { "const": "connection-opened" }, "facts": { "type": "object", "required": ["sessionPresent"], "additionalProperties": false, "properties": { "sessionPresent": { "type": "boolean" } } } } },
        { "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false, "properties": { "kind": { "const": "native" }, "name": { "const": "connection-closed" }, "facts": { "oneOf": [
          { "type": "object", "required": ["origin", "packetType", "returnCode", "sessionPresent"], "additionalProperties": false, "properties": { "origin": { "const": "peer" }, "packetType": { "const": "CONNACK" }, "returnCode": { "type": "integer", "minimum": 1, "maximum": 5 }, "sessionPresent": { "const": false } } },
          { "type": "object", "required": ["origin", "packetType"], "additionalProperties": false, "properties": { "origin": { "const": "peer" }, "packetType": { "const": "TRANSPORT-LOSS" } } },
          { "type": "object", "required": ["origin", "cause"], "additionalProperties": false, "properties": { "origin": { "const": "local" }, "cause": { "enum": ["client-disconnect", "cancellation", "transport-loss"] } } }
        ] } } }
      ]
    },
    "reconnected": { "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false, "properties": { "kind": { "const": "native" }, "name": { "const": "reconnected" }, "facts": { "type": "object", "required": ["attempt", "sessionPresent"], "additionalProperties": false, "properties": { "attempt": { "type": "integer", "minimum": 1 }, "sessionPresent": { "type": "boolean" } } } } },
    "empty": { "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false, "properties": { "kind": { "const": "native" }, "name": { "enum": ["input-half-closed", "cancellation-propagated"] }, "facts": { "type": "object", "maxProperties": 0 } } }
  }
}
