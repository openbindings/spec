{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/binding-specs/peer-dialects/asyncapi-mqtt5-native-1.schema.json",
  "title": "AsyncAPI MQTT 5 normalized native observation revision 1",
  "oneOf": [
    { "$ref": "#/$defs/connect" }, { "$ref": "#/$defs/disconnectDispatch" },
    { "$ref": "#/$defs/publish" }, { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/subscriptionPacket" }, { "$ref": "#/$defs/subscriptionBoundary" },
    { "$ref": "#/$defs/connection" }, { "$ref": "#/$defs/reconnected" }, { "$ref": "#/$defs/empty" }
  ],
  "$defs": {
    "base64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "userProperty": { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "user-property" }, "value": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "items": false, "minItems": 2 } } },
    "reasonString": { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "reason-string" }, "value": { "type": "string" } } },
    "publishProperties": { "type": "array", "items": { "oneOf": [
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "content-type" }, "value": { "type": "string" } } },
      { "type": "object", "required": ["name", "valueBase64"], "additionalProperties": false, "properties": { "name": { "const": "correlation-data" }, "valueBase64": { "$ref": "#/$defs/base64" } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "message-expiry-interval" }, "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "payload-format-indicator" }, "value": { "enum": [0, 1] } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "response-topic" }, "value": { "type": "string", "minLength": 1, "pattern": "^[^+#]+$" } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "subscription-identifier" }, "value": { "type": "integer", "minimum": 1, "maximum": 268435455 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "topic-alias" }, "value": { "type": "integer", "minimum": 1, "maximum": 65535 } } },
      { "$ref": "#/$defs/userProperty" }
    ] } },
    "ackProperties": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/reasonString" }, { "$ref": "#/$defs/userProperty" }] } },
    "subscribeProperties": { "type": "array", "items": { "oneOf": [
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "subscription-identifier" }, "value": { "type": "integer", "minimum": 1, "maximum": 268435455 } } },
      { "$ref": "#/$defs/userProperty" }
    ] }, "contains": { "type": "object", "properties": { "name": { "const": "subscription-identifier" } }, "required": ["name"] }, "minContains": 0, "maxContains": 1 },
    "connectProperties": { "type": "array", "items": { "oneOf": [
      { "$ref": "#/$defs/userProperty" },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "session-expiry-interval" }, "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "receive-maximum" }, "value": { "type": "integer", "minimum": 1, "maximum": 65535 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "topic-alias-maximum" }, "value": { "type": "integer", "minimum": 0, "maximum": 65535 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "request-response-information" }, "value": { "enum": [0, 1] } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "authentication-method" }, "value": { "type": "string", "minLength": 1 } } },
      { "type": "object", "required": ["name", "valueBase64"], "additionalProperties": false, "properties": { "name": { "const": "authentication-data" }, "valueBase64": { "$ref": "#/$defs/base64" } } }
    ] } },
    "disconnectProperties": { "type": "array", "items": { "oneOf": [
      { "$ref": "#/$defs/reasonString" }, { "$ref": "#/$defs/userProperty" },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "session-expiry-interval" }, "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "server-reference" }, "value": { "type": "string", "minLength": 1 } } }
    ] } },
    "connackProperties": { "type": "array", "items": { "oneOf": [
      { "$ref": "#/$defs/reasonString" }, { "$ref": "#/$defs/userProperty" },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "session-expiry-interval" }, "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "assigned-client-identifier" }, "value": { "type": "string", "minLength": 1 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "receive-maximum" }, "value": { "type": "integer", "minimum": 1, "maximum": 65535 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "topic-alias-maximum" }, "value": { "type": "integer", "minimum": 0, "maximum": 65535 } } },
      { "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "server-keep-alive" }, "value": { "type": "integer", "minimum": 0, "maximum": 65535 } } }
      ,{ "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "maximum-qos" }, "value": { "enum": [0, 1] } } }
      ,{ "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "retain-available" }, "value": { "enum": [0, 1] } } }
      ,{ "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "wildcard-subscription-available" }, "value": { "enum": [0, 1] } } }
      ,{ "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "subscription-identifier-available" }, "value": { "enum": [0, 1] } } }
      ,{ "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "shared-subscription-available" }, "value": { "enum": [0, 1] } } }
      ,{ "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "server-reference" }, "value": { "type": "string", "minLength": 1 } } }
      ,{ "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "response-information" }, "value": { "type": "string" } } }
      ,{ "type": "object", "required": ["name", "value"], "additionalProperties": false, "properties": { "name": { "const": "authentication-method" }, "value": { "type": "string", "minLength": 1 } } }
      ,{ "type": "object", "required": ["name", "valueBase64"], "additionalProperties": false, "properties": { "name": { "const": "authentication-data" }, "valueBase64": { "$ref": "#/$defs/base64" } } }
    ] } },
    "reconnectConnect": {
      "type": "object",
      "required": ["clientId", "cleanStart", "keepAlive", "usernamePresent", "passwordPresent", "properties"],
      "additionalProperties": false,
      "properties": {
        "clientId": { "type": "string" },
        "cleanStart": { "type": "boolean" },
        "keepAlive": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "usernamePresent": { "type": "boolean" },
        "passwordPresent": { "type": "boolean" },
        "usernameSha256": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
        "passwordSha256": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
        "properties": { "$ref": "#/$defs/connectProperties" }
      },
      "allOf": [
        { "if": { "properties": { "clientId": { "const": "" } }, "required": ["clientId"] }, "then": { "properties": { "cleanStart": { "const": true } } } },
        { "if": { "properties": { "usernamePresent": { "const": true } }, "required": ["usernamePresent"] }, "then": { "required": ["usernameSha256"], "properties": { "usernameSha256": { "type": "string" } } }, "else": { "properties": { "usernameSha256": { "type": "null" } } } },
        { "if": { "properties": { "passwordPresent": { "const": true } }, "required": ["passwordPresent"] }, "then": { "required": ["passwordSha256"], "properties": { "usernamePresent": { "const": true }, "passwordSha256": { "type": "string" } } }, "else": { "properties": { "passwordSha256": { "type": "null" } } } }
      ]
    },
    "connect": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "const": "dispatch" },
        "facts": {
          "type": "object",
          "required": ["packetType", "clientId", "cleanStart", "keepAlive", "usernamePresent", "passwordPresent", "properties"],
          "additionalProperties": false,
          "properties": {
            "packetType": { "const": "CONNECT" },
            "clientId": { "type": "string" },
            "cleanStart": { "type": "boolean" },
            "keepAlive": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "usernamePresent": { "type": "boolean" },
            "passwordPresent": { "type": "boolean" },
            "usernameSha256": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
            "passwordSha256": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
            "properties": { "$ref": "#/$defs/connectProperties" }
          },
          "allOf": [
            { "if": { "properties": { "clientId": { "const": "" } }, "required": ["clientId"] }, "then": { "properties": { "cleanStart": { "const": true } } } },
            { "if": { "properties": { "usernamePresent": { "const": true } }, "required": ["usernamePresent"] }, "then": { "required": ["usernameSha256"], "properties": { "usernameSha256": { "type": "string" } } }, "else": { "properties": { "usernameSha256": { "type": "null" } } } },
            { "if": { "properties": { "passwordPresent": { "const": true } }, "required": ["passwordPresent"] }, "then": { "required": ["passwordSha256"], "properties": { "usernamePresent": { "const": true }, "passwordSha256": { "type": "string" } } }, "else": { "properties": { "passwordSha256": { "type": "null" } } } }
          ]
        }
      }
    },
    "disconnectDispatch": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "const": "dispatch" },
        "facts": {
          "type": "object", "required": ["packetType", "reasonCode", "properties"], "additionalProperties": false,
          "properties": { "packetType": { "const": "DISCONNECT" }, "reasonCode": { "enum": [0, 4] }, "properties": { "$ref": "#/$defs/disconnectProperties" } }
        }
      }
    },
    "publish": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "enum": ["dispatch", "delivery"] },
        "facts": {
          "type": "object", "required": ["packetType", "packetId", "topic", "qos", "duplicate", "retain", "payloadBase64", "properties"], "additionalProperties": false,
          "properties": {
            "packetType": { "const": "PUBLISH" }, "packetId": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "topic": { "type": "string", "minLength": 1 }, "qos": { "type": "integer", "minimum": 0, "maximum": 2 },
            "duplicate": { "type": "boolean" }, "retain": { "type": "boolean" }, "payloadBase64": { "$ref": "#/$defs/base64" }, "properties": { "$ref": "#/$defs/publishProperties" }
          },
          "allOf": [{ "if": { "properties": { "qos": { "const": 0 } }, "required": ["qos"] }, "then": { "properties": { "packetId": { "type": "null" }, "duplicate": { "const": false } } }, "else": { "properties": { "packetId": { "type": "integer" } } } }]
        }
      },
      "allOf": [{
        "if": { "properties": { "name": { "const": "dispatch" } }, "required": ["name"] },
        "then": { "properties": { "facts": { "properties": { "properties": { "not": { "contains": { "type": "object", "properties": { "name": { "const": "subscription-identifier" } }, "required": ["name"] } } } } } } }
      }]
    },
    "ack": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "enum": ["dispatch", "acknowledgement"] },
        "facts": {
          "type": "object", "required": ["packetType", "packetId", "reasonCode", "properties"], "additionalProperties": false,
          "properties": {
            "packetType": { "enum": ["PUBACK", "PUBREC", "PUBREL", "PUBCOMP", "SUBACK", "UNSUBACK"] },
            "packetId": { "type": "integer", "minimum": 1, "maximum": 65535 }, "reasonCode": { "type": "integer", "minimum": 0, "maximum": 255 }, "properties": { "$ref": "#/$defs/ackProperties" }
          }
        }
      },
      "allOf": [{
        "if": { "properties": { "name": { "const": "dispatch" } }, "required": ["name"] },
        "then": { "properties": { "facts": { "properties": { "packetType": { "enum": ["PUBACK", "PUBREC", "PUBREL", "PUBCOMP"] } } } } }
      }]
    },
    "subscriptionPacket": {
      "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false,
      "properties": {
        "kind": { "const": "native" }, "name": { "const": "dispatch" },
        "facts": { "oneOf": [
          { "type": "object", "required": ["packetType", "packetId", "topic", "qos", "properties"], "additionalProperties": false, "properties": { "packetType": { "const": "SUBSCRIBE" }, "packetId": { "type": "integer", "minimum": 1, "maximum": 65535 }, "topic": { "type": "string", "minLength": 1 }, "qos": { "type": "integer", "minimum": 0, "maximum": 2 }, "properties": { "$ref": "#/$defs/subscribeProperties" } } },
          { "type": "object", "required": ["packetType", "packetId", "topic"], "additionalProperties": false, "properties": { "packetType": { "const": "UNSUBSCRIBE" }, "packetId": { "type": "integer", "minimum": 1, "maximum": 65535 }, "topic": { "type": "string", "minLength": 1 } } }
        ] }
      }
    },
    "subscriptionBoundary": { "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false, "properties": { "kind": { "const": "native" }, "name": { "enum": ["subscription-opened", "subscription-closed"] }, "facts": { "type": "object", "required": ["topic", "qos"], "additionalProperties": false, "properties": { "topic": { "type": "string", "minLength": 1 }, "qos": { "type": "integer", "minimum": 0, "maximum": 2 } } } } },
    "connection": {
      "oneOf": [
        { "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false, "properties": { "kind": { "const": "native" }, "name": { "const": "connection-opened" }, "facts": { "type": "object", "required": ["reasonCode", "sessionPresent", "properties"], "additionalProperties": false, "properties": { "reasonCode": { "const": 0 }, "sessionPresent": { "type": "boolean" }, "properties": { "$ref": "#/$defs/connackProperties" } } } } },
        { "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false, "properties": { "kind": { "const": "native" }, "name": { "const": "connection-closed" }, "facts": { "oneOf": [
          { "type": "object", "required": ["origin", "packetType", "reasonCode", "sessionPresent", "properties"], "additionalProperties": false, "properties": { "origin": { "const": "peer" }, "packetType": { "const": "CONNACK" }, "reasonCode": { "enum": [128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 140, 144, 149, 151, 153, 154, 155, 156, 157, 159] }, "sessionPresent": { "const": false }, "properties": { "$ref": "#/$defs/connackProperties" } } },
          { "type": "object", "required": ["origin", "packetType", "reasonCode", "properties"], "additionalProperties": false, "properties": { "origin": { "const": "peer" }, "packetType": { "const": "DISCONNECT" }, "reasonCode": { "enum": [0, 128, 129, 130, 131, 135, 137, 139, 141, 142, 143, 144, 147, 148, 149, 150, 151, 152, 153, 154, 155, 156, 157, 158, 159, 160, 161, 162] }, "properties": { "$ref": "#/$defs/disconnectProperties", "not": { "contains": { "type": "object", "properties": { "name": { "const": "session-expiry-interval" } }, "required": ["name"] } } } } },
          { "type": "object", "required": ["origin", "packetType"], "additionalProperties": false, "properties": { "origin": { "const": "peer" }, "packetType": { "const": "TRANSPORT-LOSS" } } },
          { "type": "object", "required": ["origin", "cause"], "additionalProperties": false, "properties": { "origin": { "const": "local" }, "cause": { "enum": ["client-disconnect", "cancellation", "transport-loss"] } } }
        ] } } }
      ]
    },
    "reconnected": { "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false, "properties": { "kind": { "const": "native" }, "name": { "const": "reconnected" }, "facts": { "type": "object", "required": ["attempt", "sessionPresent", "connect", "properties"], "additionalProperties": false, "properties": { "attempt": { "type": "integer", "minimum": 1 }, "sessionPresent": { "type": "boolean" }, "connect": { "$ref": "#/$defs/reconnectConnect" }, "properties": { "$ref": "#/$defs/connackProperties" } } } } },
    "empty": { "type": "object", "required": ["kind", "name", "facts"], "additionalProperties": false, "properties": { "kind": { "const": "native" }, "name": { "enum": ["input-half-closed", "cancellation-propagated"] }, "facts": { "type": "object", "maxProperties": 0 } } }
  }
}
