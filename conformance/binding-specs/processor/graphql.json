              }
            },
            {
              "type": "error",
              "id": "1",
              "payload": [
                {
                  "message": "stopped"
                }
              ]
            }
          ]
        }
      },
      "expected": [
        {
          "disposition": "refusal",
          "phase": "pre-dispatch",
          "assertions": [
