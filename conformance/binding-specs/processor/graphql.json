    {
      "id": "GQL-PS-08",
      "rules": [
        "GQL-P-04"
      ],
      "section": "9",
      "description": "A subscription binding is refused before WebSocket dispatch rather than approximating its continuing per-event error lifecycle.",
      "given": {
        "source": {
          "location": "https://api.example.test/graphql",
          "content": {
            "data": {
              "__schema": {
                "queryType": {
                  "name": "RootQuery"
                },
                "mutationType": null,
                "subscriptionType": {
                  "name": "RootSubscription"
                },
                "types": [
                  {
                    "kind": "OBJECT",
                    "name": "RootQuery",
                    "fields": []
                  },
                  {
                    "kind": "OBJECT",
                    "name": "RootSubscription",
                    "fields": [
                      {
                        "name": "updates",
                        "args": [],
                        "type": {
                          "kind": "SCALAR",
                          "name": "String",
                          "ofType": null
                        },
                        "isDeprecated": false
                      }
                    ]
                  },
                  {
                    "kind": "SCALAR",
                    "name": "String"
                  }
                ]
              }
            }
          }
        },
        "binding": {
          "ref": "subscription/updates"
        },
        "configuration": {
          "document": {
            "source": "subscription Watch { updates }",
            "operationName": "Watch"
          },
          "subscriptionTarget": "wss://stream.example.test/graphql",
          "protocolFields": {
            "connectionInitPayload": {
              "tenant": "demo"
            }
          }
        },
        "invocation": {
          "inputPresent": false
        },
        "peer": {
          "messages": [
            {
              "type": "connection_ack"
            },
            {
              "type": "next",
              "id": "1",
              "payload": {
                "data": {
                  "updates": null
                },
                "errors": [
                  {
                    "message": "resolver warning"
                  }
                ]
              }
            },
            {
              "type": "complete",
              "id": "1"
            }
          ]
        }
      },
      "expected": [
        {
          "disposition": "refusal",
          "phase": "pre-dispatch",
          "assertions": [
            {
              "path": "/outputs",
              "equals": []
            },
            {
              "path": "/dispatch",
              "absent": true
            }
          ]
        }
      ]
    },
    {
      "id": "GQL-PS-09",
      "rules": [
        "GQL-P-04"
      ],
      "section": "9",
      "description": "Subscription exclusion is independent of the peer behavior a native client could have observed.",
      "given": {
        "source": {
          "location": "https://api.example.test/graphql",
          "content": {
            "data": {
              "__schema": {
                "queryType": {
                  "name": "RootQuery"
