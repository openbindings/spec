        "configuration": {
          "document": {
            "source": "subscription { updates }"
          },
          "subscriptionTarget": "wss://stream.example.test/graphql"
        },
        "invocation": {
          "inputPresent": false
        },
        "peer": {
          "messages": [
            {
              "type": "connection_ack"
