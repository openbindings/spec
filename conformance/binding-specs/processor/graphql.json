                  "name": "RootSubscription"
                },
                "types": [
                  {
                    "kind": "OBJECT",
                    "name": "RootQuery",
                    "fields": []
                  },
                  {
                    "kind": "OBJECT",
                    "name": "RootSubscription",
                    "fields": [
                      {
                        "name": "updates",
                        "args": [],
                        "type": {
                          "kind": "SCALAR",
                          "name": "String",
                          "ofType": null
                        },
                        "isDeprecated": false
                      }
                    ]
