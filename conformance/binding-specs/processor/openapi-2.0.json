{
  "format": "openbindings.binding-spec-processor-scenarios@2",
  "bindingSpec": "openbindings.openapi-2.0@1",
  "family": "openapi-2.0",
  "description": "Portable processor scenarios for the OpenAPI 2.0 binding-specification sibling. Configuration is named semantically; adapters normalize HTTP observations.",
  "scenarios": [
    {
      "id": "OAPI20-PS-01",
      "rules": [
        "OAPI20-P-02",
        "OAPI20-P-03"
      ],
      "section": "7",
      "description": "OAS 2.0 Parameter Object text states that a body parameter's name has no effect on the parameter itself and that only one payload exists (edition analysis N2-09). The caller therefore supplies the JSON value once in body, and the declared name payload never appears on the wire [CO20-03].",
      "given": {
        "source": {
          "content": {
            "swagger": "2.0",
            "info": {
              "title": "Nameless body",
              "version": "1"
            },
            "schemes": [
              "https"
            ],
            "host": "api.example",
            "basePath": "/v1",
            "consumes": [
              "application/json"
            ],
            "paths": {
              "/pets": {
                "post": {
                  "parameters": [
                    {
                      "name": "payload",
                      "in": "body",
                      "required": true,
                      "schema": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  ],
                  "responses": {
                    "204": {
                      "description": "stored"
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1pets/post"
        },
        "invocation": {
          "inputPresent": true,
          "input": {
            "body": {
              "name": "Ada"
            }
          }
        },
        "peer": {
          "status": 204,
          "headers": {},
          "body": ""
        }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            {
              "path": "/dispatch/method",
              "equals": "POST"
            },
            {
              "path": "/dispatch/url",
              "equals": "https://api.example/v1/pets"
            },
            {
              "path": "/dispatch/headers/Content-Type",
              "equals": "application/json"
            },
            {
              "path": "/dispatch/body",
              "equals": {
                "name": "Ada"
              }
            },
            {
              "path": "/outputs",
              "equals": []
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI20-PS-02",
      "rules": [
        "OAPI20-P-01"
      ],
      "section": "3",
      "description": "The exact binding token owns the Swagger 2.0 gate: a compatible-looking swagger value refuses at load even when a valid-looking OpenAPI 3.x discriminator is also present, and the processor never falls through to the sibling lane.",
      "given": {
        "source": {
          "content": {
            "swagger": "2.0.1",
            "openapi": "3.0.4",
            "info": {
              "title": "No cross-lane fallback",
              "version": "1"
            },
            "paths": {
              "/pets": {
                "get": {
                  "responses": {
                    "204": {
                      "description": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1pets/get"
        },
        "invocation": {
          "inputPresent": false
        }
      },
      "expected": [
        {
          "disposition": "refusal",
          "phase": "load",
          "assertions": [
            {
              "path": "/dispatch",
              "absent": true
            },
            {
              "path": "/error/code",
              "equals": "ERR_SOURCE_LOAD_FAILED"
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI20-PS-03",
      "rules": [
        "OAPI20-P-01"
      ],
      "section": "3",
      "description": "Once swagger is exactly 2.0, a co-present OpenAPI 3.x discriminator is only an unknown Swagger field: it does not steal the source into another lane or destroy an otherwise resolvable source, so the absent selected method refuses at resolution rather than load.",
      "given": {
        "source": {
          "content": {
            "swagger": "2.0",
            "openapi": "3.0.4",
            "info": {
              "title": "Owning gate",
              "version": "1"
            },
            "paths": {
              "/pets": {
                "post": {
                  "responses": {
                    "204": {
                      "description": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1pets/get"
        },
        "invocation": {
          "inputPresent": false
        }
      },
      "expected": [
        {
          "disposition": "refusal",
          "phase": "resolution",
          "assertions": [
            {
              "path": "/dispatch",
              "absent": true
            },
            {
              "path": "/error/code",
              "equals": "ERR_SELECTOR_NOT_FOUND"
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI20-PS-04",
      "rules": [
        "OAPI20-P-01"
      ],
      "section": "3",
      "description": "A YAML stream containing a second document refuses at the closed accepted-representation grammar gate; the first document is never silently selected.",
      "given": {
        "source": {
          "content": "swagger: \"2.0\"\ninfo: {title: Multiple documents, version: \"1\"}\npaths: {}\n---\n{}\n"
        },
        "binding": {
          "selector": "#/paths/~1pets/get"
        },
        "invocation": {
          "inputPresent": false
        }
      },
      "expected": [
        {
          "disposition": "refusal",
          "phase": "load",
          "assertions": [
            {
              "path": "/dispatch",
              "absent": true
            },
            {
              "path": "/error/code",
              "equals": "ERR_SOURCE_LOAD_FAILED"
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI20-PS-05",
      "rules": [
        "OAPI20-P-01"
      ],
      "section": "6",
      "description": "Selector evaluation never percent-decodes its RFC 6901 path token: a percent-encoded rendering remains a distinct, unresolvable target.",
      "given": {
        "source": {
          "content": {
            "swagger": "2.0",
            "info": {
              "title": "Verbatim selector",
              "version": "1"
            },
            "paths": {
              "/pets/{petId}": {
                "get": {
                  "responses": {
                    "204": {
                      "description": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1pets~1%7BpetId%7D/get"
        },
        "invocation": {
          "inputPresent": false
        }
      },
      "expected": [
        {
          "disposition": "refusal",
          "phase": "resolution",
          "assertions": [
            {
              "path": "/dispatch",
              "absent": true
            },
            {
              "path": "/error/code",
              "equals": "ERR_SELECTOR_NOT_FOUND"
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI20-PS-06",
      "rules": [
        "OAPI20-P-01"
      ],
      "section": "5",
      "description": "A selected external Path Item reference resolves relative to the co-present source location, follows the target resource's fragment graph, detects its alternating cycle without resource exhaustion, and refuses before dispatch.",
      "given": {
        "source": {
          "location": "https://description.example/root/swagger.yaml",
          "content": {
            "swagger": "2.0",
            "info": {
              "title": "External cycle",
              "version": "1"
            },
            "paths": {
              "/pets": {
                "$ref": "parts/path.yaml#/a"
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1pets/get"
        },
        "invocation": {
          "inputPresent": false
        },
        "resources": {
          "https://description.example/root/parts/path.yaml": {
            "a": {
              "$ref": "#/b"
            },
            "b": {
              "$ref": "#/a"
            }
          }
        }
      },
      "expected": [
        {
          "disposition": "refusal",
          "phase": "pre-dispatch",
          "assertions": [
            {
              "path": "/dispatch",
              "absent": true
            },
            {
              "path": "/error/code",
              "equals": "ERR_REFUSED"
            }
          ]
        }
      ]
    }
  ]
}
