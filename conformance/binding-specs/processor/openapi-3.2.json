{
  "format": "openbindings.binding-spec-processor-scenarios@2",
  "bindingSpec": "openbindings.openapi-3.2@1",
  "family": "openapi-3.2",
  "description": "Portable processor scenarios for the OpenAPI 3.2 binding-specification sibling. Configuration is named semantically; adapters normalize HTTP observations.",
  "scenarios": [
    {
      "id": "OAPI32-PS-02",
      "rules": ["OAPI32-P-01"],
      "section": "3",
      "description": "The exact 3.2.0 edition is admitted, an operation with omitted responses remains addressable, and the plain empty unary response uses the explicit 3.1-equivalence bridge.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "exact edition", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/health": {"get": {}}}}},
        "binding": {"selector": "#/paths/~1health/get"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/method", "equals": "GET"},
        {"path": "/dispatch/url", "equals": "https://api.example/health"},
        {"path": "/outputs", "equals": []}
      ]}]
    },
    {
      "id": "OAPI32-PS-03",
      "rules": ["OAPI32-P-01"],
      "section": "3",
      "description": "A later patch-looking 3.2 edition is refused at the exact pre-resolution edition gate.",
      "given": {
        "source": {"content": {"openapi": "3.2.1", "info": {"title": "future", "version": "1"}, "paths": {"/x": {"$ref": "https://resources.example/path-item.yaml"}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false},
        "resources": {"https://resources.example/path-item.yaml": "get: {}"}
      },
      "expected": [{"disposition": "refusal", "phase": "load", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-04",
      "rules": ["OAPI32-P-01"],
      "section": "3",
      "description": "The 3.2 family token does not infer acceptance of a 3.1 artifact.",
      "given": {
        "source": {"content": {"openapi": "3.1.2", "info": {"title": "sibling", "version": "1"}, "paths": {"/x": {"get": {"responses": {"204": {"description": "ok"}}}}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "load", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-05",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "Selector evaluation never percent-decodes an RFC 6901 path segment.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "pointer", "version": "1"}, "paths": {"/pets/{petId}": {"get": {}}}}},
        "binding": {"selector": "#/paths/~1pets~1%7BpetId%7D/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "resolution", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-06",
      "rules": ["OAPI32-P-01"],
      "section": "4",
      "description": "Root $self establishes the OpenAPI-description base used by a relative selected Path Item reference.",
      "given": {
        "source": {"location": "https://retrieval.example/root.yaml", "content": {"openapi": "3.2.0", "$self": "https://identity.example/descriptions/root.yaml", "info": {"title": "self base", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/x": {"$ref": "library.yaml#/paths/~1target"}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false},
        "resources": {"https://identity.example/descriptions/library.yaml": {"openapi": "3.2.0", "$self": "https://identity.example/descriptions/library.yaml", "info": {"title": "library", "version": "1"}, "paths": {"/target": {"get": {}}}}},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/url", "equals": "https://api.example/x"},
        {"path": "/outputs", "equals": []}
      ]}]
    },
    {
      "id": "OAPI32-PS-07",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "A selected reference that uses a retrieval alias despite the target document's declared $self identity is excluded before dispatch.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "alias", "version": "1"}, "paths": {"/x": {"$ref": "https://retrieval.example/library.yaml#/paths/~1target"}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false},
        "resources": {"https://retrieval.example/library.yaml": {"openapi": "3.2.0", "$self": "https://identity.example/library.yaml", "info": {"title": "library", "version": "1"}, "paths": {"/target": {"get": {}}}}}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-08",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "A Path Item $ref collision on the selected method excludes that target.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "selected collision", "version": "1"}, "components": {"pathItems": {"Shared": {"get": {}}}}, "paths": {"/x": {"$ref": "#/components/pathItems/Shared", "get": {}}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-09",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "A collision confined to an unused Path Item method does not exclude the selected operation.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "unused collision", "version": "1"}, "servers": [{"url": "https://api.example"}], "components": {"pathItems": {"Shared": {"get": {}, "post": {}}}}, "paths": {"/x": {"$ref": "#/components/pathItems/Shared", "post": {}}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/method", "equals": "GET"},
        {"path": "/dispatch/url", "equals": "https://api.example/x"}
      ]}]
    },
    {
      "id": "OAPI32-PS-10",
      "rules": ["OAPI32-P-01"],
      "section": "3",
      "description": "Omitting components, paths, and webhooks leaves no possible target position and refuses the whole source after the closed load gates without becoming a fifth load gate.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "no surfaces", "version": "1"}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-11",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "A root jsonSchemaDialect outside the incorporated base dialect excludes the whole source, including a schema-free target.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema", "info": {"title": "dialect", "version": "1"}, "paths": {"/x": {"get": {}}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-12",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "A present empty Responses Object excludes the selected target while omission remains addressable.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "empty responses", "version": "1"}, "paths": {"/x": {"get": {"responses": {}}}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-13",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "Reference identity applies through the selected request closure: a Request Body reference using a retrieval alias instead of the target document's $self identity is excluded.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "request alias", "version": "1"}, "paths": {"/x": {"post": {"requestBody": {"$ref": "https://retrieval.example/library.yaml#/components/requestBodies/Payload"}}}}}},
        "binding": {"selector": "#/paths/~1x/post"},
        "invocation": {"inputPresent": false},
        "resources": {"https://retrieval.example/library.yaml": {"openapi": "3.2.0", "$self": "https://identity.example/library.yaml", "info": {"title": "library", "version": "1"}, "components": {"requestBodies": {"Payload": {"content": {"application/json": {"schema": {"type": "object"}}}}}}}}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-14",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "A selected Schema Object reference cannot cross a nearer $id resource boundary using the containing OpenAPI document plus a deep pointer.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "schema identity", "version": "1"}, "components": {"schemas": {"Resource": {"$id": "https://schemas.example/resource", "type": "object", "properties": {"name": {"type": "string"}}}}}, "paths": {"/x": {"post": {"requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Resource/properties/name"}}}}}}}}},
        "binding": {"selector": "#/paths/~1x/post"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-15",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "A response-only reference-identity divergence does not leak into M5's request gate; the empty unary response remains on the explicit equivalence bridge and the divergent response cell is deferred to M6.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "response seam", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/x": {"get": {"responses": {"204": {"$ref": "https://retrieval.example/responses.yaml#/components/responses/Empty"}}}}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false},
        "resources": {"https://retrieval.example/responses.yaml": {"openapi": "3.2.0", "$self": "https://identity.example/responses.yaml", "info": {"title": "responses", "version": "1"}, "components": {"responses": {"Empty": {"description": "ok"}}}}},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/url", "equals": "https://api.example/x"},
        {"path": "/outputs", "equals": []}
      ]}]
    },
    {
      "id": "OAPI32-PS-16",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "An unsupported $schema at a selected schema-resource root excludes the selected operation while the source itself remains admitted.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "schema dialect", "version": "1"}, "paths": {"/x": {"post": {"requestBody": {"content": {"application/json": {"schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object"}}}}}}}}},
        "binding": {"selector": "#/paths/~1x/post"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-17",
      "rules": ["OAPI32-P-01"],
      "section": "3",
      "description": "A duplicate YAML mapping key refuses at the accepted-representation grammar gate.",
      "given": {
        "source": {"content": "openapi: 3.2.0\nopenapi: 3.2.0\npaths: {}\n"},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "load", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-18",
      "rules": ["OAPI32-P-01"],
      "section": "3",
      "description": "A multi-document YAML stream refuses because exactly one document is admitted.",
      "given": {
        "source": {"content": "openapi: 3.2.0\npaths: {}\n---\nopenapi: 3.2.0\npaths: {}\n"},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "load", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-19",
      "rules": ["OAPI32-P-01"],
      "section": "3",
      "description": "A YAML value with no JSON data-model image refuses at the compatibility gate.",
      "given": {
        "source": {"content": "openapi: 3.2.0\npaths: {}\nx-bad:\n  ? [a, b]\n  : value\n"},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "load", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-20",
      "rules": ["OAPI32-P-01"],
      "section": "3",
      "description": "A non-object root refuses at the closed root-shape load gate.",
      "given": {
        "source": {"content": ["openapi", "3.2.0"]},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "load", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-21",
      "rules": ["OAPI32-P-01"],
      "section": "3",
      "description": "An object root without the required string openapi field refuses at edition discrimination.",
      "given": {
        "source": {"content": {"paths": {}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "load", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-22",
      "rules": ["OAPI32-P-01"],
      "section": "4",
      "description": "An unusable root $self does not fall back semantically to the retrieval URI for a selected relative reference.",
      "given": {
        "source": {"location": "https://retrieval.example/openapi.yaml", "content": {"openapi": "3.2.0", "$self": 42, "info": {"title": "invalid self", "version": "1"}, "paths": {"/x": {"$ref": "path-item.yaml"}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": false},
        "resources": {"https://retrieval.example/path-item.yaml": {"get": {}}}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-23",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "An unresolvable reference confined to an unused sibling operation does not destroy the selected target.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "reference confinement", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/good": {"get": {}}, "/broken": {"post": {"requestBody": {"$ref": "#/components/requestBodies/Missing"}}}}}},
        "binding": {"selector": "#/paths/~1good/get"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/url", "equals": "https://api.example/good"},
        {"path": "/outputs", "equals": []}
      ]}]
    },
    {
      "id": "OAPI32-PS-24",
      "rules": ["OAPI32-P-01"],
      "section": "5",
      "description": "A resolvable cyclic Schema Object graph terminates reference traversal and remains usable.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "reference cycle", "version": "1"}, "servers": [{"url": "https://api.example"}], "components": {"schemas": {"Node": {"type": "object", "properties": {"next": {"$ref": "#/components/schemas/Node"}}}}}, "paths": {"/nodes": {"post": {"requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Node"}}}}}}}}},
        "binding": {"selector": "#/paths/~1nodes/post"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/url", "equals": "https://api.example/nodes"},
        {"path": "/outputs", "equals": []}
      ]}]
    },
    {
      "id": "OAPI32-PS-25",
      "rules": ["OAPI32-P-01", "OAPI32-P-02"],
      "section": "6",
      "description": "The fixed query field dispatches the uppercase QUERY method, and QUERY carries its declared request content as the query operation rather than deleting it as GET-like content.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "QUERY", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/search": {"query": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"204": {"description": "ok"}}}}}}},
        "binding": {"selector": "#/paths/~1search/query"},
        "invocation": {"inputPresent": true, "input": {"body": {"term": "fox"}}},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/method", "equals": "QUERY"},
        {"path": "/dispatch/url", "equals": "https://api.example/search"},
        {"path": "/dispatch/body", "equals": {"term": "fox"}},
        {"path": "/dispatch/headers/content-type", "equals": "application/json"}
      ]}]
    },
    {
      "id": "OAPI32-PS-26",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "An additionalOperations key retains its exact authored capitalization in both selector identity and the HTTP method sent on the wire.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "custom method", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/custom": {"additionalOperations": {"MiXeD": {"responses": {"204": {"description": "ok"}}}}}}}},
        "binding": {"selector": "#/paths/~1custom/additionalOperations/MiXeD"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/method", "equals": "MiXeD"},
        {"path": "/dispatch/url", "equals": "https://api.example/custom"}
      ]}]
    },
    {
      "id": "OAPI32-PS-27",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "Additional-operation lookup is byte-exact, so a case-changed selector names no operation and never dispatches.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "exact custom method", "version": "1"}, "paths": {"/custom": {"additionalOperations": {"MiXeD": {}}}}}},
        "binding": {"selector": "#/paths/~1custom/additionalOperations/MIXED"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "resolution", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-28",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "An additionalOperations map key containing a slash is not an HTTP token even when the selector escapes that map-key segment exactly.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "invalid custom method", "version": "1"}, "paths": {"/custom": {"additionalOperations": {"BAD/METHOD": {}}}, "/good": {"get": {}}}}},
        "binding": {"selector": "#/paths/~1custom/additionalOperations/BAD~1METHOD"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "resolution", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-29",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "An additionalOperations key comparing ASCII-case-insensitively equal to the fixed query field is excluded as its own entry.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "fixed collision", "version": "1"}, "paths": {"/custom": {"query": {}, "additionalOperations": {"QuErY": {}}}}}},
        "binding": {"selector": "#/paths/~1custom/additionalOperations/QuErY"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-30",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "A colliding additional-operation entry does not exclude the distinct fixed QUERY operation on the same Path Item.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "fixed survives", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/custom": {"query": {}, "additionalOperations": {"QuErY": {}}}}}},
        "binding": {"selector": "#/paths/~1custom/query"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/method", "equals": "QUERY"},
        {"path": "/dispatch/url", "equals": "https://api.example/custom"}
      ]}]
    },
    {
      "id": "OAPI32-PS-31",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "RFC 6901 escaping applies once to an additional method key, so F~0O selects and dispatches the exact F~O HTTP token.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "escaped custom method", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/custom": {"additionalOperations": {"F~O": {}}}}}},
        "binding": {"selector": "#/paths/~1custom/additionalOperations/F~0O"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [{"path": "/dispatch/method", "equals": "F~O"}]}]
    },
    {
      "id": "OAPI32-PS-32",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "Selector evaluation resolves a referenced Path Item before reading an additionalOperations entry and composes a non-colliding adjacent entry.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "referenced additional", "version": "1"}, "servers": [{"url": "https://api.example"}], "components": {"pathItems": {"Shared": {"additionalOperations": {"MiXeD": {}}}}}, "paths": {"/custom": {"$ref": "#/components/pathItems/Shared", "additionalOperations": {"OTHER": {}}}}}},
        "binding": {"selector": "#/paths/~1custom/additionalOperations/MiXeD"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/method", "equals": "MiXeD"},
        {"path": "/dispatch/url", "equals": "https://api.example/custom"}
      ]}]
    },
    {
      "id": "OAPI32-PS-33",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "The same additional-operation key in a referenced and adjacent Path Item is an undefined selected-field collision and excludes that target.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "selected custom collision", "version": "1"}, "components": {"pathItems": {"Shared": {"additionalOperations": {"MiXeD": {}}}}}, "paths": {"/custom": {"$ref": "#/components/pathItems/Shared", "additionalOperations": {"MiXeD": {}}}}}},
        "binding": {"selector": "#/paths/~1custom/additionalOperations/MiXeD"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-34",
      "rules": ["OAPI32-P-01"],
      "section": "6",
      "description": "A Path Item $ref collision confined to an unused additional-operation key does not exclude a different selected additional operation.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "unused custom collision", "version": "1"}, "servers": [{"url": "https://api.example"}], "components": {"pathItems": {"Shared": {"additionalOperations": {"MiXeD": {}, "OTHER": {}}}}}, "paths": {"/custom": {"$ref": "#/components/pathItems/Shared", "additionalOperations": {"MiXeD": {}}}}}},
        "binding": {"selector": "#/paths/~1custom/additionalOperations/OTHER"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [{"path": "/dispatch/method", "equals": "OTHER"}]}]
    },
    {
      "id": "OAPI32-PS-35",
      "rules": ["OAPI32-P-02"],
      "section": "7",
      "description": "A TRACE requestBody declaration creates no required caller body and a body-free invocation dispatches TRACE without content.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "TRACE body omission", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/trace": {"trace": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"204": {"description": "ok"}}}}}}},
        "binding": {"selector": "#/paths/~1trace/trace"},
        "invocation": {"inputPresent": false},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/method", "equals": "TRACE"},
        {"path": "/dispatch/body", "absent": true}
      ]}]
    },
    {
      "id": "OAPI32-PS-36",
      "rules": ["OAPI32-P-02"],
      "section": "7",
      "description": "A supplied caller body on TRACE is unroutable and refuses before dispatch even when the artifact declares requestBody.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "TRACE body refusal", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/trace": {"trace": {"requestBody": {"content": {"application/json": {"schema": {"type": "object"}}}}}}}}},
        "binding": {"selector": "#/paths/~1trace/trace"},
        "invocation": {"inputPresent": true, "input": {"body": {"forbidden": true}}}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-37",
      "rules": ["OAPI32-P-02"],
      "section": "7",
      "description": "The caller correspondence is closed to parameters and body, so an unknown top-level key refuses before dispatch.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "closed envelope", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/x": {"post": {}}}}},
        "binding": {"selector": "#/paths/~1x/post"},
        "invocation": {"inputPresent": true, "input": {"headers": {"X-Test": "value"}}}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-38",
      "rules": ["OAPI32-P-02"],
      "section": "7",
      "description": "A present caller-envelope parameters member must be an object and refuses before dispatch otherwise.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "parameter envelope", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/x": {"get": {}}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": true, "input": {"parameters": "q=value"}}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-39",
      "rules": ["OAPI32-P-02"],
      "section": "7",
      "description": "Cross-location same-name parameters activate qualified mode for every parameter and remain independently writable through location/RFC6901-name keys.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "qualified parameters", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/items/{id}": {"get": {"parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "id", "in": "query", "schema": {"type": "string"}}]}}}}},
        "binding": {"selector": "#/paths/~1items~1{id}/get"},
        "invocation": {"inputPresent": true, "input": {"parameters": {"path/id": "path-value", "query/id": "query-value"}}},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [{"path": "/dispatch/url", "equals": "https://api.example/items/path-value?id=query-value"}]}]
    },
    {
      "id": "OAPI32-PS-40",
      "rules": ["OAPI32-P-02"],
      "section": "7",
      "description": "Once cross-location duplication activates qualified mode, the bare parameter name is unknown and refuses before dispatch.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "qualified parameter refusal", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/items/{id}": {"get": {"parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "id", "in": "query", "schema": {"type": "string"}}]}}}}},
        "binding": {"selector": "#/paths/~1items~1{id}/get"},
        "invocation": {"inputPresent": true, "input": {"parameters": {"id": "ambiguous"}}}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-41",
      "rules": ["OAPI32-P-02"],
      "section": "7",
      "description": "A present body member carrying JSON null is supplied rather than absent and crosses the correspondence boundary as the one JSON null body value.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "null body", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/null": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"type": ["object", "null"]}}}}, "responses": {"204": {"description": "ok"}}}}}}},
        "binding": {"selector": "#/paths/~1null/post"},
        "invocation": {"inputPresent": true, "input": {"body": null}},
        "peer": {"status": 204, "body": ""}
      },
      "expected": [{"disposition": "complete", "phase": "completion", "assertions": [
        {"path": "/dispatch/body", "equals": null},
        {"path": "/dispatch/byteLength", "equals": 4}
      ]}]
    },
    {
      "id": "OAPI32-PS-42",
      "rules": ["OAPI32-P-02"],
      "section": "7",
      "description": "Omission of a required request body remains distinct from supplied null and refuses before dispatch.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "missing body", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/required": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"type": ["object", "null"]}}}}}}}}},
        "binding": {"selector": "#/paths/~1required/post"},
        "invocation": {"inputPresent": false}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-43",
      "rules": ["OAPI32-P-02"],
      "section": "7",
      "description": "An unknown key inside the parameters object refuses before dispatch; no unmatched-field passthrough exists even without a body.",
      "given": {
        "source": {"content": {"openapi": "3.2.0", "info": {"title": "unknown parameter", "version": "1"}, "servers": [{"url": "https://api.example"}], "paths": {"/x": {"get": {"parameters": [{"name": "q", "in": "query", "schema": {"type": "string"}}]}}}}},
        "binding": {"selector": "#/paths/~1x/get"},
        "invocation": {"inputPresent": true, "input": {"parameters": {"other": "value"}}}
      },
      "expected": [{"disposition": "refusal", "phase": "pre-dispatch", "assertions": [{"path": "/dispatch", "absent": true}]}]
    },
    {
      "id": "OAPI32-PS-01",
      "rules": [
        "OAPI32-P-03"
      ],
      "section": "9",
      "description": "OAS 3.2.0 §§4.14.3.1, 4.14.4, and 4.14.6.3 require ordered per-item processing for sequential media and model each parsed text/event-stream item as the applicable data/event/id/retry object. This seed uses the edition's worked SSE bytes and equivalent JSON records [CO32-12, CO32-13].",
      "given": {
        "source": {
          "content": {
            "openapi": "3.2.0",
            "info": {
              "title": "SSE event objects",
              "version": "1"
            },
            "servers": [
              {
                "url": "https://api.example"
              }
            ],
            "paths": {
              "/events": {
                "get": {
                  "responses": {
                    "200": {
                      "description": "events",
                      "content": {
                        "text/event-stream": {
                          "itemSchema": {
                            "type": "object",
                            "required": [
                              "data"
                            ],
                            "properties": {
                              "data": {
                                "type": "string"
                              },
                              "event": {
                                "type": "string"
                              },
                              "id": {
                                "type": "string"
                              },
                              "retry": {
                                "type": "integer",
                                "minimum": 0
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1events/get"
        },
        "invocation": {
          "inputPresent": false
        },
        "peer": {
          "status": 200,
          "headers": {
            "Content-Type": "text/event-stream"
          },
          "body": "event: addString\ndata: This data is formatted\ndata: across two lines\nretry: 5\n\nevent: addInt64\ndata: 1234.5678\nunknownField: this is ignored\n\n: This is a comment\nevent: addJSON\ndata: {\"foo\": 42}\n\n"
        }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            {
              "path": "/outputs",
              "equals": [
                {
                  "event": "addString",
                  "data": "This data is formatted\nacross two lines",
                  "retry": 5
                },
                {
                  "event": "addInt64",
                  "data": "1234.5678"
                },
                {
                  "event": "addJSON",
                  "data": "{\"foo\": 42}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
