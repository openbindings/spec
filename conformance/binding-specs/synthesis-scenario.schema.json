{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/binding-specs/synthesis-scenario.schema.json",
  "title": "OpenBindings binding-specification synthesis scenarios",
  "description": "Portable authoring scenarios that compare synthesized target identities and exhaustive source-artifact disposition evidence, or require whole-source refusal when faithful synthesis is impossible, without prescribing an SDK API. Revision 3 adds a closed companion-document set so a multi-document artifact can be expressed at all, and an optional assertion list so a scenario can pin an emitted value its finding is about. Revision 4 renames the binding identity member bindingRef to bindingSelector, tracking the core rename of the binding member ref to selector; sourceRef names a source-local unit, not the binding member, and is unchanged. Revision 5 adds targetless dependency coverage for source interactions synthesized as Core dependencies.",
  "type": "object",
  "required": ["format", "bindingSpec", "family", "description", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "enum": [
        "openbindings.binding-spec-synthesis-scenarios@4",
        "openbindings.binding-spec-synthesis-scenarios@5"
      ]
    },
    "bindingSpec": {
      "type": "string",
      "pattern": "^openbindings\\.(usage|openapi-(2\\.0|3\\.0|3\\.1|3\\.2)|asyncapi|mcp|grpc|connect|graphql)@[1-9][0-9]*$"
    },
    "family": {
      "enum": ["usage", "openapi-2.0", "openapi-3.0", "openapi-3.1", "openapi-3.2", "asyncapi", "mcp", "grpc", "connect", "graphql"]
    },
    "description": { "type": "string", "minLength": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "source", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(USAGE|OAPI(20|30|31|32)|ASYNC|MCP|GRPC|CONN|GQL)-SS-[0-9]{2,}$"
          },
          "rules": {
            "description": "Atomic processor or synthesizer rules exercised by this scenario. Optional for legacy scenarios; the verifier requires complete S-rule coverage for the OpenAPI family.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(USAGE|OAPI(20|30|31|32)|ASYNC|MCP|GRPC|CONN|GQL)-[PS]-[0-9]+$"
            }
          },
          "description": { "type": "string", "minLength": 1 },
          "source": {
            "description": "One Core binding source. It must carry `location` or `content`, so every scenario describes a source admitted by the OpenBindings document model without depending on any project interface contract.",
            "type": "object",
            "required": ["bindingSpec"],
            "anyOf": [
              { "required": ["location"] },
              { "required": ["content"] }
            ],
            "additionalProperties": false,
            "properties": {
              "bindingSpec": { "type": "string" },
              "name": { "type": "string" },
              "location": { "type": "string" },
              "content": {},
              "outputLocation": { "type": "string" },
              "embed": { "type": "boolean" },
              "description": { "type": "string" }
            }
          },
          "resources": {
            "type": "object",
            "description": "A closed, immutable artifact dependency set keyed by absolute retrieval URI, lifted from processor-scenario.schema.json's given.resources. Family adapters expose these resources through their ordinary artifact resolver; this is harness input, not an OBI document field. It adds no comparison semantics: the compared surface stays operations, bindings, coverage and outcome. Every address a scenario reaches must be answerable from its own source or its own resources, so no runner touches the network.",
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
              "description": "Absolute URI spelling; adapters do not infer a base for corpus resources."
            },
            "additionalProperties": {
              "description": "The parsed object or source text returned for this artifact URI.",
              "oneOf": [
                { "type": "object" },
                { "type": "string" }
              ]
            }
          },
          "expected": {
            "type": "object",
            "required": ["outcome"],
            "additionalProperties": false,
            "properties": {
              "outcome": { "enum": ["synthesized", "refused"] },
              "rules": {
                "description": "Rules that make whole-source refusal the faithful outcome. These identify the authority for the fixture; diagnostic error prose is intentionally not compared across implementations.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "operations": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["operationKey", "bindingSelector"],
                  "additionalProperties": false,
                  "properties": {
                    "operationKey": { "type": "string", "minLength": 1 },
                    "bindingSelector": { "type": "string" }
                  }
                }
              },
              "assertions": {
                "description": "Optional pointer-addressed assertions evaluated against the emitted OBI document, reusing processor-scenario.schema.json's assertion object verbatim. Addressing rule: a path may traverse names Core, the binding specification, or an incorporated authority defines, plus names the artifact itself supplies (an operation identifier or declared property name). It MUST NOT traverse a name an implementation or a separately versioned project interface mints, such as a generated or qualified `$defs` cut-point key, because requiring a third-party implementation to reproduce a name no governing authority states makes conformance mean 'matches what we built'. Author an assertion only for a fact a finding is about; an assertion with no finding behind it is a golden file arriving by another route.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/",
                      "description": "JSON Pointer into the emitted OBI document."
                    },
                    "equals": {},
                    "absent": { "const": true },
                    "oneOf": { "type": "array", "minItems": 1 },
                    "setEquals": { "type": "array", "uniqueItems": true },
                    "contains": {}
                  },
                  "oneOf": [
                    { "required": ["equals"] },
                    { "required": ["absent"] },
                    { "required": ["oneOf"] },
                    { "required": ["setEquals"] },
                    { "required": ["contains"] }
                  ]
                }
              },
              "coverage": {
                "type": "object",
                "required": ["exhaustive", "fullyRepresented", "entries"],
                "additionalProperties": false,
                "properties": {
                  "exhaustive": { "type": "boolean" },
                  "fullyRepresented": { "type": "boolean" },
                  "entries": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/coverageEntry" }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "outcome": { "const": "synthesized" } },
                  "required": ["outcome"]
                },
                "then": {
                  "required": ["operations", "bindings", "coverage"]
                },
                "else": {
                  "required": ["rules"],
                  "not": {
                    "anyOf": [
                      { "required": ["operations"] },
                      { "required": ["bindings"] },
                      { "required": ["coverage"] },
                      { "required": ["assertions"] }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "enum": ["openapi-2.0", "openapi-3.0", "openapi-3.1", "openapi-3.2"]
          }
        },
        "required": ["family"]
      },
      "then": {
        "properties": {
          "format": { "const": "openbindings.binding-spec-synthesis-scenarios@5" }
        }
      },
      "else": {
        "properties": {
          "format": { "const": "openbindings.binding-spec-synthesis-scenarios@4" }
        }
      }
    }
  ],
  "$defs": {
    "coverageEntry": {
      "type": "object",
      "required": ["sourceIndex", "sourceRef", "scope", "status", "requirements"],
      "additionalProperties": false,
      "properties": {
        "sourceIndex": { "type": "integer", "minimum": 0 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["source", "target", "alternative", "projection", "dependency"] },
        "status": {
          "enum": [
            "represented",
            "excluded",
            "invalid",
            "lossy",
            "implementation-unsupported"
          ]
        },
        "operationKey": { "type": "string", "minLength": 1 },
        "bindingSelector": { "type": "string" },
        "reasonCode": {
          "description": "Optional diagnostic annotation retained for local triage. It is not part of portable comparison semantics and a conforming adapter MUST ignore its presence, absence, and spelling.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "rule": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "represented" } } },
          "then": {
            "oneOf": [
              {
                "properties": { "scope": { "const": "dependency" } },
                "required": ["scope"],
                "not": {
                  "anyOf": [
                    { "required": ["operationKey"] },
                    { "required": ["bindingSelector"] },
                    { "required": ["reasonCode"] }
                  ]
                }
              },
              {
                "properties": {
                  "scope": { "enum": ["target", "alternative", "projection"] }
                },
                "required": ["operationKey", "bindingSelector"],
                "not": { "required": ["reasonCode"] }
              }
            ]
          },
          "else": {
            "not": { "properties": { "scope": { "const": "dependency" } } }
          }
        }
      ]
    }
  }
}
