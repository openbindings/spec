{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/binding-specs/synthesis-scenario.schema.json",
  "title": "OpenBindings binding-specification synthesis scenarios",
  "description": "Portable authoring scenarios that compare synthesized target identities and exhaustive source-artifact disposition evidence, or require whole-source refusal when faithful synthesis is impossible, without prescribing an SDK API. Revision 3 adds a closed companion-document set so a multi-document artifact can be expressed at all, and an optional assertion list so a scenario can pin an emitted value its finding is about. Revision 4 renames the binding identity member bindingRef to bindingSelector, tracking the core rename of the binding member ref to selector; sourceRef names a source-local unit, not the binding member, and is unchanged. Revision 5 adds targetless dependency coverage for source interactions synthesized as Core dependencies. Revision 6 adds the AsyncAPI edition siblings, mandatory atomic rule and section citations, precise protocol/message alternative scopes, exact normalized coverage-inventory assertions, and stronger uniqueness and owner evidence. Revision 7 is an additive AsyncAPI-3.1-only apparatus revision; C20A deliberately preserves the revision-6 synthesis vocabulary and scenario meanings while isolating the first HTTP revision-2 scaffold.",
  "type": "object",
  "required": ["format", "bindingSpec", "family", "description", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "enum": [
        "openbindings.binding-spec-synthesis-scenarios@4",
        "openbindings.binding-spec-synthesis-scenarios@5",
        "openbindings.binding-spec-synthesis-scenarios@6",
        "openbindings.binding-spec-synthesis-scenarios@7"
      ]
    },
    "bindingSpec": {
      "type": "string",
      "pattern": "^openbindings\\.(usage|openapi-(2\\.0|3\\.0|3\\.1|3\\.2)|asyncapi(-2\\.6|-3\\.0|-3\\.1)?|mcp|grpc|connect|graphql)@[1-9][0-9]*$"
    },
    "family": {
      "enum": ["usage", "openapi-2.0", "openapi-3.0", "openapi-3.1", "openapi-3.2", "asyncapi", "asyncapi-2.6", "asyncapi-3.0", "asyncapi-3.1", "mcp", "grpc", "connect", "graphql"]
    },
    "description": { "type": "string", "minLength": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "source", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(USAGE|OAPI(20|30|31|32)|ASYNC(26|30|31)?|MCP|GRPC|CONN|GQL)-SS-[0-9]{2,}$"
          },
          "rules": {
            "description": "Atomic processor or synthesizer rules exercised by this scenario. Optional for legacy scenarios; the verifier requires complete S-rule coverage for every family using revision 5 or revision 6.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(USAGE|OAPI(20|30|31|32)|ASYNC(26|30|31)?|MCP|GRPC|CONN|GQL)-[PS]-[0-9]+$"
            }
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "description": "Family-specification section containing every atomic rule cited by this scenario. Required by revision 6."
          },
          "description": { "type": "string", "minLength": 1 },
          "source": {
            "description": "One Core binding source. It must carry `location` or `content`, so every scenario describes a source admitted by the OpenBindings document model without depending on any project interface contract.",
            "type": "object",
            "required": ["bindingSpec"],
            "anyOf": [
              { "required": ["location"] },
              { "required": ["content"] }
            ],
            "additionalProperties": false,
            "properties": {
              "bindingSpec": { "type": "string" },
              "name": { "type": "string" },
              "location": { "type": "string" },
              "content": {},
              "outputLocation": { "type": "string" },
              "embed": { "type": "boolean" },
              "description": { "type": "string" }
            }
          },
          "resources": {
            "type": "object",
            "description": "A closed, immutable artifact dependency set keyed by absolute retrieval URI, lifted from processor-scenario.schema.json's given.resources. Family adapters expose these resources through their ordinary artifact resolver; this is harness input, not an OBI document field. It adds no comparison semantics: the compared surface stays operations, bindings, coverage and outcome. Every address a scenario reaches must be answerable from its own source or its own resources, so no runner touches the network.",
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
              "description": "Absolute URI spelling; adapters do not infer a base for corpus resources."
            },
            "additionalProperties": {
              "description": "Any parsed JSON-image value or source text returned for this artifact URI. Family semantics decide whether the selected value has the required kind."
            }
          },
          "resourceBytes": { "$ref": "#/$defs/resourceBytes" },
          "keyMaterializations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/keyMaterialization" }
          },
          "expected": {
            "type": "object",
            "required": ["outcome"],
            "additionalProperties": false,
            "properties": {
              "outcome": { "enum": ["synthesized", "refused"] },
              "rules": {
                "description": "Rules that make whole-source refusal the faithful outcome. These identify the authority for the fixture; diagnostic error prose is intentionally not compared across implementations.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "operations": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["operationKey", "bindingSelector"],
                  "additionalProperties": false,
                  "properties": {
                    "operationKey": { "type": "string", "minLength": 1 },
                    "bindingSelector": { "type": "string" }
                  }
                }
              },
              "assertions": {
                "description": "Optional pointer-addressed assertions evaluated against the emitted OBI document, using the portable structural subset of processor-scenario assertions listed below. Addressing rule: a path may traverse names Core, the binding specification, or an incorporated authority defines, plus names the artifact itself supplies (an operation identifier or declared property name). It MUST NOT traverse a name an implementation or a separately versioned project interface mints, such as a generated or qualified `$defs` cut-point key, because requiring a third-party implementation to reproduce a name no governing authority states makes conformance mean 'matches what we built'. Author an assertion only for a fact a finding is about; an assertion with no finding behind it is a golden file arriving by another route.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "additionalProperties": false,
                  "properties": {
                    "rule": {
                      "type": "string",
                      "pattern": "^(USAGE|OAPI(20|30|31|32)|ASYNC(26|30|31)?|MCP|GRPC|CONN|GQL)-S-[0-9]+$",
                      "description": "Revision-6-only atomic owner for this emitted-document assertion."
                    },
                    "surface": {
                      "enum": ["document", "coverage-inventory"],
                      "description": "Revision-6-only comparison surface. document is the emitted OBI document; coverage-inventory is the normalized order-independent set of coverage identity fields and uses path '/'."
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^/",
                      "description": "JSON Pointer into the emitted OBI document."
                    },
                    "equals": {},
                    "absent": { "const": true },
                    "oneOf": { "type": "array", "minItems": 1 },
                    "setEquals": { "type": "array", "uniqueItems": true },
                    "contains": {}
                  },
                  "oneOf": [
                    { "required": ["equals"] },
                    { "required": ["absent"] },
                    { "required": ["oneOf"] },
                    { "required": ["setEquals"] },
                    { "required": ["contains"] }
                  ]
                }
              },
              "coverage": {
                "type": "object",
                "required": ["exhaustive", "fullyRepresented", "entries"],
                "additionalProperties": false,
                "properties": {
                  "exhaustive": { "type": "boolean" },
                  "fullyRepresented": { "type": "boolean" },
                  "entries": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/coverageEntry" }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "outcome": { "const": "synthesized" } },
                  "required": ["outcome"]
                },
                "then": {
                  "required": ["operations", "bindings", "coverage"]
                },
                "else": {
                  "required": ["rules"],
                  "not": {
                    "anyOf": [
                      { "required": ["operations"] },
                      { "required": ["bindings"] },
                      { "required": ["coverage"] },
                      { "required": ["assertions"] }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "enum": ["openapi-2.0", "openapi-3.0", "openapi-3.1", "openapi-3.2"]
          }
        },
        "required": ["family"]
      },
      "then": {
        "properties": {
          "format": { "const": "openbindings.binding-spec-synthesis-scenarios@5" }
        }
      },
      "else": {
        "if": {
          "properties": {
            "family": { "enum": ["asyncapi-2.6", "asyncapi-3.0"] }
          },
          "required": ["family"]
        },
        "then": {
          "properties": {
            "format": { "const": "openbindings.binding-spec-synthesis-scenarios@6" }
          }
        },
        "else": {
          "if": {
            "properties": { "family": { "const": "asyncapi-3.1" } },
            "required": ["family"]
          },
          "then": {
            "properties": {
              "format": { "const": "openbindings.binding-spec-synthesis-scenarios@7" }
            }
          },
          "else": {
            "properties": {
              "format": { "const": "openbindings.binding-spec-synthesis-scenarios@4" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "enum": [
              "openbindings.binding-spec-synthesis-scenarios@6",
              "openbindings.binding-spec-synthesis-scenarios@7"
            ]
          }
        },
        "required": ["format"]
      },
      "then": {
        "properties": {
          "scenarios": {
            "items": {
              "required": ["rules", "section"],
              "properties": {
                "expected": {
                  "properties": {
                    "bindings": { "uniqueItems": true },
                    "assertions": {
                      "items": {
                        "required": ["rule"],
                        "allOf": [
                          {
                            "if": {
                              "properties": { "surface": { "const": "coverage-inventory" } },
                              "required": ["surface"]
                            },
                            "then": {
                              "properties": { "path": { "const": "/" } },
                              "required": ["setEquals"]
                            }
                          }
                        ]
                      }
                    },
                    "coverage": {
                      "properties": {
                        "entries": {
                          "uniqueItems": true,
                          "items": {
                            "required": ["rule"],
                            "properties": {
                              "scope": {
                                "enum": [
                                  "source",
                                  "target",
                                  "projection",
                                  "dependency",
                                  "message-alternative",
                                  "reply-message-alternative",
                                  "protocol-cell"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scenarios": {
            "items": {
              "not": { "required": ["resourceBytes"] },
              "properties": {
                "expected": {
                  "properties": {
                    "assertions": {
                      "items": {
                        "not": {
                          "anyOf": [
                            { "required": ["rule"] },
                            { "required": ["surface"] }
                          ]
                        }
                      }
                    },
                    "coverage": {
                      "properties": {
                        "entries": {
                          "items": {
                            "properties": {
                              "scope": {
                                "enum": ["source", "target", "alternative", "projection", "dependency"]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "format": { "not": { "const": "openbindings.binding-spec-synthesis-scenarios@7" } } },
        "required": ["format"]
      },
      "then": {
        "properties": {
          "scenarios": { "items": { "not": { "required": ["keyMaterializations"] } } }
        }
      }
    }
  ],
  "$defs": {
    "keyMaterialization": {
      "type": "object",
      "description": "Corpus-only preprocessing that adds a source-map key from exact UTF-16 code units without embedding an unpaired surrogate in JSON text.",
      "required": ["path", "kind", "codeUnits", "value"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(?:source/content(?:/(?:[^~/]|~[01])*)*|resources/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])*)*)$",
          "description": "Canonical JSON Pointer confined to source.content or a parsed resources entry. resourceBytes is not addressable before decoding."
        },
        "kind": { "const": "unpaired-utf16-key" },
        "codeUnits": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
        },
        "value": {}
      }
    },
    "resourceBytes": {
      "type": "object",
      "description": "Revision-6 exact-octet resource carrier keyed by absolute retrieval URI. It is disjoint from resources and every value is a versioned canonical Base64 envelope.",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["format", "dataBase64"],
        "additionalProperties": false,
        "properties": {
          "format": { "const": "openbindings.resource-bytes@1" },
          "dataBase64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      }
    },
    "coverageEntry": {
      "type": "object",
      "required": ["sourceIndex", "sourceRef", "scope", "status", "requirements"],
      "additionalProperties": false,
      "properties": {
        "sourceIndex": { "type": "integer", "minimum": 0 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "scope": {
          "enum": [
            "source",
            "target",
            "alternative",
            "projection",
            "dependency",
            "message-alternative",
            "reply-message-alternative",
            "protocol-cell"
          ]
        },
        "status": {
          "enum": [
            "represented",
            "excluded",
            "invalid",
            "lossy",
            "implementation-unsupported"
          ]
        },
        "operationKey": { "type": "string", "minLength": 1 },
        "bindingSelector": { "type": "string" },
        "reasonCode": {
          "description": "Optional diagnostic annotation retained for local triage. It is not part of portable comparison semantics and a conforming adapter MUST ignore its presence, absence, and spelling.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "rule": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "represented" } } },
          "then": {
            "oneOf": [
              {
                "properties": { "scope": { "const": "dependency" } },
                "required": ["scope"],
                "not": {
                  "anyOf": [
                    { "required": ["operationKey"] },
                    { "required": ["bindingSelector"] },
                    { "required": ["reasonCode"] }
                  ]
                }
              },
              {
                "properties": {
                  "scope": {
                    "enum": [
                      "target",
                      "alternative",
                      "projection",
                      "message-alternative",
                      "reply-message-alternative",
                      "protocol-cell"
                    ]
                  }
                },
                "required": ["operationKey", "bindingSelector"],
                "not": { "required": ["reasonCode"] }
              }
            ]
          },
          "else": {
            "not": { "properties": { "scope": { "const": "dependency" } } }
          }
        }
      ]
    }
  }
}
