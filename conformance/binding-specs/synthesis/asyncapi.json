            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/subscribe#message[0]=#/channels/events/messages/event",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "subscribe",
              "bindingRef": "#/operations/subscribe",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/subscribe#reply-message[0]=#/channels/commands/messages/command",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "subscribe",
              "bindingRef": "#/operations/subscribe",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/subscribe#server[0]=ws",
              "scope": "alternative",
