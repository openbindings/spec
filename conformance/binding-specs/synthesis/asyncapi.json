    },
    {
      "id": "ASYNC-SS-05",
      "description": "An artifact whose payload schemas use Draft-07 spellings the OBI dialect changed (tuple items, additionalItems, dependencies, a declared $schema) synthesizes fully represented: Schema Objects enter OBI positions under semantic-preserving dialect translation, never verbatim copy and never whole-artifact refusal.",
      "source": {
        "bindingSpec": "openbindings.asyncapi@1",
        "content": {
          "asyncapi": "3.0.0",
          "info": {
            "title": "Draft-07 spellings",
            "version": "1"
          },
          "servers": {
            "ws": {
              "host": "events.example",
              "protocol": "wss"
            }
          },
          "channels": {
            "events": {
              "address": "/events",
              "messages": {
                "event": {
                  "payload": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "type": "object",
                    "properties": {
                      "pair": {
                        "type": "array",
                        "items": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ],
                        "additionalItems": {
                          "type": "boolean"
                        }
                      },
                      "card": {
                        "type": "string"
                      }
                    },
                    "dependencies": {
                      "card": [
                        "cvv"
                      ]
                    }
                  }
                }
              }
            }
          },
          "operations": {
            "publishEvent": {
              "action": "receive",
              "channel": {
                "$ref": "#/channels/events"
              },
              "messages": [
                {
                  "$ref": "#/channels/events/messages/event"
                }
              ]
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "publishEvent"
        ],
        "bindings": [
          {
            "operationKey": "publishEvent",
            "bindingRef": "#/operations/publishEvent"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/publishEvent",
              "scope": "target",
              "status": "represented",
              "operationKey": "publishEvent",
              "bindingRef": "#/operations/publishEvent",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/publishEvent#message[0]=#/channels/events/messages/event",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "publishEvent",
              "bindingRef": "#/operations/publishEvent",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/publishEvent#server[0]=ws",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "publishEvent",
              "bindingRef": "#/operations/publishEvent",
              "requirements": []
            }
          ]
        }
      }
    },
    {
      "id": "ASYNC-SS-06",
      "description": "A message whose effective content type has no JSON application-value carriage (application/avro) floors to the unconstrained representation: the payload bytes never cross the JSON boundary, so even a translatable schema could not describe the carried value. The alternative accounts as lossy under asyncapi.payload_carriage_unsupported, the artifact is never fully represented, and the operation remains invocable.",
      "source": {
        "bindingSpec": "openbindings.asyncapi@1",
        "content": {
          "asyncapi": "3.0.0",
          "info": {
            "title": "Foreign representation",
            "version": "1"
          },
          "servers": {
            "broker": {
              "host": "broker.example:9092",
              "protocol": "kafka"
            }
          },
          "channels": {
            "records": {
              "address": "records.v1",
              "messages": {
                "record": {
                  "contentType": "application/avro",
                  "payload": {
                    "type": "record",
                    "name": "Record",
                    "fields": [
                      {
                        "name": "id",
                        "type": "long"
                      }
                    ]
                  }
                }
              }
            }
          },
          "operations": {
            "publishRecord": {
              "action": "receive",
              "channel": {
                "$ref": "#/channels/records"
              },
              "messages": [
                {
                  "$ref": "#/channels/records/messages/record"
                }
              ]
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "publishRecord"
        ],
        "bindings": [
          {
            "operationKey": "publishRecord",
            "bindingRef": "#/operations/publishRecord"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": false,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/publishRecord",
              "scope": "target",
              "status": "represented",
              "operationKey": "publishRecord",
              "bindingRef": "#/operations/publishRecord",
              "requirements": [
                "configuration.server"
              ]
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/publishRecord#message[0]=#/channels/records/messages/record",
              "scope": "alternative",
              "status": "lossy",
              "operationKey": "publishRecord",
              "bindingRef": "#/operations/publishRecord",
              "requirements": [],
              "reasonCode": "asyncapi.payload_carriage_unsupported",
              "rule": "ASYNC-P-05"
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/publishRecord#server[0]=broker",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "publishRecord",
              "bindingRef": "#/operations/publishRecord",
              "requirements": []
            }
          ]
        }
      }
    },
    {
      "id": "ASYNC-SS-07",
      "description": "A message whose declared schemaFormat identifies a non-JSON-Schema language (Avro) cannot contribute a faithful schema even though its JSON carriage would work: the direction floors to the unconstrained representation and accounts as lossy under asyncapi.schema_format_not_convertible. Distinct from the carriage case: this loss has a conversion-shaped revisit trigger.",
      "source": {
        "bindingSpec": "openbindings.asyncapi@1",
        "content": {
          "asyncapi": "3.0.0",
          "info": {
            "title": "Foreign schema language",
            "version": "1"
          },
          "servers": {
            "broker": {
              "host": "broker.example:9092",
              "protocol": "kafka"
            }
          },
          "channels": {
            "records": {
              "address": "records.v1",
              "messages": {
                "record": {
                  "payload": {
                    "type": "record",
                    "name": "Record",
                    "fields": [
                      {
                        "name": "id",
                        "type": "long"
                      }
                    ]
                  },
                  "schemaFormat": "application/vnd.apache.avro;version=1.9.0"
                }
              }
            }
          },
          "operations": {
            "publishRecord": {
              "action": "receive",
              "channel": {
                "$ref": "#/channels/records"
              },
              "messages": [
                {
                  "$ref": "#/channels/records/messages/record"
                }
              ]
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "publishRecord"
        ],
        "bindings": [
          {
            "operationKey": "publishRecord",
            "bindingRef": "#/operations/publishRecord"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": false,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/publishRecord",
              "scope": "target",
              "status": "represented",
              "operationKey": "publishRecord",
              "bindingRef": "#/operations/publishRecord",
              "requirements": [
                "configuration.server"
              ]
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/publishRecord#message[0]=#/channels/records/messages/record",
              "scope": "alternative",
              "status": "lossy",
              "operationKey": "publishRecord",
              "bindingRef": "#/operations/publishRecord",
              "requirements": [],
              "reasonCode": "asyncapi.schema_format_not_convertible",
              "rule": "ASYNC-P-05"
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/operations/publishRecord#server[0]=broker",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "publishRecord",
              "bindingRef": "#/operations/publishRecord",
              "requirements": []
            }
          ]
        }
      }
    }
  ]
}
