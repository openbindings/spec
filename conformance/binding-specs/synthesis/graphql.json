{
  "format": "openbindings.binding-spec-synthesis-scenarios@4",
  "bindingSpec": "openbindings.graphql@1",
  "family": "graphql",
  "description": "Portable GraphQL synthesis scenarios: one operation per operation definition, addressed by operation name, with the schema carried in either representation; and the two whole-source refusals the load gates make faithful. Scenarios asserting the derived input and output schemas arrive with §6 and §7. Operation keys asserted here are the reference synthesizer's spelling, which §11.2 and §11.4 declare synthesis policy; a synthesizer spelling keys otherwise conforms to GQL-S-01 and fails only the key comparison, as in every family's synthesis corpus.",
  "scenarios": [
    {
      "id": "GQL-SS-01",
      "description": "Every named operation definition of the carried document becomes one operation, addressed by its name, typed against the type-system-language schema.",
      "source": {
        "bindingSpec": "openbindings.graphql@1",
        "location": "https://api.example.test/graphql",
        "content": {
          "document": "query Viewer($id: ID!) { viewer(id: $id) { id name } }\nquery Status { status }\nquery Find($filter: Filter!) { find(filter: $filter) { id } }\nmutation Rename($id: ID!, $name: String!) { rename(id: $id, name: $name) { id name } }\n",
          "schema": "type Query { viewer(id: ID!): User status: String find(filter: Filter!): User }\ntype Mutation { rename(id: ID!, name: String!): User }\ntype User { id: ID! name: String }\ninput Filter @oneOf { byId: ID byName: String }\n"
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "Find",
          "Rename",
          "Status",
          "Viewer"
        ],
        "bindings": [
          {
            "operationKey": "Find",
            "bindingSelector": "Find"
          },
          {
            "operationKey": "Rename",
            "bindingSelector": "Rename"
          },
          {
            "operationKey": "Status",
            "bindingSelector": "Status"
          },
          {
            "operationKey": "Viewer",
            "bindingSelector": "Viewer"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "Find",
              "scope": "target",
              "status": "represented",
              "operationKey": "Find",
              "bindingSelector": "Find",
              "requirements": [],
              "rule": "GQL-S-01"
            },
            {
              "sourceIndex": 0,
              "sourceRef": "Rename",
              "scope": "target",
              "status": "represented",
              "operationKey": "Rename",
              "bindingSelector": "Rename",
              "requirements": [],
              "rule": "GQL-S-01"
            },
            {
              "sourceIndex": 0,
              "sourceRef": "Status",
              "scope": "target",
              "status": "represented",
              "operationKey": "Status",
              "bindingSelector": "Status",
              "requirements": [],
              "rule": "GQL-S-01"
            },
            {
              "sourceIndex": 0,
              "sourceRef": "Viewer",
              "scope": "target",
              "status": "represented",
              "operationKey": "Viewer",
              "bindingSelector": "Viewer",
              "requirements": [],
              "rule": "GQL-S-01"
            }
          ]
        }
      }
    },
