          { "sourceIndex": 0, "sourceRef": "file[12]:source.proto#demo.Req/field:1", "scope": "projection", "status": "excluded", "operationKey": "demo.S.Get", "bindingSelector": "demo.S/Get", "rule": "GRPC-S-03", "requirements": [] }
