{
  "format": "openbindings.binding-spec-synthesis-scenarios@7",
  "bindingSpec": "openbindings.grpc@1",
  "family": "grpc",
  "description": "Portable gRPC method inventory, schema projection, reflection parity, target identity, and exhaustive smallest-owner coverage.",
  "scenarios": [
    {
      "id": "GRPC-SS-01",
      "rules": ["GRPC-S-01", "GRPC-S-02"],
      "description": "One service containing all four cardinalities produces four canonically keyed operations and bindings.",
      "source": {
        "bindingSpec": "openbindings.grpc@1",
        "location": "grpc://localhost:50051",
        "content": "syntax = \"proto3\"; package demo; message Req {} message Res {} service S { rpc Unary(Req) returns (Res); rpc Server(Req) returns (stream Res); rpc Client(stream Req) returns (Res); rpc Bidi(stream Req) returns (stream Res); }"
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["demo.S.Bidi", "demo.S.Client", "demo.S.Server", "demo.S.Unary"],
        "bindings": [
          { "operationKey": "demo.S.Bidi", "bindingSelector": "demo.S/Bidi" },
          { "operationKey": "demo.S.Client", "bindingSelector": "demo.S/Client" },
          { "operationKey": "demo.S.Server", "bindingSelector": "demo.S/Server" },
          { "operationKey": "demo.S.Unary", "bindingSelector": "demo.S/Unary" }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            { "sourceIndex": 0, "sourceRef": "demo.S/Bidi", "scope": "target", "status": "represented", "operationKey": "demo.S.Bidi", "bindingSelector": "demo.S/Bidi", "requirements": [] },
            { "sourceIndex": 0, "sourceRef": "demo.S/Client", "scope": "target", "status": "represented", "operationKey": "demo.S.Client", "bindingSelector": "demo.S/Client", "requirements": [] },
            { "sourceIndex": 0, "sourceRef": "demo.S/Server", "scope": "target", "status": "represented", "operationKey": "demo.S.Server", "bindingSelector": "demo.S/Server", "requirements": [] },
            { "sourceIndex": 0, "sourceRef": "demo.S/Unary", "scope": "target", "status": "represented", "operationKey": "demo.S.Unary", "bindingSelector": "demo.S/Unary", "requirements": [] }
          ]
        }
      }
    },
    {
      "id": "GRPC-SS-02",
      "rules": ["GRPC-S-03"],
      "description": "Recursive messages and an int64 field require distinct faithful input and output projections rather than an unconstrained object.",
      "source": {
        "bindingSpec": "openbindings.grpc@1",
        "location": "grpcs://api.example:443",
        "content": "syntax = \"proto3\"; package demo; message Node { int64 id = 1; repeated Node children = 2; } service S { rpc Put(Node) returns (Node); }"
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["demo.S.Put"],
        "bindings": [{ "operationKey": "demo.S.Put", "bindingSelector": "demo.S/Put" }],
        "assertions": [
          { "path": "/schemas/input.demo.Node/type", "equals": "object" },
          { "path": "/schemas/input.demo.Node/properties/children/anyOf/0/items/$ref", "equals": "#/schemas/input.demo.Node" },
          { "path": "/schemas/output.demo.Node/properties/id/type", "equals": "string" }
        ],
        "coverage": { "exhaustive": true, "fullyRepresented": true, "entries": [
          { "sourceIndex": 0, "sourceRef": "demo.S/Put", "scope": "target", "status": "represented", "operationKey": "demo.S.Put", "bindingSelector": "demo.S/Put", "requirements": [] }
        ] }
      }
    },
    {
      "id": "GRPC-SS-03",
      "rules": ["GRPC-S-04", "GRPC-S-07"],
      "description": "A group-bearing method is excluded at its projection owner while a sibling method remains represented and coverage stays exhaustive.",
      "source": {
        "bindingSpec": "openbindings.grpc@1",
        "location": "grpc://localhost:50051",
        "content": "syntax = \"proto2\"; package demo; message Good { optional string value = 1; } message Bad { optional group Legacy = 1 { optional string value = 2; } } service S { rpc AGood(Good) returns (Good); rpc ZBad(Bad) returns (Good); }"
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["demo.S.AGood"],
        "bindings": [{ "operationKey": "demo.S.AGood", "bindingSelector": "demo.S/AGood" }],
        "coverage": { "exhaustive": true, "fullyRepresented": false, "entries": [
          { "sourceIndex": 0, "sourceRef": "demo.S/AGood", "scope": "target", "status": "represented", "operationKey": "demo.S.AGood", "bindingSelector": "demo.S/AGood", "requirements": [] },
          { "sourceIndex": 0, "sourceRef": "demo.S/ZBad", "scope": "target", "status": "excluded", "operationKey": "demo.S.ZBad", "bindingSelector": "demo.S/ZBad", "rule": "GRPC-S-07", "requirements": [] },
          { "sourceIndex": 0, "sourceRef": "file[12]:source.proto#demo.Bad/field:1", "scope": "projection", "status": "excluded", "operationKey": "demo.S.ZBad", "bindingSelector": "demo.S/ZBad", "rule": "GRPC-S-03", "requirements": [] }
        ] }
      }
    },
    {
      "id": "GRPC-SS-04",
      "rules": ["GRPC-S-05"],
      "description": "A reflected descriptor graph produces the same target identity as its embedded binary FileDescriptorSet.",
      "source": { "bindingSpec": "openbindings.grpc@1", "location": "grpc://localhost:50051" },
      "discovery": {
        "format": "openbindings.grpc-reflection-transcript@1",
        "version": "v1",
        "stream": 0,
        "listedServices": ["demo.S"],
        "descriptorSetBase64": "CkwKDHNvdXJjZS5wcm90bxIEZGVtbyIFCgNSZXEiBQoDUmVzMiAKAVMSGwoDR2V0EgkuZGVtby5SZXEaCS5kZW1vLlJlc2IGcHJvdG8z",
        "requests": [{ "kind": "list-services", "value": "" }, { "kind": "file-containing-symbol", "value": "demo.S" }]
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["demo.S.Get"],
        "bindings": [{ "operationKey": "demo.S.Get", "bindingSelector": "demo.S/Get" }],
        "coverage": { "exhaustive": true, "fullyRepresented": true, "entries": [
          { "sourceIndex": 0, "sourceRef": "demo.S/Get", "scope": "target", "status": "represented", "operationKey": "demo.S.Get", "bindingSelector": "demo.S/Get", "requirements": [] }
        ] }
      }
    },
    {
      "id": "GRPC-SS-05",
      "rules": ["GRPC-S-06"],
      "description": "A bare authority preserves a transport configuration requirement in the represented binding.",
      "source": { "bindingSpec": "openbindings.grpc@1", "location": "localhost:50051", "content": "syntax = \"proto3\"; package demo; message Req {} service S { rpc Get(Req) returns (Req); }" },
      "expected": {
        "outcome": "synthesized", "operations": ["demo.S.Get"], "bindings": [{ "operationKey": "demo.S.Get", "bindingSelector": "demo.S/Get" }],
        "coverage": { "exhaustive": true, "fullyRepresented": true, "entries": [
          { "sourceIndex": 0, "sourceRef": "demo.S/Get", "scope": "target", "status": "represented", "operationKey": "demo.S.Get", "bindingSelector": "demo.S/Get", "requirements": ["configuration.transport"] }
        ] }
      }
    },
    {
      "id": "GRPC-SS-06",
      "rules": ["GRPC-S-06"],
      "description": "An explicit TLS scheme carries no stale transport election requirement.",
      "source": { "bindingSpec": "openbindings.grpc@1", "location": "grpcs://api.example:443", "content": "syntax = \"proto3\"; package demo; message Req {} service S { rpc Get(Req) returns (Req); }" },
      "expected": {
        "outcome": "synthesized", "operations": ["demo.S.Get"], "bindings": [{ "operationKey": "demo.S.Get", "bindingSelector": "demo.S/Get" }],
        "coverage": { "exhaustive": true, "fullyRepresented": true, "entries": [
          { "sourceIndex": 0, "sourceRef": "demo.S/Get", "scope": "target", "status": "represented", "operationKey": "demo.S.Get", "bindingSelector": "demo.S/Get", "requirements": [] }
        ] }
      }
    },
    {
      "id": "GRPC-SS-07",
      "rules": ["GRPC-S-08"],
      "description": "An empty descriptor set emits no operations or bindings and has exhaustive empty coverage.",
      "source": { "bindingSpec": "openbindings.grpc@1", "location": "grpc://localhost:50051", "content": { "file": [] } },
      "expected": { "outcome": "synthesized", "operations": [], "bindings": [], "coverage": { "exhaustive": true, "fullyRepresented": true, "entries": [] } }
    },
    {
      "id": "GRPC-SS-08",
      "rules": ["GRPC-S-01", "GRPC-S-08"],
      "description": "The reflection service is exhaustively excluded as infrastructure and emits no application operation.",
