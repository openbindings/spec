      "expected": {
        "outcome": "synthesized", "operations": ["writeChoice"],
        "bindings": [{"operationKey": "writeChoice", "bindingSelector": "#/paths/~1x/post"}],
        "assertions": [{"path": "/operations/writeChoice/input/properties/body/discriminator", "absent": true}],
        "coverage": {"exhaustive": true, "fullyRepresented": false, "entries": [
          {"sourceIndex": 0, "sourceRef": "#/paths/~1x/post", "scope": "target", "status": "represented", "operationKey": "writeChoice", "bindingSelector": "#/paths/~1x/post", "requirements": []},
          {"sourceIndex": 0, "sourceRef": "#/consumes/0", "scope": "alternative", "status": "represented", "operationKey": "writeChoice", "bindingSelector": "#/paths/~1x/post", "requirements": []},
          {"sourceIndex": 0, "sourceRef": "#/paths/~1x/post/body/schema/discriminator", "scope": "projection", "status": "lossy", "operationKey": "writeChoice", "bindingSelector": "#/paths/~1x/post", "reasonCode": "openapi20.discriminator_projection_loss", "rule": "OAPI20-P-01", "requirements": []}
        ]}
      }
    },
    {
      "id": "OAPI20-SS-10",
      "description": "A response Header Object array cannot use collectionFormat multi. The header declaration is excluded at its own projection position, while the operation remains represented because response headers create no output member under this binding (OAPI20-S-01, OAPI20-P-03).",
      "source": {
