          "paths": {"/x": {"post": {"operationId": "writeChoice", "parameters": [{"name": "payload", "in": "body", "required": true, "schema": {"type": "object", "discriminator": "kind", "properties": {"kind": {"type": "string"}}}}], "responses": {"204": {"description": "ok"}}}}}
        }
