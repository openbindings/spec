        "outcome": "synthesized",
        "operations": [
          "mixedBody"
        ],
        "bindings": [
          {
            "operationKey": "mixedBody",
            "bindingSelector": "#/paths/~1x/additionalOperations/MiXeD"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": false,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1x/query",
              "scope": "target",
              "status": "excluded",
              "reasonCode": "openapi.target_excluded",
              "rule": "OAPI32-P-01",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1x/additionalOperations/MiXeD",
              "scope": "target",
              "status": "represented",
              "operationKey": "mixedBody",
              "bindingSelector": "#/paths/~1x/additionalOperations/MiXeD",
              "requirements": []
            },
            {
              "sourceIndex": 0,
