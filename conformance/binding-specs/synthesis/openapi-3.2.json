    {
      "id": "OAPI32-SS-04",
      "description": "Edition-aware exhaustive coverage retains an excluded QUERY position while emitting a case-exact additional operation and its request transform [OAPI32-S-01, OAPI32-P-02].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {
            "title": "Inventory confinement",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://api.example"
            }
          ],
          "paths": {
            "/x": {
              "query": {
                "operationId": "excludedQuery",
                "parameters": [
                  {
                    "name": "whole",
                    "in": "querystring",
                    "schema": {
                      "type": "object"
                    }
                  },
                  {
                    "name": "q",
                    "in": "query",
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "204": {
                    "description": "ok"
                  }
                }
              },
              "additionalOperations": {
                "MiXeD": {
                  "operationId": "mixedBody",
                  "requestBody": {
                    "required": true,
                    "content": {
                      "text/plain": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "responses": {
                    "200": {
                      "description": "ok",
                      "content": {
                        "application/json": {
                          "schema": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
