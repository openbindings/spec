{
  "format": "openbindings.binding-spec-synthesis-scenarios@5",
  "bindingSpec": "openbindings.openapi-3.2@1",
  "family": "openapi-3.2",
  "description": "OpenAPI 3.2 path-operation coverage and exhaustive source-artifact disposition evidence.",
  "scenarios": [
    {
      "id": "OAPI32-SS-01",
      "description": "OAS 3.2.0 Path Item fixed fields add query and define additionalOperations keys as the HTTP method with the capitalization sent on the wire (edition analysis STRUCT-E16/E17). Both authority-defined targets are represented under the two selector forms ordered by CO32-04.",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {
            "title": "Additional methods",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://api.example"
            }
          ],
          "paths": {
            "/pets": {
              "query": {
                "operationId": "queryPets",
                "responses": {
                  "200": {
                    "description": "ok"
                  }
                }
              },
              "additionalOperations": {
                "COPY": {
                  "operationId": "copyPets",
                  "responses": {
                    "204": {
                      "description": "copied"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "queryPets",
          "copyPets"
        ],
        "bindings": [
          {
            "operationKey": "queryPets",
            "bindingSelector": "#/paths/~1pets/query"
          },
          {
            "operationKey": "copyPets",
            "bindingSelector": "#/paths/~1pets/additionalOperations/COPY"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1pets/query",
              "scope": "target",
              "status": "represented",
              "operationKey": "queryPets",
              "bindingSelector": "#/paths/~1pets/query",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1pets/additionalOperations/COPY",
              "scope": "target",
              "status": "represented",
              "operationKey": "copyPets",
              "bindingSelector": "#/paths/~1pets/additionalOperations/COPY",
              "requirements": []
            }
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-02",
      "description": "Synthesis keeps the operation contract protocol-neutral, emits an inputTransform for the request envelope, and accounts for server and security election as configuration requirements instead of input properties [OAPI32-S-01].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {"title": "Configuration boundary", "version": "1"},
          "servers": [{"url": "https://a.example"}, {"url": "https://b.example"}],
          "components": {
            "securitySchemes": {
              "first": {"type": "apiKey", "in": "header", "name": "X-First"},
              "second": {"type": "apiKey", "in": "query", "name": "second_key"}
            }
          },
          "paths": {
            "/items": {
              "post": {
                "operationId": "createItem",
                "parameters": [{"name": "trace", "in": "header", "schema": {"type": "string"}}],
                "security": [{"first": []}, {"second": []}],
                "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"name": {"type": "string"}}}}}},
                "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"type": "object"}}}}}
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["createItem"],
        "bindings": [{"operationKey": "createItem", "bindingSelector": "#/paths/~1items/post"}],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {"sourceIndex": 0, "sourceRef": "#/paths/~1items/post", "scope": "target", "status": "represented", "operationKey": "createItem", "bindingSelector": "#/paths/~1items/post", "requirements": ["configuration.server", "configuration.security"]},
            {"sourceIndex": 0, "sourceRef": "#/paths/~1items/post/requestBody/content/application~1json", "scope": "alternative", "status": "represented", "operationKey": "createItem", "bindingSelector": "#/paths/~1items/post", "requirements": []}
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-03",
      "description": "Malformed server and security members are confined to alternative coverage while their valid siblings preserve the represented target [OAPI32-S-01, OAPI32-P-04].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {"title": "Alternative confinement", "version": "1"},
          "servers": [{"url": "https://bad.example/base?fixed=1"}, {"url": "https://safe.example"}],
          "components": {
            "securitySchemes": {
              "broken": {"type": "apiKey", "in": "nowhere"},
              "safe": {"type": "apiKey", "in": "header", "name": "X-Safe"}
            }
          },
          "paths": {
            "/x": {
              "query": {
                "operationId": "querySafe",
                "security": [{"broken": []}, {"safe": []}],
                "responses": {"204": {"description": "ok"}}
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["querySafe"],
        "bindings": [{"operationKey": "querySafe", "bindingSelector": "#/paths/~1x/query"}],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": false,
          "entries": [
            {"sourceIndex": 0, "sourceRef": "#/paths/~1x/query", "scope": "target", "status": "represented", "operationKey": "querySafe", "bindingSelector": "#/paths/~1x/query", "requirements": ["configuration.security"]},
            {"sourceIndex": 0, "sourceRef": "#/paths/~1x/query/security/0", "scope": "alternative", "status": "excluded", "reasonCode": "openapi.security_alternative_unusable", "rule": "OAPI32-P-04", "operationKey": "querySafe", "bindingSelector": "#/paths/~1x/query", "requirements": []},
            {"sourceIndex": 0, "sourceRef": "#/servers/0", "scope": "alternative", "status": "excluded", "reasonCode": "openapi.server_url_excluded", "rule": "OAPI32-P-04", "operationKey": "querySafe", "bindingSelector": "#/paths/~1x/query", "requirements": []}
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-04",
      "description": "Edition-aware exhaustive coverage retains an excluded QUERY position while emitting a case-exact additional operation and its request transform [OAPI32-S-01, OAPI32-P-02].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {"title": "Inventory confinement", "version": "1"},
          "servers": [{"url": "https://api.example"}],
          "paths": {
            "/x": {
              "query": {
                "operationId": "excludedQuery",
                "parameters": [
                  {"name": "whole", "in": "querystring", "schema": {"type": "object"}},
                  {"name": "q", "in": "query", "schema": {"type": "string"}}
                ],
                "responses": {"204": {"description": "ok"}}
              },
              "additionalOperations": {
                "MiXeD": {
                  "operationId": "mixedBody",
                  "requestBody": {"required": true, "content": {"text/plain": {"schema": {"type": "string"}}}},
                  "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"type": "object"}}}}}
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["mixedBody"],
        "bindings": [{"operationKey": "mixedBody", "bindingSelector": "#/paths/~1x/additionalOperations/MiXeD"}],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": false,
          "entries": [
            {"sourceIndex": 0, "sourceRef": "#/paths/~1x/query", "scope": "target", "status": "excluded", "reasonCode": "openapi.target_excluded", "rule": "OAPI32-P-01", "requirements": []},
            {"sourceIndex": 0, "sourceRef": "#/paths/~1x/additionalOperations/MiXeD", "scope": "target", "status": "represented", "operationKey": "mixedBody", "bindingSelector": "#/paths/~1x/additionalOperations/MiXeD", "requirements": []},
            {"sourceIndex": 0, "sourceRef": "#/paths/~1x/additionalOperations/MiXeD/requestBody/content/text~1plain", "scope": "alternative", "status": "represented", "operationKey": "mixedBody", "bindingSelector": "#/paths/~1x/additionalOperations/MiXeD", "requirements": []}
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-05",
      "description": "A sequential response publishes itemSchema as the per-value OpenBindings output contract; the co-present complete-sequence schema remains an aggregate artifact constraint [OAPI32-S-01, OAPI32-P-03].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {"title": "Sequential response synthesis", "version": "1"},
          "servers": [{"url": "https://api.example"}],
          "paths": {
            "/events": {
              "get": {
                "operationId": "watchEvents",
                "responses": {
                  "200": {
                    "content": {
                      "application/jsonl": {
                        "schema": {"type": "array"},
                        "itemSchema": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["watchEvents"],
        "bindings": [{"operationKey": "watchEvents", "bindingSelector": "#/paths/~1events/get"}],
        "assertions": [
          {"path": "/operations/watchEvents/output/type", "equals": "object"},
          {"path": "/operations/watchEvents/output/properties/id/type", "equals": "string"}
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {"sourceIndex": 0, "sourceRef": "#/paths/~1events/get", "scope": "target", "status": "represented", "operationKey": "watchEvents", "bindingSelector": "#/paths/~1events/get", "requirements": []}
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-06",
      "description": "A noncanonical response Schema reference excludes only its smallest media owner; synthesis retains the sibling response contract and reports the unavailable alternative [OAPI32-S-01, OAPI32-P-01].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {"title": "Response identity confinement", "version": "1"},
          "servers": [{"url": "https://api.example"}],
          "components": {
            "schemas": {
              "Resource": {
                "$id": "https://schemas.example/resource",
                "type": "object",
                "properties": {"name": {"type": "string"}}
              }
            }
          },
          "paths": {
            "/x": {
              "get": {
                "operationId": "readValue",
                "responses": {
                  "200": {
                    "content": {
                      "application/json": {"schema": {"$ref": "#/components/schemas/Resource/properties/name"}},
                      "text/plain": {"schema": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["readValue"],
        "bindings": [{"operationKey": "readValue", "bindingSelector": "#/paths/~1x/get"}],
        "assertions": [
          {"path": "/operations/readValue/output/type", "equals": "string"}
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": false,
          "entries": [
            {"sourceIndex": 0, "sourceRef": "#/paths/~1x/get", "scope": "target", "status": "represented", "operationKey": "readValue", "bindingSelector": "#/paths/~1x/get", "requirements": []},
            {"sourceIndex": 0, "sourceRef": "#/paths/~1x/get/responses/200/content/application~1json", "scope": "alternative", "status": "excluded", "reasonCode": "openapi.response_media_excluded", "rule": "OAPI32-P-01", "requirements": []}
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-07",
      "description": "Callback and webhook Path Items expose fixed QUERY and case-exact additional operations as separate targetless dependencies; the callback runtime expression remains only a service-selected destination and no dependency acquires a binding-family constraint [OAPI32-S-01].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {"title": "Inbound dependency inventory", "version": "1"},
          "servers": [{"url": "https://api.example"}],
          "paths": {
            "/jobs": {
              "post": {
                "operationId": "createJob",
                "callbacks": {
                  "done": {
                    "{$request.body#/url}": {
                      "post": {
                        "operationId": "receiveDone",
                        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}}}},
                        "responses": {"200": {"content": {"application/json": {"schema": {"type": "string"}}}}}
                      },
                      "additionalOperations": {"REPORT": {"operationId": "reportDone", "responses": {"204": {}}}}
                    }
                  }
                },
                "responses": {"202": {}}
              }
            }
          },
          "webhooks": {"changed": {"query": {"operationId": "queryChange", "responses": {"200": {}}}}}
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["createJob"],
        "bindings": [{"operationKey": "createJob", "bindingSelector": "#/paths/~1jobs/post"}],
        "assertions": [
          {"path": "/operations/receiveDone/input/properties/id/type", "equals": "string"},
          {"path": "/operations/receiveDone/output/type", "equals": "string"},
          {"path": "/operations/reportDone", "equals": {}},
          {"path": "/operations/queryChange", "equals": {}}
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {"sourceIndex": 0, "sourceRef": "#/paths/~1jobs/post", "scope": "target", "status": "represented", "operationKey": "createJob", "bindingSelector": "#/paths/~1jobs/post", "requirements": []},
            {"sourceIndex": 0, "sourceRef": "#/paths/~1jobs/post/callbacks/done/{$request.body#~1url}/post", "scope": "dependency", "status": "represented", "requirements": []},
            {"sourceIndex": 0, "sourceRef": "#/paths/~1jobs/post/callbacks/done/{$request.body#~1url}/additionalOperations/REPORT", "scope": "dependency", "status": "represented", "requirements": []},
            {"sourceIndex": 0, "sourceRef": "#/webhooks/changed/query", "scope": "dependency", "status": "represented", "requirements": []}
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-08",
      "description": "The Bearer-only carriage exclusion is a statement about this specification's wire surface and not about any artifact declaration: an oauth2 alternative stays represented, reaches no coverage entry of its own, and leaves the source fully represented alongside its apiKey sibling.",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {"title": "Token carriage exclusion", "version": "1"},
          "servers": [{"url": "https://api.example"}],
          "components": {
            "securitySchemes": {
              "oauth": {"type": "oauth2", "flows": {"clientCredentials": {"tokenUrl": "https://api.example/token", "scopes": {"read": "read access"}}}},
              "key": {"type": "apiKey", "in": "header", "name": "X-Key"}
            }
          },
          "paths": {
            "/x": {
              "get": {
                "operationId": "readX",
                "security": [{"oauth": ["read"]}, {"key": []}],
                "responses": {"204": {"description": "ok"}}
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": ["readX"],
        "bindings": [{"operationKey": "readX", "bindingSelector": "#/paths/~1x/get"}],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {"sourceIndex": 0, "sourceRef": "#/paths/~1x/get", "scope": "target", "status": "represented", "operationKey": "readX", "bindingSelector": "#/paths/~1x/get", "requirements": ["configuration.security"]}
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-09",
      "description": "A request-body Schema Object whose `allOf` branches intersect emptily is a WELL-FORMED upstream declaration that admits no instance, and the JSON-lane position it governs is accounted `represented` with `fullyRepresented: true`. The governing dialect's validity condition for `allOf` is structural only — a non-empty array whose elements are valid schemas — and neither that dialect nor any accepted OAS edition gives satisfiability any role, so nothing about `allOf: [{type: string}, {type: object}]` is upstream-invalid; Core OBI-D-17 says the same from the other side, requiring no proof of satisfiability for a schema to be well-formed. §12.2 admits `invalid` only where the declaration is upstream-invalid, and §3.2 keeps `invalid` and `excluded` apart on exactly that line, so this position is neither: the emitted OBI carries the declaration as written, nothing is projected away, and coverage stays fully represented. The `application/json` lane is selected by media type rather than by the resolved declaration, which is why no admission test gates this position; the intersecting sibling is the control that keeps the scenario about the empty intersection rather than about `allOf`. Where the resolved declaration DOES select carriage — the character-data and raw-octet lanes, a multipart part, a urlencoded property — §9.1's stated no-admissible-candidate rule excludes the alternative instead, which is a different rule with a different status and is not asserted here.",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {
            "title": "Disjoint allOf",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://api.example/v1"
            }
          ],
          "paths": {
            "/disjoint": {
              "post": {
                "operationId": "disjointBody",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "allOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object"
                          }
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "204": {
                    "description": "stored"
                  }
                }
              }
            },
            "/intersecting": {
              "post": {
                "operationId": "intersectingBody",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "allOf": [
                          {
                            "type": "object"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "204": {
                    "description": "stored"
                  }
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "disjointBody",
          "intersectingBody"
        ],
        "bindings": [
          {
            "operationKey": "disjointBody",
            "bindingSelector": "#/paths/~1disjoint/post"
          },
          {
            "operationKey": "intersectingBody",
            "bindingSelector": "#/paths/~1intersecting/post"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1disjoint/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "disjointBody",
              "bindingSelector": "#/paths/~1disjoint/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1disjoint/post/requestBody/content/application~1json",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "disjointBody",
              "bindingSelector": "#/paths/~1disjoint/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1intersecting/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "intersectingBody",
              "bindingSelector": "#/paths/~1intersecting/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1intersecting/post/requestBody/content/application~1json",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "intersectingBody",
              "bindingSelector": "#/paths/~1intersecting/post",
              "requirements": []
            }
          ]
        }
      }
    }
  ]
