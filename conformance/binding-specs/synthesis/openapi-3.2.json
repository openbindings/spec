              "scope": "alternative",
              "status": "excluded",
              "reasonCode": "openapi.server_url_excluded",
              "rule": "OAPI32-P-04",
              "operationKey": "queryY",
              "bindingSelector": "#/paths/~1y/query",
              "requirements": []
            }
          ]
        }
      }
    }
