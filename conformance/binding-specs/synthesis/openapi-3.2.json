        "assertions": [
          {
            "path": "/operations/readValue/output/type",
            "equals": "string"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": false,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1x/get",
              "scope": "target",
              "status": "represented",
              "operationKey": "readValue",
              "bindingSelector": "#/paths/~1x/get",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1x/get/responses/200/content/application~1json",
              "scope": "alternative",
              "status": "excluded",
              "reasonCode": "openapi.response_media_excluded",
              "rule": "OAPI32-P-01",
              "requirements": []
            }
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-07",
      "description": "Callback and webhook Path Items expose fixed QUERY and case-exact additional operations as separate targetless dependencies; the callback runtime expression remains only a service-selected destination and no dependency acquires a binding-family constraint [OAPI32-S-01].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {
            "title": "Inbound dependency inventory",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://api.example"
            }
          ],
          "paths": {
            "/jobs": {
              "post": {
                "operationId": "createJob",
                "callbacks": {
                  "done": {
                    "{$request.body#/url}": {
                      "post": {
                        "operationId": "receiveDone",
                        "requestBody": {
                          "required": true,
                          "content": {
                            "application/json": {
                              "schema": {
                                "type": "object",
                                "required": [
                                  "id"
                                ],
                                "properties": {
                                  "id": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "responses": {
                          "200": {
                            "content": {
                              "application/json": {
                                "schema": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      },
                      "additionalOperations": {
                        "REPORT": {
                          "operationId": "reportDone",
                          "responses": {
                            "204": {}
                          }
                        }
                      }
                    }
                  }
                },
                "responses": {
                  "202": {}
                }
              }
            }
          },
          "webhooks": {
            "changed": {
              "query": {
                "operationId": "queryChange",
                "responses": {
                  "200": {}
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "createJob"
        ],
        "bindings": [
          {
            "operationKey": "createJob",
            "bindingSelector": "#/paths/~1jobs/post"
          }
        ],
        "assertions": [
          {
            "path": "/operations/receiveDone/input/properties/id/type",
            "equals": "string"
          },
          {
            "path": "/operations/receiveDone/output/type",
            "equals": "string"
          },
          {
            "path": "/operations/reportDone",
            "equals": {}
          },
          {
            "path": "/operations/queryChange",
            "equals": {}
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1jobs/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "createJob",
              "bindingSelector": "#/paths/~1jobs/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1jobs/post/callbacks/done/{$request.body#~1url}/post",
              "scope": "dependency",
              "status": "represented",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1jobs/post/callbacks/done/{$request.body#~1url}/additionalOperations/REPORT",
              "scope": "dependency",
              "status": "represented",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/webhooks/changed/query",
              "scope": "dependency",
              "status": "represented",
              "requirements": []
            }
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-08",
      "description": "The Bearer-only carriage exclusion is a statement about this specification's wire surface and not about any artifact declaration: an oauth2 alternative stays represented, reaches no coverage entry of its own, and leaves the source fully represented alongside its apiKey sibling.",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {
            "title": "Token carriage exclusion",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://api.example"
            }
          ],
          "components": {
            "securitySchemes": {
              "oauth": {
                "type": "oauth2",
                "flows": {
                  "clientCredentials": {
                    "tokenUrl": "https://api.example/token",
                    "scopes": {
                      "read": "read access"
                    }
                  }
                }
              },
              "key": {
                "type": "apiKey",
                "in": "header",
                "name": "X-Key"
              }
            }
          },
          "paths": {
            "/x": {
              "get": {
                "operationId": "readX",
                "security": [
                  {
                    "oauth": [
                      "read"
                    ]
                  },
                  {
                    "key": []
                  }
                ],
                "responses": {
                  "204": {
                    "description": "ok"
                  }
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "readX"
        ],
        "bindings": [
          {
            "operationKey": "readX",
            "bindingSelector": "#/paths/~1x/get"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1x/get",
              "scope": "target",
              "status": "represented",
              "operationKey": "readX",
              "bindingSelector": "#/paths/~1x/get",
              "requirements": [
                "configuration.security"
              ]
            }
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-09",
      "description": "§6.1's byte-exact key identity through the inventory: an additionalOperations key byte-equal to the token the post fixed field sends is excluded as its own entry, while the case-distinct post key spells a method no fixed field defines and is represented beside the fixed field itself. A key that resolves also enumerates, and the excluded one enumerates as a position carrying no operation [OAPI32-S-01, OAPI32-P-01].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {
            "title": "Byte-exact additional keys",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://api.example"
            }
          ],
          "paths": {
            "/t": {
              "post": {
                "operationId": "fixedPost",
                "responses": {
                  "204": {
                    "description": "ok"
                  }
                }
              },
              "additionalOperations": {
                "POST": {
                  "operationId": "collidingPost",
                  "responses": {
                    "204": {
                      "description": "ok"
                    }
                  }
                },
                "post": {
                  "operationId": "lowercasePost",
                  "responses": {
                    "204": {
                      "description": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "fixedPost",
          "lowercasePost"
        ],
        "bindings": [
          {
            "operationKey": "fixedPost",
            "bindingSelector": "#/paths/~1t/post"
          },
          {
            "operationKey": "lowercasePost",
            "bindingSelector": "#/paths/~1t/additionalOperations/post"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": false,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1t/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "fixedPost",
              "bindingSelector": "#/paths/~1t/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1t/additionalOperations/POST",
              "scope": "target",
              "status": "excluded",
              "reasonCode": "openapi.target_excluded",
              "rule": "OAPI32-P-01",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1t/additionalOperations/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "lowercasePost",
              "bindingSelector": "#/paths/~1t/additionalOperations/post",
              "requirements": []
            }
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-10",
      "description": "A request-body Schema Object whose `allOf` branches intersect emptily is a WELL-FORMED upstream declaration that admits no instance, and the JSON-lane position it governs is accounted `represented` with `fullyRepresented: true`. The governing dialect's validity condition for `allOf` is structural only — a non-empty array whose elements are valid schemas — and neither that dialect nor any accepted OAS edition gives satisfiability any role, so nothing about `allOf: [{type: string}, {type: object}]` is upstream-invalid; Core OBI-D-17 says the same from the other side, requiring no proof of satisfiability for a schema to be well-formed. §12.2 admits `invalid` only where the declaration is upstream-invalid, and §3.2 keeps `invalid` and `excluded` apart on exactly that line, so this position is neither: the emitted OBI carries the declaration as written, nothing is projected away, and coverage stays fully represented. The `application/json` lane is selected by media type rather than by the resolved declaration, which is why no admission test gates this position; the intersecting sibling is the control that keeps the scenario about the empty intersection rather than about `allOf`. Where the resolved declaration DOES select carriage — the character-data and raw-octet lanes, a multipart part, a urlencoded property — §9.1's stated no-admissible-candidate rule excludes the alternative instead, which is a different rule with a different status and is not asserted here.",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {
            "title": "Disjoint allOf",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://api.example/v1"
            }
          ],
          "paths": {
            "/disjoint": {
              "post": {
                "operationId": "disjointBody",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "allOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object"
                          }
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "204": {
                    "description": "stored"
                  }
                }
              }
            },
            "/intersecting": {
              "post": {
                "operationId": "intersectingBody",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "allOf": [
                          {
                            "type": "object"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "204": {
                    "description": "stored"
                  }
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "disjointBody",
          "intersectingBody"
        ],
        "bindings": [
          {
            "operationKey": "disjointBody",
            "bindingSelector": "#/paths/~1disjoint/post"
          },
          {
            "operationKey": "intersectingBody",
            "bindingSelector": "#/paths/~1intersecting/post"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1disjoint/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "disjointBody",
              "bindingSelector": "#/paths/~1disjoint/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1disjoint/post/requestBody/content/application~1json",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "disjointBody",
              "bindingSelector": "#/paths/~1disjoint/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1intersecting/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "intersectingBody",
              "bindingSelector": "#/paths/~1intersecting/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1intersecting/post/requestBody/content/application~1json",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "intersectingBody",
              "bindingSelector": "#/paths/~1intersecting/post",
              "requirements": []
            }
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-11",
      "description": "A content-form property or multipart part whose Schema Object `allOf` branches intersect emptily is a WELL-FORMED declaration that admits no instance, and it is an UNREACHABLE defect under Section 3.2's smallest-owner rule: no value can ever reach it, so it destroys neither its media alternative nor its target, both are accounted represented, and the declaration is carried into the synthesized contract as written. This is the same accounting both content-based lanes already apply to a boolean `false` property, of which the empty intersection is the resolved form; it is NOT the accounting for a property with no single faithful carriage (OAPI30-SS-35), where conforming values exist and the lane cannot carry them, nor the style lane's statically-refused member (OAPI30-SS-36), where every conforming value is refused — here there is no conforming value at all, and exclusion would remove a target on a defect nothing reaches. Three requestBody shapes are pinned so the accounting cannot depend on them: a required multipart body whose only alternative carries the property, the same alternative beside an application/json sibling, and an optional urlencoded body. The invoke half — a value supplied for the property refuses before dispatch at that part, Section 5.2's consequence — is pinned by the companion processor scenario on this line. This scenario exists because the two reference engines disagreed here (one excluded the target, one represented it) while agreeing on the boolean false, and the corpus was silent.",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {
            "title": "Unsatisfiable form properties",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://api.example"
            }
          ],
          "paths": {
            "/sole-required": {
              "post": {
                "operationId": "soleRequired",
                "requestBody": {
                  "content": {
                    "multipart/form-data": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "ok": {
                            "type": "string"
                          },
                          "bad": {
                            "allOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "object"
                              }
                            ]
                          }
                        }
                      }
                    }
                  },
                  "required": true
                },
                "responses": {
                  "200": {
                    "description": "ok"
                  }
                }
              }
            },
            "/with-json-sibling": {
              "post": {
                "operationId": "withJSONSibling",
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object"
                      }
                    },
                    "multipart/form-data": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "ok": {
                            "type": "string"
                          },
                          "bad": {
                            "allOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "object"
                              }
                            ]
                          }
                        }
                      }
                    }
                  },
                  "required": true
                },
                "responses": {
                  "200": {
                    "description": "ok"
                  }
                }
              }
            },
            "/optional-form": {
              "post": {
                "operationId": "optionalForm",
                "requestBody": {
                  "content": {
                    "application/x-www-form-urlencoded": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "ok": {
                            "type": "string"
                          },
                          "bad": {
                            "allOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "object"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "ok"
                  }
                }
              }
            },
            "/literal-false": {
              "post": {
                "operationId": "literalFalse",
                "requestBody": {
                  "content": {
                    "multipart/form-data": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "ok": {
                            "type": "string"
                          },
                          "impossible": false
                        }
                      }
                    }
                  },
                  "required": true
                },
                "responses": {
                  "200": {
                    "description": "ok"
                  }
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "literalFalse",
          "optionalForm",
          "soleRequired",
          "withJSONSibling"
        ],
        "bindings": [
          {
            "operationKey": "literalFalse",
            "bindingSelector": "#/paths/~1literal-false/post"
          },
          {
            "operationKey": "optionalForm",
            "bindingSelector": "#/paths/~1optional-form/post"
          },
          {
            "operationKey": "soleRequired",
            "bindingSelector": "#/paths/~1sole-required/post"
          },
          {
            "operationKey": "withJSONSibling",
            "bindingSelector": "#/paths/~1with-json-sibling/post"
          }
        ],
        "assertions": [
          {
            "path": "/operations/soleRequired/input/properties/bad",
            "equals": {
              "allOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          {
            "path": "/operations/optionalForm/input/properties/bad",
            "equals": {
              "allOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          {
            "path": "/operations/literalFalse/input/properties/impossible",
            "equals": false
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": true,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1sole-required/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "soleRequired",
              "bindingSelector": "#/paths/~1sole-required/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1sole-required/post/requestBody/content/multipart~1form-data",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "soleRequired",
              "bindingSelector": "#/paths/~1sole-required/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1with-json-sibling/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "withJSONSibling",
              "bindingSelector": "#/paths/~1with-json-sibling/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1with-json-sibling/post/requestBody/content/application~1json",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "withJSONSibling",
              "bindingSelector": "#/paths/~1with-json-sibling/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1with-json-sibling/post/requestBody/content/multipart~1form-data",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "withJSONSibling",
              "bindingSelector": "#/paths/~1with-json-sibling/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1optional-form/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "optionalForm",
              "bindingSelector": "#/paths/~1optional-form/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1optional-form/post/requestBody/content/application~1x-www-form-urlencoded",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "optionalForm",
              "bindingSelector": "#/paths/~1optional-form/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1literal-false/post",
              "scope": "target",
              "status": "represented",
              "operationKey": "literalFalse",
              "bindingSelector": "#/paths/~1literal-false/post",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1literal-false/post/requestBody/content/multipart~1form-data",
              "scope": "alternative",
              "status": "represented",
              "operationKey": "literalFalse",
              "bindingSelector": "#/paths/~1literal-false/post",
              "requirements": []
            }
          ]
        }
      }
    },
    {
      "id": "OAPI32-SS-12",
      "description": "The root-level servers array of OAPI32-SS-03 inherited by two operations: the malformed server member is confined to alternative coverage once per operation, because the inherited alternative is a distinct interaction unit at each operation whose omission would remove that operation's invocation path. Both entries name the same source unit #/servers/0 and differ only in the operation they are about; the valid sibling server preserves both represented targets [OAPI32-S-01, OAPI32-P-04].",
      "source": {
        "bindingSpec": "openbindings.openapi-3.2@1",
        "content": {
          "openapi": "3.2.0",
          "info": {
            "title": "Inherited alternative confinement",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://bad.example/base?fixed=1"
            },
            {
              "url": "https://safe.example"
            }
          ],
          "paths": {
            "/x": {
              "query": {
                "operationId": "queryX",
                "responses": {
                  "204": {
                    "description": "ok"
                  }
                }
              }
            },
            "/y": {
              "query": {
                "operationId": "queryY",
                "responses": {
                  "204": {
                    "description": "ok"
                  }
                }
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "synthesized",
        "operations": [
          "queryX",
          "queryY"
        ],
        "bindings": [
          {
            "operationKey": "queryX",
            "bindingSelector": "#/paths/~1x/query"
          },
          {
            "operationKey": "queryY",
            "bindingSelector": "#/paths/~1y/query"
          }
        ],
        "coverage": {
          "exhaustive": true,
          "fullyRepresented": false,
          "entries": [
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1x/query",
              "scope": "target",
              "status": "represented",
              "operationKey": "queryX",
              "bindingSelector": "#/paths/~1x/query",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/servers/0",
              "scope": "alternative",
              "status": "excluded",
              "reasonCode": "openapi.server_url_excluded",
              "rule": "OAPI32-P-04",
              "operationKey": "queryX",
              "bindingSelector": "#/paths/~1x/query",
              "requirements": []
            },
            {
              "sourceIndex": 0,
              "sourceRef": "#/paths/~1y/query",
              "scope": "target",
              "status": "represented",
              "operationKey": "queryY",
              "bindingSelector": "#/paths/~1y/query",
