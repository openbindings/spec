            "operation": "createTask",
            "source": "local",
            "data": 3
          },
          "createTask.boolean": {
            "operation": "createTask",
            "source": "local",
            "data": true
          },
          "createTask.null": {
            "operation": "createTask",
            "source": "local",
            "data": null
          }
        }
      },
      "valid": true
    },
