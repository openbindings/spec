          "createTask.string": {
            "operation": "createTask",
            "source": "local",
            "data": "tasks.create"
          },
          "createTask.object": {
            "operation": "createTask",
            "source": "local",
            "data": {
              "path": "/tasks",
              "method": "post"
            }
          },
          "createTask.array": {
            "operation": "createTask",
            "source": "local",
            "data": [
              "tasks",
              "create"
