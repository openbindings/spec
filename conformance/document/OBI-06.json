{
  "rule": "OBI-06",
  "section": "10",
  "description": "Has every bindings[*].operation value present as a key in the document's operations map.",
  "tests": [
    {
      "description": "binding references an existing operation key",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "bindings": {
          "createTask.http": {
            "operation": "createTask",
            "kind": "example.openapi@1"
          }
        }
      },
      "valid": true
    },
    {
      "description": "binding references a non-existent operation key",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "bindings": {
          "createTask.http": {
            "operation": "nonexistentOp",
            "kind": "example.openapi@1"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-06"
      ]
    },
    {
      "description": "binding references operation \"constructor\", a valid OBI-04 identifier that is also a built-in object property name, with no such operation defined (guards against an implementation resolving the reference through a language object's prototype chain rather than the document's own map)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "bindings": {
          "createTask.http": {
            "operation": "constructor",
            "kind": "example.openapi@1"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-06"
      ]
    },
    {
      "description": "binding operation value matches an alias rather than a key in the operations map",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "aliases": [
              "addTask"
            ]
          }
        },
        "bindings": {
          "addTask.http": {
            "operation": "addTask",
            "kind": "example.openapi@1"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-06"
      ]
    },
    {
      "description": "binding operation value differs from an operation key only in case: names are equal only as exact strings (section 5)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "bindings": {
          "createTask.http": {
            "operation": "createtask",
            "kind": "example.openapi@1"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-06"
      ]
    }
  ]
}
