{
  "rule": "OBI-07",
  "section": "10",
  "description": "Has every bindings[*].source value present as a key in the document's sources map.",
  "tests": [
    {
      "description": "binding references an existing source key",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "kind": "example.openapi@1"
          }
        },
        "bindings": {
          "createTask.http": {
            "operation": "createTask",
            "source": "httpApi"
          }
        }
      },
      "valid": true
    },
    {
      "description": "binding references source \"constructor\", a valid OBI-04 identifier that is also a built-in object property name, with no such source defined (guards against an implementation resolving the reference through a language object's prototype chain rather than the document's own map)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "kind": "example.openapi@1"
          }
        },
        "bindings": {
          "createTask.http": {
            "operation": "createTask",
            "source": "constructor"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-07"
      ]
    },
    {
      "description": "binding references a non-existent source key",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "kind": "example.openapi@1"
          }
        },
        "bindings": {
          "createTask.http": {
            "operation": "createTask",
            "source": "missingSource"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-07"
      ]
    },
    {
      "description": "binding references source HttpApi, which differs from the source key httpApi only in case",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "kind": "example.openapi@1"
          }
        },
        "bindings": {
          "createTask.http": {
            "operation": "createTask",
            "source": "HttpApi"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-07"
      ]
    }
  ]
}
