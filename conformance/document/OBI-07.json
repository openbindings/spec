{
  "rule": "OBI-07",
  "section": "10",
  "description": "Has every bindings[*].kind value a non-empty string, compared exactly as §6 defines (OBI-07, §10).",
  "tests": [
    {
      "description": "A binding carries its own non-empty kind (§5.3, OBI-07).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": "example.test@1"
          }
        }
      },
      "valid": true
    },
    {
      "description": "A missing binding kind violates the required field constraint of OBI-02 (§5.3); OBI-07 checks present values (§10).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "constructor": {
            "operation": "op"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-02"
      ],
      "notViolated": [
        "OBI-07"
      ]
    },
    {
      "description": "A numeric binding kind violates OBI-07 and OBI-02 (§5.3).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": 42
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-02",
        "OBI-07"
      ]
    },
    {
      "description": "An empty binding kind violates OBI-07 and OBI-02 (§5.3).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": ""
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-02",
        "OBI-07"
      ]
    },
    {
      "description": "A null kind is not a non-empty string (§5.3); OBI-02 overlaps.",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": null
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-02",
        "OBI-07"
      ]
    },
    {
      "description": "A false kind is not a non-empty string (§5.3); OBI-02 overlaps.",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": false
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-02",
        "OBI-07"
      ]
    },
    {
      "description": "A [] kind is not a non-empty string (§5.3); OBI-02 overlaps.",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": []
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-02",
        "OBI-07"
      ]
    },
    {
      "description": "A {} kind is not a non-empty string (§5.3); OBI-02 overlaps.",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": {}
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-02",
        "OBI-07"
      ]
    },
    {
      "description": "The non-empty kind \" \" is an opaque string, without a name grammar (§6).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": " "
          }
        }
      },
      "valid": true
    },
    {
      "description": "The non-empty kind \"constructor\" is an opaque string, without a name grammar (§6).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": "constructor"
          }
        }
      },
      "valid": true
    },
    {
      "description": "The non-empty kind \"https://EXAMPLE.test/kind@1\" is an opaque string, without a name grammar (§6).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "op": {}
        },
        "bindings": {
          "b": {
            "operation": "op",
            "kind": "https://EXAMPLE.test/kind@1"
          }
        }
      },
      "valid": true
    }
  ]
}
