{
  "rule": "OBI-12",
  "section": "10",
  "description": "Has every same-document schema $ref and $dynamicRef in the document resource identifying a schema at an OBI position (§7.3).",
  "notes": "# and an empty reference name the OBI document itself. Locations that hold no schema (operation objects, maps, strings, extension values, source content, example values) and locations inside a schema that declares $id are not schemas at OBI positions. A plain name qualifies only when a schema in the document's own resource declares it; a name declared only inside a schema that declares $id belongs to that resource. References within a schema resource that declares $id and absolute URIs are outside the rule; positives pin that.",
  "tests": [
    {
      "description": "a same-document pointer to a schemas entry",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a same-document pointer to another operation's input schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            }
          },
          "updateTask": {
            "input": {
              "$ref": "#/operations/createTask/input"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a same-document pointer to a subschema below a schemas entry",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "getId": {
            "output": {
              "$ref": "#/schemas/Task/properties/id"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a percent-encoded pointer reaches the same schema after decoding (#/schemas/T%61sk names Task)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/T%61sk"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a pointer may land on a schemas entry that declares $id",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object"
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a pointer to a boolean schema lands on a schema",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Anything": true
        },
        "operations": {
          "echo": {
            "input": {
              "$ref": "#/schemas/Anything"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a pointer into the legacy definitions keyword lands on a schema at an OBI position",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "definitions": {
              "Id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "getId": {
            "output": {
              "$ref": "#/schemas/Task/definitions/Id"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a recursive pointer back to its own schemas entry",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Node": {
            "type": "object",
            "properties": {
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/schemas/Node"
                }
              }
            }
          }
        },
        "operations": {
          "getTree": {
            "output": {
              "$ref": "#/schemas/Node"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "an absolute reference is outside this rule, even when its fragment is a JSON Pointer",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "f": {
            "input": {
              "$ref": "https://schemas.example.invalid/task.json#/properties/id"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a pointer within a schema resource that declares $id resolves against that resource and is outside this rule",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "parent": {
                "$ref": "#/$defs/missing"
              }
            }
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a plain name declared with $anchor by a schemas entry",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$anchor": "task",
            "type": "object"
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a plain name declared with $anchor below a schemas entry",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "id": {
                "$anchor": "taskId",
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "getTaskId": {
            "output": {
              "$ref": "#taskId"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a plain name declared by an operation's input schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "a": {
            "input": {
              "$anchor": "shared",
              "type": "string"
            }
          },
          "b": {
            "input": {
              "$ref": "#shared"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a $dynamicRef naming a plain name declared with $dynamicAnchor in the document's resource",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Node": {
            "$dynamicAnchor": "node",
            "type": "object",
            "properties": {
              "children": {
                "type": "array",
                "items": {
                  "$dynamicRef": "#node"
                }
              }
            }
          }
        },
        "operations": {
          "getTree": {
            "output": {
              "$ref": "#/schemas/Node"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a percent-encoded plain name matches the declared name after decoding (#t%61sk names task)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$anchor": "task",
            "type": "object"
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#t%61sk"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a pointer to a property whose name needs encoding is written percent-encoded and decoded once (#/schemas/Task/properties/my%20type)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "my type": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task/properties/my%20type"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a fragment is percent-decoded before it is classified, so an encoded leading slash makes a JSON Pointer (#%2Fschemas%2FTask names Task)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "my type": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#%2Fschemas%2FTask"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a schema value of the legacy dependencies keyword is at an OBI position",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "dependencies": {
              "a": {
                "type": "object"
              }
            }
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task/dependencies/a"
            }
          }
