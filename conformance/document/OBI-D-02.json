{
  "rule": "OBI-D-02",
  "section": "10.2",
  "description": "Validates against the JSON Schema at openbindings.schema.json.",
  "notes": "OBI-D-02 covers structural failures (missing required fields, wrong value types, malformed sub-objects) that the schema catches but no more specific OBI-D rule names. Violations the schema catches that DO have a specific semantic rule (e.g., OBI-D-03 identifier pattern, OBI-D-11 SemVer) are listed under the semantic rule, not OBI-D-02.",
  "tests": [
    {
      "description": "minimal valid document",
      "document": {
        "openbindings": "0.2.0",
        "operations": {}
      },
      "valid": true
    },
    {
      "description": "missing required `operations` field",
      "document": {
        "openbindings": "0.2.0"
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "missing required `openbindings` field",
      "document": {
        "operations": {}
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "operation aliases is a string instead of array",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "aliases": "create"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "binding missing required `operation` field",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": "example.openapi@1"
          }
        },
        "bindings": {
          "createTask.http": {
            "source": "httpApi"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "source missing required `bindingSpec` field",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "description": "Task API"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "source `bindingSpec` is an empty string (violates minLength: 1)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": ""
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "source with only `bindingSpec` (content is optional; whether a source needs it is its binding specification's to define)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": "example.openapi@1"
          }
        }
      },
      "valid": true
    },
    {
      "description": "source `content` is any JSON value, and `content: null` is a present member",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "objectContent": {
            "bindingSpec": "example.test@1",
            "content": {
              "location": "tasks.json"
            }
          },
          "stringContent": {
            "bindingSpec": "example.test@1",
            "content": "openapi: 3.1.0"
          },
          "arrayContent": {
            "bindingSpec": "example.test@1",
            "content": [
              1,
              "two",
              {
                "three": 3
              }
            ]
          },
          "numberContent": {
            "bindingSpec": "example.test@1",
            "content": 7
          },
          "booleanContent": {
            "bindingSpec": "example.test@1",
            "content": false
          },
          "nullContent": {
            "bindingSpec": "example.test@1",
            "content": null
          }
        }
      },
      "valid": true
    },
    {
      "description": "binding `content` is any JSON value, and `content: null` is a present member",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "s": {
            "bindingSpec": "example.test@1"
          }
        },
        "bindings": {
          "createTask.string": {
            "operation": "createTask",
            "source": "s",
            "content": "tasks.create"
          },
          "createTask.object": {
            "operation": "createTask",
            "source": "s",
            "content": {
              "path": "/tasks",
              "method": "post"
            }
          },
          "createTask.array": {
            "operation": "createTask",
            "source": "s",
            "content": [
              "tasks",
              "create"
            ]
          },
          "createTask.number": {
            "operation": "createTask",
            "source": "s",
            "content": 3
          },
          "createTask.boolean": {
            "operation": "createTask",
            "source": "s",
            "content": true
          },
          "createTask.null": {
            "operation": "createTask",
            "source": "s",
            "content": null
          }
        }
      },
      "valid": true
    },
    {
      "description": "operation deprecated flag is a string instead of boolean",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "deprecated": "yes"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency with one exact binding specification identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              "example.openapi@1"
            ]
          }
        }
      },
      "valid": true
    },
    {
      "description": "dependencies is an array instead of an object map",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "dependencies": []
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency entry is a string instead of an object",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": "deliverEvent"
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency missing required operation field",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "bindingSpecs": [
              "example.openapi@1"
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency operation is not a string",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": 42
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs is not an array",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": "example.openapi@1"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs is empty",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": []
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs contains a duplicate identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              "example.openapi@1",
              "example.openapi@1"
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs contains an empty identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              ""
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs contains a non-string identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              1
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "an operation member the specification does not define and that lacks the x- prefix (outpt beside input)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": {
              "type": "object"
            },
            "outpt": {
              "type": "object"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "a case variant of a defined member is not that member (Content on a binding)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "s": {
            "bindingSpec": "example.test@1"
          }
        },
        "bindings": {
          "b": {
            "operation": "createTask",
            "source": "s",
            "Content": "x"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "a 0.1 member left on a source (location)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "s": {
            "bindingSpec": "example.test@1",
            "location": "https://example.com/openapi.json"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "an undefined root member",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "info": {
          "title": "Tasks"
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "a member this version removed from the root (transforms)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "transforms": {
          "t": "$"
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "members this version removed from a binding (selector, inputTransform, outputTransform)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "s": {
            "bindingSpec": "example.test@1"
          }
        },
        "bindings": {
          "b.selector": {
            "operation": "createTask",
            "source": "s",
            "selector": "#/paths/~1tasks/post"
          },
          "b.input": {
            "operation": "createTask",
            "source": "s",
            "inputTransform": "$"
          },
          "b.output": {
            "operation": "createTask",
            "source": "s",
            "outputTransform": {
              "$ref": "#/transforms/t"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "x- members are extensions on every OBI-defined object, including examples and dependencies",
      "document": {
        "openbindings": "0.2.0",
        "x-owner": "tasks-team",
        "operations": {
          "createTask": {
            "x-note": 1,
            "examples": {
              "e": {
                "x-note": 1
              }
            }
          }
        },
        "dependencies": {
          "d": {
            "operation": "createTask",
            "x-note": 1
          }
        },
        "sources": {
          "s": {
            "bindingSpec": "example.test@1",
            "x-note": 1
          }
        },
        "bindings": {
          "b": {
            "operation": "createTask",
            "source": "s",
            "x-note": 1
          }
        }
      },
      "valid": true
    }
  ]
}
