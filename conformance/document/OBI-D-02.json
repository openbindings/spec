{
  "rule": "OBI-D-02",
  "section": "10.2",
  "description": "Validates against the JSON Schema at openbindings.schema.json.",
  "notes": "OBI-D-02 covers structural failures (missing required fields, wrong value types, malformed sub-objects) that the schema catches but no more specific OBI-D rule names. Violations the schema catches that DO have a specific semantic rule (e.g., OBI-D-03 identifier pattern, OBI-D-12 SemVer) are listed under the semantic rule, not OBI-D-02.",
  "tests": [
    {
      "description": "minimal valid document",
      "document": {
        "openbindings": "0.2.0",
        "operations": {}
      },
      "valid": true
    },
    {
      "description": "missing required `operations` field",
      "document": {
        "openbindings": "0.2.0"
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "missing required `openbindings` field",
      "document": {
        "operations": {}
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "operation aliases is a string instead of array",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "aliases": "create"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "binding missing required `operation` field",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": "openbindings.openapi-3.1@1"
          }
        },
        "bindings": {
          "createTask.http": {
            "source": "httpApi"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "source missing required `bindingSpec` field",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "description": "Task API"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "source `bindingSpec` is an empty string (violates minLength: 1)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": ""
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "source with only `bindingSpec` (content is optional; whether a source needs it is its binding specification's to define)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": "openbindings.openapi-3.1@1"
          }
        }
      },
      "valid": true
    },
    {
      "description": "source `content` is any JSON value, and `content: null` is a present member",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "objectContent": {
            "bindingSpec": "example.test@1",
            "content": {
              "location": "tasks.json"
            }
          },
          "stringContent": {
            "bindingSpec": "example.test@1",
            "content": "openapi: 3.1.0"
          },
          "arrayContent": {
            "bindingSpec": "example.test@1",
            "content": [
              1,
              "two",
              {
                "three": 3
              }
            ]
          },
          "numberContent": {
            "bindingSpec": "example.test@1",
            "content": 7
          },
          "booleanContent": {
            "bindingSpec": "example.test@1",
            "content": false
          },
          "nullContent": {
            "bindingSpec": "example.test@1",
            "content": null
          }
        }
      },
      "valid": true
    },
    {
      "description": "binding `selector` is any JSON value, and `selector: null` is a present member",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "s": {
            "bindingSpec": "example.test@1"
          }
        },
        "bindings": {
          "createTask.string": {
            "operation": "createTask",
            "source": "s",
            "selector": "tasks.create"
          },
          "createTask.object": {
            "operation": "createTask",
            "source": "s",
            "selector": {
              "path": "/tasks",
              "method": "post"
            }
          },
          "createTask.array": {
            "operation": "createTask",
            "source": "s",
            "selector": [
              "tasks",
              "create"
            ]
          },
          "createTask.number": {
            "operation": "createTask",
            "source": "s",
            "selector": 3
          },
          "createTask.boolean": {
            "operation": "createTask",
            "source": "s",
            "selector": true
          },
          "createTask.null": {
            "operation": "createTask",
            "source": "s",
            "selector": null
          }
        }
      },
      "valid": true
    },
    {
      "description": "operation deprecated flag is a string instead of boolean",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "deprecated": "yes"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency with one exact binding specification identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              "openbindings.openapi-3.1@1"
            ]
          }
        }
      },
      "valid": true
    },
    {
      "description": "dependencies is an array instead of an object map",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "dependencies": []
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency entry is a string instead of an object",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": "deliverEvent"
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency missing required operation field",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "bindingSpecs": [
              "openbindings.openapi-3.1@1"
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency operation is not a string",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": 42
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs is not an array",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": "openbindings.openapi-3.1@1"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs is empty",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": []
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs contains a duplicate identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              "openbindings.openapi-3.1@1",
              "openbindings.openapi-3.1@1"
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs contains an empty identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              ""
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs contains a non-string identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              1
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    }
  ]
}
