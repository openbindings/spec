{
  "rule": "OBI-D-02",
  "section": "10.2",
  "description": "Validates against the JSON Schema at openbindings.schema.json.",
  "notes": "OBI-D-02 covers structural failures (missing required fields, wrong value types, malformed sub-objects) that the schema catches but no more specific OBI-D rule names. Violations the schema catches that DO have a specific semantic rule (e.g., OBI-D-03 identifier pattern, OBI-D-12 SemVer) are listed under the semantic rule, not OBI-D-02.",
  "tests": [
    {
      "description": "minimal valid document",
      "document": {
        "openbindings": "0.2.0",
        "operations": {}
      },
      "valid": true
    },
    {
      "description": "missing required `operations` field",
      "document": {
        "openbindings": "0.2.0"
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "missing required `openbindings` field",
      "document": {
        "operations": {}
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "operation aliases is a string instead of array",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "aliases": "create"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "binding missing required `operation` field",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": "openbindings.openapi-3.1@1",
            "location": "https://api.example.com/openapi.json"
          }
        },
        "bindings": {
          "createTask.http": {
            "source": "httpApi"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "source missing required `bindingSpec` field",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "location": "https://api.example.com/openapi.json"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "source `bindingSpec` is an empty string (violates minLength: 1)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": "",
            "location": "https://api.example.com/openapi.json"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "source missing both `location` and `content`",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": "openbindings.openapi-3.1@1"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "operation deprecated flag is a string instead of boolean",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "deprecated": "yes"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency with one exact binding specification identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              "openbindings.openapi-3.1@1"
            ]
          }
        }
      },
      "valid": true
    },
    {
      "description": "dependencies is an array instead of an object map",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "dependencies": []
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency entry is a string instead of an object",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": "deliverEvent"
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency missing required operation field",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "bindingSpecs": [
              "openbindings.openapi-3.1@1"
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency operation is not a string",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": 42
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs is not an array",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": "openbindings.openapi-3.1@1"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs is empty",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": []
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs contains a duplicate identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              "openbindings.openapi-3.1@1",
              "openbindings.openapi-3.1@1"
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs contains an empty identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              ""
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    },
    {
      "description": "dependency bindingSpecs contains a non-string identifier",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "bindingSpecs": [
              1
            ]
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-02"
      ]
    }
  ]
}
