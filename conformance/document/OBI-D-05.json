{
  "rule": "OBI-D-05",
  "section": "10.2",
  "description": "Carries only absolute or same-document OBI-defined references: every schema $ref is a same-document fragment in JSON Pointer form (plain-name $anchor fragments are not used at OBI positions) or an absolute URI; every schema $id at an OBI position is absolute (a nested $id within a schema declaring its own $id resolves against that resource's base per 2020-12 and is resource-internal); every named-transform $ref in bindings[*].inputTransform/outputTransform is a same-document fragment. $dynamicRef and $dynamicAnchor do not appear at OBI positions (dynamic resolution follows the runtime dynamic scope rather than the document); within a schema declaring its own $id both are that resource's internal business, per the same scope rule as $ref/$anchor. URI-form references are well-formed per RFC 3986 §4.1. A source's content and a binding's selector are interpreted by the governing binding specification and are out of scope for this rule.",
  "notes": "Nothing within a source's content or a binding's selector is an OBI-defined reference, whatever its spelling: a relative address or a member named $ref there is the binding specification's to define and resolve, and the positives below pin that no core rule judges it.",
  "tests": [
    {
      "description": "a relative address inside a source's content is the binding specification's to define (out of D-05's scope)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": "example.test@1",
            "content": {
              "location": "openapi.json"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a member named $ref inside a source's content or a binding's selector is not a schema reference (out of D-05's scope)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "bindingSpec": "example.test@1",
            "content": {
              "$ref": "other.json#Task"
            }
          }
        },
        "bindings": {
          "createTask.http": {
            "operation": "createTask",
            "source": "httpApi",
            "selector": {
              "$ref": "#Task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "fragment-only $ref in inline schema",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "relative URI reference in schema $ref",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "output": {
              "$ref": "./schemas.json#/Task"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "URI containing a backtick in schema $ref",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "output": {
              "$ref": "#/schemas/`Task`"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "percent-encoded same-document fragment $ref is not in literal form (the target Task exists once the fragment is decoded, so the sole violation is the literal-form rule: same-document fragments are written with the pointer's characters unencoded)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/T%61sk"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "same-document JSON Pointer fragment $ref",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "plain-name ($anchor) fragment $ref is not JSON Pointer form",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$anchor": "task",
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "plain-name fragment inside an embedded $id-declaring schema is resource-internal (out of D-05's scope)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "#kindAnchor"
              }
            },
            "$defs": {
              "kind": {
                "$anchor": "kindAnchor",
                "type": "string"
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$dynamicRef at an OBI position (dynamic resolution follows the runtime dynamic scope, not the document)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$dynamicRef": "#node"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "$dynamicAnchor at an OBI position (a second named-schema mechanism competing with the schemas map, as $anchor would be)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$dynamicAnchor": "task",
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "dynamic pair inside an embedded $id-declaring schema is resource-internal (out of D-05's scope; full 2020-12 semantics, e.g. recursive extension)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Tree"
            }
          }
        },
        "schemas": {
          "Tree": {
            "$id": "https://example.com/tree.schema.json",
            "$dynamicAnchor": "node",
            "type": "object",
            "properties": {
              "children": {
                "type": "array",
                "items": {
                  "$dynamicRef": "#node"
                }
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a nested relative $id inside an embedded $id-declaring schema is resource-internal (resolves against the resource base per 2020-12; out of D-05's scope)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "$defs": {
              "kind": {
                "$id": "kind.schema.json",
                "type": "string"
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a property NAMED $dynamicRef under properties is data, not a keyword (keyword-position guard)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "type": "object",
              "properties": {
                "$dynamicRef": {
                  "type": "string"
                },
                "$dynamicAnchor": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "two schema resources declaring the same $id (JSON Schema 2020-12 lets a URI identify one schema)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/task",
            "type": "object"
          },
          "B": {
            "$id": "https://example.com/task",
            "type": "string"
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    }
  ]
}
