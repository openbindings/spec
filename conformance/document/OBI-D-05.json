{
  "rule": "OBI-D-05",
  "section": "10.2",
  "description": "Carries only absolute or same-document OBI-defined references and unambiguous schema identifiers: every schema $ref and $dynamicRef at an OBI position is an absolute URI or a same-document reference; every $id at an OBI position is absolute; no two embedded schema resources declare the same identifier (compared resolved, without fragment, after RFC 3986 syntax-based normalization), and none declares the identifier of a JSON Schema 2020-12 meta-schema; no schema resource, the document scope included, declares one plain name more than once; and every $ref, $dynamicRef, and $id in a schema the document contains is an RFC 3986 URI-reference.",
  "notes": "Nothing within a source's or binding's content is an OBI-defined reference, whatever its spelling: a relative address or a member named $ref there is the binding specification's to define and resolve, and the positives below pin that no core rule judges it.",
  "tests": [
    {
      "description": "a relative address inside a source's content is the binding specification's to define (out of D-05's scope)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "kind": "example.test@1",
            "content": {
              "location": "openapi.json"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a member named $ref inside a source's or binding's content is not a schema reference (out of D-05's scope)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "httpApi": {
            "kind": "example.test@1",
            "content": {
              "$ref": "other.json#Task"
            }
          }
        },
        "bindings": {
          "createTask.http": {
            "operation": "createTask",
            "source": "httpApi",
            "content": {
              "$ref": "#Task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "fragment-only $ref in inline schema",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "relative URI reference in schema $ref",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "output": {
              "$ref": "./schemas.json#/Task"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "URI containing a backtick in schema $ref",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "output": {
              "$ref": "#/schemas/`Task`"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "a percent-encoded same-document fragment identifies the same schema after URI-fragment decoding and JSON Pointer evaluation",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/T%61sk"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "same-document JSON Pointer fragment $ref",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "a same-document plain-name fragment at an OBI position names the schema in the document scope that declares it",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$anchor": "task",
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "a plain-name fragment inside an embedded $id-declaring schema resolves against that resource (the form constraints apply at OBI positions)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "#kindAnchor"
              }
            },
            "$defs": {
              "kind": {
                "$anchor": "kindAnchor",
                "type": "string"
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$dynamicRef at an OBI position whose initial target declares the $dynamicAnchor (JSON Schema 2020-12 dynamic resolution; the dynamic scope is fixed by the document, not by where it was obtained)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$dynamicRef": "#node"
            }
          }
        },
        "schemas": {
          "Node": {
            "$dynamicAnchor": "node",
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "$dynamicAnchor at an OBI position declares a plain name in the document scope",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$dynamicAnchor": "task",
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "dynamic pair inside an embedded $id-declaring schema resolves against that resource (full 2020-12 semantics, e.g. recursive extension)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/tree.schema.json"
            }
          }
        },
        "schemas": {
          "Tree": {
            "$id": "https://example.com/tree.schema.json",
            "$dynamicAnchor": "node",
            "type": "object",
            "properties": {
              "children": {
                "type": "array",
                "items": {
                  "$dynamicRef": "#node"
                }
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a nested relative $id inside an embedded $id-declaring schema resolves against the resource base per 2020-12 (the form constraints apply at OBI positions)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "$defs": {
              "kind": {
                "$id": "kind.schema.json",
                "type": "string"
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a property NAMED $dynamicRef under properties is data, not a keyword (keyword-position guard)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "type": "object",
              "properties": {
                "$dynamicRef": {
                  "type": "string"
                },
                "$dynamicAnchor": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "two schema resources declaring the same $id (JSON Schema 2020-12 lets a URI identify one schema)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/task",
            "type": "object"
          },
          "B": {
            "$id": "https://example.com/task",
            "type": "string"
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "an absolute-URI $ref with a plain-name fragment addresses an external schema and is allowed at an OBI position",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": {
              "$ref": "https://schemas.example.invalid/task.json#Task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a relative $ref on the schema object that declares an $id resolves against that $id: the declaring object's own keywords are resource-internal",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "$ref": "base.schema.json"
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a relative $dynamicRef at an OBI position would resolve against the retrieval URI",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTree": {
            "output": {
              "$dynamicRef": "tree.schema.json#node"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "two schemas in the document scope declare the same fragment name",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$anchor": "task",
            "type": "object"
          },
          "Draft": {
            "$anchor": "task",
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "one embedded resource declares a fragment name by both $anchor and $dynamicAnchor (JSON Schema 2020-12 leaves the effect undefined)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTree": {
            "output": {
              "$ref": "https://example.com/tree.schema.json"
            }
          }
        },
        "schemas": {
          "Tree": {
            "$id": "https://example.com/tree.schema.json",
            "type": "object",
            "$defs": {
              "a": {
                "$anchor": "node",
                "type": "object"
              },
              "b": {
                "$dynamicAnchor": "node",
                "type": "object"
              }
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "one fragment name declared in two different schema resources names two different schemas",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$anchor": "task",
            "type": "object"
          },
          "Remote": {
            "$id": "https://example.com/remote.schema.json",
            "$anchor": "task",
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "two embedded resources whose $id values differ only by an empty fragment declare the same identifier (JSON Schema 2020-12 treats the absolute form as canonical)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/t",
            "type": "string"
          },
          "B": {
            "$id": "https://example.com/t#",
            "type": "number"
          }
        },
        "operations": {
          "f": {
            "input": {
              "$ref": "https://example.com/t"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "two embedded resources whose $id values differ only by host case declare the same identifier after RFC 3986 syntax-based normalization",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/t",
            "type": "string"
          },
          "B": {
            "$id": "https://EXAMPLE.com/t",
            "type": "number"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "an embedded schema declares the identifier of the JSON Schema 2020-12 dialect meta-schema",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "M": {
            "$id": "https://json-schema.org/draft/2020-12/schema",
            "type": "string"
          }
        },
        "operations": {
          "f": {
            "input": {
              "$ref": "https://json-schema.org/draft/2020-12/schema"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "an embedded schema declares the identifier of a JSON Schema 2020-12 vocabulary meta-schema",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "M": {
            "$id": "https://json-schema.org/draft/2020-12/meta/core",
            "type": "object"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "a $ref inside an embedded resource that is not an RFC 3986 URI-reference",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "T": {
            "$id": "https://example.com/t",
            "type": "object",
            "properties": {
              "a": {
                "$ref": "a b.json"
              }
            }
          }
        },
        "operations": {
          "f": {
            "input": {
              "$ref": "https://example.com/t"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "an absolute $ref to an external schema carries whatever fragment its target defines",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "f": {
            "input": {
              "$ref": "https://schemas.example.invalid/task.json#1task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "an $id under the meta-schema path that names no JSON Schema 2020-12 meta-schema is an ordinary identifier",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "M": {
            "$id": "https://json-schema.org/draft/2020-12/meta/custom",
            "type": "object"
          }
        },
        "operations": {
          "f": {
            "input": {
              "$ref": "https://json-schema.org/draft/2020-12/meta/custom"
            }
          }
        }
      },
      "valid": true
    }
  ]
}
