{
  "rule": "OBI-D-07",
  "section": "10.2",
  "description": "Has $schema and $vocabulary only where JSON Schema 2020-12 permits them: $schema only on a root schema object (a schema at an OBI position that no other schema contains, or a schema that declares $id), and $vocabulary only on a root schema object that no other schema contains.",
  "notes": "JSON Schema 2020-12 section 8.1.1 bars $schema from schema objects that are not resource roots, and section 8.1.2 bars $vocabulary from subschemas; section 5.2 names the root schema objects of an OBI document. Where $vocabulary may appear it has no effect, since no schema in an OBI document is processed as a meta-schema. Placement is a prose rule: the derived JSON Schema does not enforce it. Walking is keyword-position aware: a property named $vocabulary or $schema under properties is schema content, not the keyword.",
  "tests": [
    {
      "description": "schemas with neither $schema nor $vocabulary",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": true
    },
    {
      "description": "$vocabulary on a schemas entry, a root schema object no other schema contains (it has no effect outside a meta-schema)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$vocabulary": {
              "https://json-schema.org/draft/2020-12/vocab/core": true
            },
            "type": "object"
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": true
    },
    {
      "description": "$vocabulary on an operation input schema, a root schema object no other schema contains",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": {
              "$vocabulary": {
                "https://json-schema.org/draft/2020-12/vocab/core": true
              },
              "type": "object"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$vocabulary in a nested property subschema",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "metadata": {
                "$vocabulary": {
                  "https://json-schema.org/draft/2020-12/vocab/core": true
                },
                "type": "object"
              }
            }
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-07"
      ]
    },
    {
      "description": "$vocabulary in a $defs subschema",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "$defs": {
              "Inner": {
                "$vocabulary": {
                  "https://json-schema.org/draft/2020-12/vocab/core": true
                },
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-07"
      ]
    },
    {
      "description": "$vocabulary on a nested schema that declares $id is still in a subschema",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "$defs": {
              "Inner": {
                "$id": "https://example.com/inner.schema.json",
                "$vocabulary": {
                  "https://json-schema.org/draft/2020-12/vocab/core": true
                },
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-07"
      ]
    },
    {
      "description": "$schema on a schemas entry and on an operation input schema, root schema objects",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$schema on a nested schema that declares $id, the root of an embedded schema resource",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "$defs": {
              "Inner": {
                "$id": "https://example.com/inner.schema.json",
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": true
    },
    {
      "description": "$schema on a nested property subschema that declares no $id",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "id": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-07"
      ]
    },
    {
      "description": "$schema in a $defs entry that declares no $id",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "$defs": {
              "Inner": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-07"
      ]
    },
    {
      "description": "a property NAMED $vocabulary or $schema under `properties` is schema content, not the keyword (keyword-position-aware walking; a grep-style walker false-positives here)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getMeta": {
            "output": {
              "type": "object",
              "properties": {
                "$vocabulary": {
                  "type": "object"
                },
                "$schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "valid": true
    }
  ]
}
