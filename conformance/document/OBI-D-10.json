{
  "rule": "OBI-D-10",
  "section": "10.2",
  "description": "Each provided example value satisfies its operation's corresponding schema when every schema reachable from that schema is embedded in the OBI. Reachability is static: a branch counts whether or not the example would take it, containment alone (an unreferenced $defs entry) does not make a schema reachable, and a $dynamicRef whose initial target declares the $dynamicAnchor reaches every same-named $dynamicAnchor in a schema resource holding a reachable schema. Regular expressions are read as ECMA-262 with the u flag.",
  "tests": [
    {
      "description": "example input validates against specified input schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": {
              "type": "object",
              "properties": { "title": { "type": "string" } },
              "required": ["title"]
            },
            "examples": {
              "happy": { "input": { "title": "Buy milk" } }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "example output validates against specified output schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "output": {
              "type": "object",
              "properties": { "id": { "type": "string" } },
              "required": ["id"]
            },
            "examples": {
              "happy": { "output": { "id": "abc123" } }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "example with neither input nor output present (no validation required)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": { "type": "object" },
            "output": { "type": "object" },
            "examples": {
              "minimal": { "description": "purely descriptive example" }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "example input present but operation input schema unspecified (no validation required)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "examples": {
              "raw": { "input": { "anything": "goes" } }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "example input violates required field of operation input schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": {
              "type": "object",
              "properties": { "title": { "type": "string" } },
              "required": ["title"]
            },
            "examples": {
              "broken": { "input": {} }
            }
          }
        }
      },
      "valid": false,
      "violates": ["OBI-D-10"]
    },
    {
      "description": "example output type does not match operation output schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "output": {
              "type": "object",
              "properties": { "id": { "type": "string" } },
              "required": ["id"]
            },
            "examples": {
              "broken": { "output": { "id": 123 } }
            }
          }
        }
      },
      "valid": false,
      "violates": ["OBI-D-10"]
    },
    {
      "description": "example input wrong type for operation input schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": {
              "type": "object",
              "properties": { "title": { "type": "string" } }
            },
            "examples": {
              "broken": { "input": { "title": 42 } }
            }
          }
        }
      },
      "valid": false,
      "violates": ["OBI-D-10"]
    },
    {
      "description": "example input matches operation input schema reached via $ref into the schemas map",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "TaskInput": {
            "type": "object",
            "properties": { "title": { "type": "string" } },
            "required": ["title"]
          }
        },
        "operations": {
          "createTask": {
            "input": { "$ref": "#/schemas/TaskInput" },
            "examples": {
              "happy": { "input": { "title": "Buy milk" } }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "example output matches operation output schema reached via $ref into the schemas map",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": { "id": { "type": "string" } },
            "required": ["id"]
          }
        },
        "operations": {
          "createTask": {
            "output": { "$ref": "#/schemas/Task" },
            "examples": {
              "happy": { "output": { "id": "abc123" } }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "example input violates required field of operation input schema reached via $ref",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "TaskInput": {
            "type": "object",
            "properties": { "title": { "type": "string" } },
            "required": ["title"]
          }
        },
        "operations": {
          "createTask": {
            "input": { "$ref": "#/schemas/TaskInput" },
            "examples": {
              "broken": { "input": {} }
            }
          }
        }
      },
      "valid": false,
      "violates": ["OBI-D-10"]
    },
    {
      "description": "example output type does not match operation output schema reached via $ref",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": { "id": { "type": "string" } },
            "required": ["id"]
          }
        },
        "operations": {
          "createTask": {
            "output": { "$ref": "#/schemas/Task" },
            "examples": {
              "broken": { "output": { "id": 123 } }
            }
          }
        }
      },
      "valid": false,
      "violates": ["OBI-D-10"]
    },
    {
      "description": "an example value that breaks a format constraint still validates: format is an annotation under the validation semantics of section 5.2",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createUser": {
            "input": {
              "type": "object",
              "properties": { "email": { "type": "string", "format": "email" } }
            },
            "examples": {
              "loose": { "input": { "email": "not-an-email" } }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "an unused $defs entry with an external reference does not exempt a mismatched example from document conformance",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "echo": {
            "output": {
              "type": "string",
              "$defs": {
                "unused": { "$ref": "https://schemas.example.invalid/unused.json" }
              }
            },
            "examples": {
              "broken": { "output": 42 }
            }
          }
        }
      },
      "valid": false,
      "violates": ["OBI-D-10"]
    },
    {
      "description": "an external schema in a branch the example would not take is still reachable, so the example is outside the rule",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "echo": {
            "output": {
              "if": { "const": "needs-external" },
              "then": { "$ref": "https://schemas.example.invalid/missing.json" },
              "else": { "type": "string" }
            },
            "examples": {
              "broken": { "output": 42 }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "an external allOf branch is reachable, so the example is outside the rule even though embedded false alone would decide it",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "echo": {
            "output": {
              "allOf": [false, { "$ref": "https://schemas.example.invalid/missing.json" }]
            },
            "examples": {
              "broken": { "output": "any value" }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "an external schema reached transitively through the schemas map places the example outside the rule",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Wrapper": {
            "type": "object",
            "properties": { "detail": { "$ref": "https://schemas.example.invalid/detail.json" } }
          }
        },
        "operations": {
          "echo": {
            "output": { "$ref": "#/schemas/Wrapper" },
            "examples": {
              "broken": { "output": 42 }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a $dynamicRef selects the outermost same-named $dynamicAnchor in its dynamic scope, so numbers validate against the extending resource's item schema",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "List": {
            "$id": "https://example.com/list.schema.json",
            "type": "array",
            "items": { "$dynamicRef": "#item" },
            "$defs": { "item": { "$dynamicAnchor": "item", "type": "string" } }
          },
          "NumberList": {
            "$id": "https://example.com/number-list.schema.json",
            "$ref": "list.schema.json",
            "$defs": { "item": { "$dynamicAnchor": "item", "type": "number" } }
          }
        },
        "operations": {
          "sum": {
            "input": { "$ref": "https://example.com/number-list.schema.json" },
            "examples": {
              "numbers": { "input": [1, 2] }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a value the dynamically selected item schema rejects violates the rule when every candidate $dynamicAnchor is embedded",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "List": {
            "$id": "https://example.com/list.schema.json",
            "type": "array",
            "items": { "$dynamicRef": "#item" },
            "$defs": { "item": { "$dynamicAnchor": "item", "type": "string" } }
          },
          "NumberList": {
            "$id": "https://example.com/number-list.schema.json",
            "$ref": "list.schema.json",
            "$defs": { "item": { "$dynamicAnchor": "item", "type": "number" } }
          }
        },
        "operations": {
          "sum": {
            "input": { "$ref": "https://example.com/number-list.schema.json" },
            "examples": {
              "strings": { "input": ["a"] }
            }
          }
        }
      },
      "valid": false,
      "violates": ["OBI-D-10"]
    },
    {
      "description": "a $dynamicRef reaches every same-named $dynamicAnchor in a resource holding a reachable schema, so an external schema reached that way places the example outside the rule",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "List": {
            "$id": "https://example.com/list.schema.json",
            "type": "array",
            "items": { "$dynamicRef": "#item" },
            "$defs": { "item": { "$dynamicAnchor": "item", "type": "string" } }
          },
          "NumberList": {
            "$id": "https://example.com/number-list.schema.json",
            "$ref": "list.schema.json",
            "$defs": {
              "item": { "$dynamicAnchor": "item", "$ref": "https://schemas.example.invalid/number.json" }
            }
          }
        },
        "operations": {
          "sum": {
            "input": { "$ref": "https://example.com/number-list.schema.json" },
            "examples": {
              "numbers": { "input": [1, 2] }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "patterns are read as ECMA-262 with the u flag, where \\d matches only ASCII digits, so a non-ASCII digit fails",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "f": {
            "input": {
              "type": "string",
              "pattern": "^\\d$"
            },
            "examples": {
              "e": {
                "input": "٣"
              }
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-10"
      ]
    },
    {
      "description": "under the u flag, . matches one character outside the Basic Multilingual Plane",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "f": {
            "input": {
              "type": "string",
              "pattern": "^.$"
            },
            "examples": {
              "e": {
                "input": "😀"
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a reference that matches an embedded $id after RFC 3986 normalization reaches that schema, so the example is inside the rule",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "T": {
            "$id": "https://example.com/t",
            "type": "string"
          }
        },
        "operations": {
          "f": {
            "input": {
              "$ref": "https://EXAMPLE.com/t"
            },
            "examples": {
              "e": {
                "input": 5
              }
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-10"
      ]
    }
  ]
}
