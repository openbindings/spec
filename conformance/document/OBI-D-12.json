{
  "rule": "OBI-D-12",
  "section": "10.2",
  "description": "Has every schema reference whose target lies within the document resolving to a schema: every $ref, and the initial target of every $dynamicRef, in any schema the document contains, including within an embedded resource that declares its own $id. A JSON Pointer fragment reaches a schema of the resource it addresses and never lands on or passes through a schema that declares $id other than the root it is read from; a plain name reaches the schema that declares it in the addressed resource. A reference whose target is external is out of scope.",
  "tests": [
    {
      "description": "percent-encoded fragment #/schemas/T%61sk resolves to the schemas key Task",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/T%61sk"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "same-document $ref resolving to a schemas-map entry",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "bare # resolves to the OBI document, which is not a schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "echoDoc": {
            "output": {
              "$ref": "#"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "dangling same-document $ref (missing schemas entry)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Missing"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "dangling nested subschema $ref",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "listTasks": {
            "output": {
              "type": "array",
              "items": {
                "$ref": "#/schemas/Nope"
              }
            }
          }
        },
        "schemas": {}
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a $ref inside an embedded $id resource resolves against that resource's base to a subschema of it",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "parent": {
                "$ref": "#/$defs/base"
              }
            },
            "$defs": {
              "base": {
                "type": "string"
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "external absolute $ref is not this rule's concern",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/schemas/task.json"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$ref-shaped DATA under `const` is an instance value, not a reference (keyword-position-aware walking; a naive walker would flag the dangling-looking pointer)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getDefault": {
            "output": {
              "type": "object",
              "properties": {
                "link": {
                  "const": {
                    "$ref": "#/schemas/Missing"
                  }
                }
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$ref to a string elsewhere in the document is not a schema",
      "document": {
        "openbindings": "0.2.0",
        "name": "Task Manager",
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/name"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "$ref into x- data resolves to no schema place, even when the value there is schema-shaped",
      "document": {
        "openbindings": "0.2.0",
        "x-shapes": {
          "Task": {
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/x-shapes/Task"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "$ref into a source's content resolves to no schema place: content is the binding specification's",
      "document": {
        "openbindings": "0.2.0",
        "sources": {
          "api": {
            "kind": "example.test@1",
            "content": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/sources/api/content/schema"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "$ref into a legacy definitions entry resolves to no schema place",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "definitions": {
              "Id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/schemas/Task/definitions/Id"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "$ref to another operation's input schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": {
              "type": "object"
            }
          },
          "updateTask": {
            "input": {
              "$ref": "#/operations/createTask/input"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$ref to a subschema below a schemas entry",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/schemas/Task/properties/id"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a same-document pointer may not land on a schemas entry that declares its own $id: that schema is reached through its $id",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task",
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/schemas/Task"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a same-document pointer into a schema resource that declares its own $id",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task",
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/schemas/Task/properties/id"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "an absolute $ref through an embedded resource's $id to a subschema inside it",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task",
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "https://example.com/task#/properties/id"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a dangling JSON Pointer $ref inside an embedded $id resource",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "parent": {
                "$ref": "#/$defs/missing"
              }
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a relative $ref inside an embedded resource resolves to another embedded resource through its $id",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "owner": {
                "$ref": "user.schema.json"
              }
            }
          },
          "User": {
            "$id": "https://example.com/user.schema.json",
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "a relative $ref inside an embedded resource matches another embedded resource's $id, but its fragment reaches nothing",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "owner": {
                "$ref": "user.schema.json#/$defs/missing"
              }
            }
          },
          "User": {
            "$id": "https://example.com/user.schema.json",
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a relative $ref inside an embedded resource that matches no embedded $id is external and out of scope",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "owner": {
                "$ref": "user.schema.json"
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "an absolute $ref matching an embedded resource's $id whose fragment reaches nothing",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task",
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "https://example.com/task#/properties/missing"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a same-document plain name at an OBI position reaches the schema in the document scope that declares it",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$anchor": "task",
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "a same-document plain name that no schema in the document scope declares",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#task"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a same-document plain name declared only by a schema that declares its own $id belongs to that resource, not the document scope",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "$anchor": "task",
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a plain name inside an embedded resource naming an anchor that only the document scope declares",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "#kind"
              }
            }
          },
          "Kind": {
            "$anchor": "kind",
            "type": "string"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a JSON Pointer inside an embedded resource may not land on a nested schema that declares $id",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "x": {
                "$ref": "#/$defs/Inner"
              }
            },
            "$defs": {
              "Inner": {
                "$id": "https://example.com/inner.schema.json",
                "type": "string"
              }
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a JSON Pointer inside an embedded resource may not pass into a nested resource that declares $id",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/task.schema.json"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "x": {
                "$ref": "#/$defs/Inner/$defs/Leaf"
              }
            },
            "$defs": {
              "Inner": {
                "$id": "https://example.com/inner.schema.json",
                "$defs": {
                  "Leaf": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a $dynamicRef at an OBI position whose initial target resolves to nothing",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTree": {
            "output": {
              "$dynamicRef": "#node"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a schemas entry that declares $id is referenced through that $id",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task",
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "https://example.com/task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a same-document plain name that no schema declares resolves to nothing, whatever its spelling",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#1task"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "an empty $ref at an OBI position is a same-document reference to the OBI document, which is not a schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "f": {
            "input": {
              "$ref": ""
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "a plain name is compared after percent-decoding, so #%74ask reaches the schema declaring task",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$anchor": "task",
            "type": "object"
          }
        },
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#%74ask"
            }
          }
        }
      },
      "valid": true
    }
  ],
  "notes": "JSON Schema 2020-12 leaves a reference to anything that is not a schema undefined (section 9.4.2), so the OBI document root, x- data, a source's content, and legacy definitions entries are not reference targets. It advises against JSON Pointers that identify an embedded resource or locations within it and lets an implementation decline them (section 9.2.1), and OpenAPI 3.2 requires such schemas to be referenced through their nearest $id, so a pointer that lands on or passes through a schema declaring $id, other than the root it is read from, violates this rule. Within an embedded resource, references resolve against that resource's base as JSON Schema 2020-12 defines, and those whose targets lie within the document must resolve, as standard JSON Schema libraries require when they compile the resource."
}
