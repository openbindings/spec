{
  "rule": "OBI-D-12",
  "section": "10.2",
  "description": "Every schema $ref at an OBI position that resolves within the document resolves to a schema the document model places: a same-document fragment, read from the OBI document root, to a schema at an OBI position, and so never into a resource that declares its own $id; an absolute-URI $ref that matches an embedded schema's $id, to that schema or a subschema JSON Schema 2020-12 defines below it. Same-document fragments are in literal form (section 7): the pointer's characters are written unencoded and evaluated as an RFC 6901 pointer directly. A $ref within a schema declaring its own $id is out of scope, as is an absolute-URI $ref that matches no embedded schema's $id.",
  "tests": [
    {
      "description": "percent-encoded fragment is not in literal form: #/schemas/T%61sk is rejected at OBI-D-05 (it is not decoded and resolved to the schemas key Task)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/T%61sk"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-05"
      ]
    },
    {
      "description": "same-document $ref resolving to a schemas-map entry",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": true
    },
    {
      "description": "bare # resolves to the OBI document, which is not a schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "echoDoc": {
            "output": {
              "$ref": "#"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "dangling same-document $ref (missing schemas entry)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Missing"
            }
          }
        },
        "schemas": {
          "Task": {
            "type": "object"
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "dangling nested subschema $ref",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "listTasks": {
            "output": {
              "type": "array",
              "items": {
                "$ref": "#/schemas/Nope"
              }
            }
          }
        },
        "schemas": {}
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "$ref under a nested $id is out of scope (resource-internal)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "#/schemas/Task"
            }
          }
        },
        "schemas": {
          "Task": {
            "$id": "https://example.com/task.schema.json",
            "type": "object",
            "properties": {
              "parent": {
                "$ref": "#/$defs/base"
              }
            },
            "$defs": {
              "base": {
                "type": "string"
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "external absolute $ref is not this rule's concern",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getTask": {
            "output": {
              "$ref": "https://example.com/schemas/task.json"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$ref-shaped DATA under `const` is an instance value, not a reference (keyword-position-aware walking; a naive walker would flag the dangling-looking pointer)",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getDefault": {
            "output": {
              "type": "object",
              "properties": {
                "link": {
                  "const": {
                    "$ref": "#/schemas/Missing"
                  }
                }
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$ref to a string elsewhere in the document is not a schema",
      "document": {
        "openbindings": "0.2.0",
        "name": "Task Manager",
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/name"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "$ref into x- data resolves to no schema place, even when the value there is schema-shaped",
      "document": {
        "openbindings": "0.2.0",
        "x-shapes": {
          "Task": {
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/x-shapes/Task"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "$ref into a source's content resolves to no schema place: content is the binding specification's",
      "document": {
        "openbindings": "0.2.0",
        "sources": {
          "api": {
            "kind": "example.test@1",
            "content": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/sources/api/content/schema"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "$ref into a legacy definitions entry resolves to no schema place",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "definitions": {
              "Id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/schemas/Task/definitions/Id"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "$ref to another operation's input schema",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {
            "input": {
              "type": "object"
            }
          },
          "updateTask": {
            "input": {
              "$ref": "#/operations/createTask/input"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "$ref to a subschema below a schemas entry",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/schemas/Task/properties/id"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a same-document fragment to a schemas entry that declares its own $id names it through the schemas map",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task",
            "type": "object"
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/schemas/Task"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "a same-document fragment into a schema resource that declares its own $id",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task",
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "#/schemas/Task/properties/id"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-12"
      ]
    },
    {
      "description": "an absolute $ref through an embedded resource's $id to a subschema inside it",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Task": {
            "$id": "https://example.com/task",
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "createTask": {
            "input": {
              "$ref": "https://example.com/task#/properties/id"
            }
          }
        }
      },
      "valid": true
    }
  ],
  "notes": "JSON Schema 2020-12 leaves a reference to anything that is not a schema undefined (section 9.4.2) and advises against JSON Pointers into an embedded resource (section 9.2.1), so the OBI document root, x- data, a source's content, legacy definitions entries, and locations inside a resource declaring its own $id are not same-document targets; a resource's contents are reached through its $id."
}
