{
  "rule": "OBI-D-13",
  "section": "10.2",
  "description": "Has no plain name declared more than once in the document resource, each $anchor and each $dynamicAnchor that declares it counting once (JSON Schema Core §8.2.2), and no $id declared by two schemas the document contains, each $id resolved to an absolute URI per RFC 3986 §5.2, which removes dot segments, with any empty fragment removed, and compared character for character. An $id is compared only when it is a well-formed URI-reference that is either an absolute URI or resolves against the $id of the nearest enclosing schema that declares one, itself compared; every other $id is left out of the comparison.",
  "notes": "The schemas at OBI positions that declare no $id share the document's resource (section 7.2), so a plain name declared in two schemas entries collides there, where separate schema files would not. A plain name inside a schema that declares $id belongs to that schema's resource. $id values are compared as strings after resolution, so spellings a URI library might normalize to one identifier are distinct here. A name counts once per declaring keyword, so one schema that declares a name with both $anchor and $dynamicAnchor declares it twice, as JSON Schema Core §8.2.2 treats it. A malformed nested $id has no resolved value to compare, so repeating one is not a collision under this rule; JSON Schema governs it when the schema is used.",
  "tests": [
    {
      "description": "distinct plain names in the document's resource",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$anchor": "a",
            "type": "string"
          },
          "B": {
            "$anchor": "b",
            "type": "number"
          }
        },
        "operations": {
          "f": {
            "input": {
              "$ref": "#a"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "the same plain name in the document's resource and inside a schema that declares $id belongs to two resources",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$anchor": "node",
            "type": "string"
          },
          "B": {
            "$id": "https://example.com/b.json",
            "$defs": {
              "n": {
                "$anchor": "node",
                "type": "number"
              }
            }
          }
        },
        "operations": {
          "f": {
            "input": {
              "$ref": "#node"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "the same plain name inside two schemas that each declare $id belongs to two resources",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/a.json",
            "$anchor": "node"
          },
          "B": {
            "$id": "https://example.com/b.json",
            "$anchor": "node"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": true
    },
    {
      "description": "distinct $id values",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/a.json"
          },
          "B": {
            "$id": "https://example.com/b.json"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": true
    },
    {
      "description": "$id values that differ in host case are different strings under this rule",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/t"
          },
          "B": {
            "$id": "https://EXAMPLE.com/t"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": true
    },
    {
      "description": "a nested $id that is not a well-formed URI-reference is left out of the comparison, so repeating it is no collision",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/a.json",
            "$defs": {
              "x": {
                "$id": "bad id"
              },
              "y": {
                "$id": "bad id"
              }
            }
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": true
    },
    {
      "description": "one schema that declares the same name with both $anchor and $dynamicAnchor declares it twice",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "Node": {
            "$anchor": "node",
            "$dynamicAnchor": "node",
            "type": "object"
          }
        },
        "operations": {
          "f": {
            "input": {
              "$ref": "#node"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-13"
      ]
    },
    {
      "description": "two schemas entries declare the same plain name in the document's resource",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$anchor": "node",
            "type": "string"
          },
          "B": {
            "$anchor": "node",
            "type": "number"
          }
        },
        "operations": {
          "f": {
            "output": {
              "$ref": "#node"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-13"
      ]
    },
    {
      "description": "one name declared by $anchor and by $dynamicAnchor in the document's resource",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$anchor": "node"
          },
          "B": {
            "$dynamicAnchor": "node"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-13"
      ]
    },
    {
      "description": "an operation input and a schemas entry declare the same plain name",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$anchor": "item",
            "type": "string"
          }
        },
        "operations": {
          "f": {
            "input": {
              "$anchor": "item",
              "type": "number"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-13"
      ]
    },
    {
      "description": "two schemas entries declare the same $id",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/t",
            "type": "string"
          },
          "B": {
            "$id": "https://example.com/t",
            "type": "number"
          }
        },
        "operations": {
          "f": {
            "input": {
              "$ref": "https://example.com/t"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-13"
      ]
    },
    {
      "description": "$id values that differ only by an empty fragment are the same identifier",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/t"
          },
          "B": {
            "$id": "https://example.com/t#"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-13"
      ]
    },
    {
      "description": "a nested relative $id resolves to the same identifier as another schema's $id",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/a.json",
            "$defs": {
              "x": {
                "$id": "b.json"
              }
            }
          },
          "B": {
            "$id": "https://example.com/b.json"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-13"
      ]
    },
    {
      "description": "absolute $id values that differ only by dot segments resolve to the same identifier",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/x/../b.json"
          },
          "B": {
            "$id": "https://example.com/b.json"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-13"
      ]
    },
    {
      "description": "an object at a schema position is a schema even when the meta-schemas reject it, so its $anchor counts and duplicates another entry's (section 7)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "type": 42,
            "$anchor": "node"
          },
          "B": {
            "$anchor": "node",
            "type": "string"
          }
        },
        "operations": {
          "op": {
            "input": {
              "$ref": "#/schemas/B"
            }
          }
        }
      },
      "valid": false,
      "violates": [
        "OBI-D-10",
        "OBI-D-13"
      ]
    },
    {
      "description": "$id values that differ only in percent-encoding are different strings under this rule, which removes dot segments and an empty fragment and nothing else",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "A": {
            "$id": "https://example.com/task.json"
          },
          "B": {
            "$id": "https://example.com/t%61sk.json"
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": true
    },
    {
      "description": "a plain name declared twice within one schema resource that declares $id is outside this rule, which counts declarations in the document resource; the result is undefined, but the document conforms (section 7.4)",
      "document": {
        "openbindings": "0.2.0",
        "schemas": {
          "R": {
            "$id": "https://example.com/r.json",
            "$defs": {
              "a": {
                "$anchor": "node"
              },
              "b": {
                "$anchor": "node"
              }
            }
          }
        },
        "operations": {
          "f": {}
        }
      },
      "valid": true
    }
  ]
}
