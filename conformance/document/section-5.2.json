{
  "section": "5.2",
  "description": "A source's data is arbitrary JSON that this specification never reads as schemas (§5.2).",
  "tests": [
    {
      "description": "This specification never reads schema-shaped values with invalid schema keywords in a source's data as schemas (§5.2, §7.2).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "artifact": {
            "kind": "example.local@1",
            "data": {
              "type": 42,
              "items": []
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "This specification never reads $schema dialect declarations in a source's data as schemas (§5.2, §7.2).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "artifact": {
            "kind": "example.local@1",
            "data": {
              "$schema": "http://json-schema.org/draft-07/schema#"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "This specification never reads repeated $id declarations in a source's data as schemas (§5.2, §7.2).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "artifact": {
            "kind": "example.local@1",
            "data": [
              {
                "$id": "https://e.test/r"
              },
              {
                "$id": "https://e.test/r"
              }
            ]
          }
        }
      },
      "valid": true
    },
    {
      "description": "This specification never reads repeated anchors and dynamic anchors in a source's data as schemas (§5.2, §7.2).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "artifact": {
            "kind": "example.local@1",
            "data": [
              {
                "$anchor": "n"
              },
              {
                "$anchor": "n"
              },
              {
                "$dynamicAnchor": "n"
              }
            ]
          }
        }
      },
      "valid": true
    },
    {
      "description": "This specification never reads dangling and malformed references in a source's data as schemas (§5.2, §7.2).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "artifact": {
            "kind": "example.local@1",
            "data": {
              "$ref": "#/missing",
              "$dynamicRef": "#%ZZ"
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "This specification never reads nested schema keywords in a source's data as schemas (§5.2, §7.2).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "artifact": {
            "kind": "example.local@1",
            "data": {
              "allOf": [
                {
                  "$id": "relative.json",
                  "$dynamicAnchor": null,
                  "$ref": "#missing"
                }
              ]
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "This specification never reads a nested OBI document in a source's data as schemas (§5.2, §7.2).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "artifact": {
            "kind": "example.local@1",
            "data": {
              "openbindings": "0.2.0",
              "operations": {
                "op": {
                  "input": {
                    "$ref": "#/schemas/Missing"
                  }
                }
              }
            }
          }
        }
      },
      "valid": true
    },
    {
      "description": "This specification never reads any JSON value in a source's data as a schema (§5.2, §7.2).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "artifact": {
            "kind": "example.local@1",
            "data": [
              null,
              false,
              1,
              "value",
              [],
              {}
            ]
          }
        }
      },
      "valid": true
    },
    {
      "description": "Declarations in a source's data cannot collide with the document's schema declarations (§5.2, §7.2).",
      "document": {
        "openbindings": "0.2.0",
        "operations": {},
        "sources": {
          "artifact": {
            "kind": "example.local@1",
            "data": {
              "$id": "https://e.test/r.json",
              "$anchor": "n",
              "$dynamicAnchor": "n",
              "$ref": "#missing"
            }
          }
        },
        "schemas": {
          "R": {
            "$id": "https://e.test/r.json",
            "$anchor": "n",
            "$dynamicAnchor": "n"
          }
        }
      },
      "valid": true
    }
  ]
}
