    {
      "id": "GQL-FI-02",
      "rules": [
        "OBI-B-02",
        "GQL-P-04"
      ],
      "section": "4",
      "description": "A pinned schema is never repaired by re-introspection: the service's request error against a pin-validated document is the invocation's unsuccessful completion, with no output and exactly one request.",
      "given": {
        "source": {
          "location": "https://api.example.test/graphql",
          "content": {
            "document": "query Viewer($id: ID!) { viewer(id: $id) { id name } }\nquery Status { status }\nquery Find($filter: Filter!) { find(filter: $filter) { id } }\nmutation Rename($id: ID!, $name: String!) { rename(id: $id, name: $name) { id name } }\n",
            "schema": "type Query { viewer(id: ID!): User status: String find(filter: Filter!): User }\ntype Mutation { rename(id: ID!, name: String!): User }\ntype User { id: ID! name: String }\ninput Filter @oneOf { byId: ID byName: String }\n"
          }
        },
        "binding": {
          "selector": "Viewer"
        },
        "invocation": {
          "inputPresent": true,
          "input": {
            "id": "u-1"
          }
        },
        "peer": {
          "status": 400,
          "contentType": "application/graphql-response+json",
          "body": {
            "errors": [
              {
                "message": "Unknown argument \"id\" on field \"Query.viewer\"."
              }
            ]
          }
        }
      },
      "expected": [
        {
          "disposition": "error",
          "phase": "response",
          "assertions": [
            {
              "path": "/dispatches/1",
              "absent": true
            },
            {
              "path": "/outputs",
              "equals": []
            }
          ]
        }
      ]
    },
