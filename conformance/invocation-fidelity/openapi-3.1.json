{
  "format": "openbindings.invocation-fidelity-scenarios@1",
  "bindingSpec": "openbindings.openapi-3.1@1",
  "family": "openapi-3.1",
  "description": "OpenAPI 3.1 fidelity scenarios with separate abstract and lower-layer assertions. Application values and completion behavior form the operation proof; native HTTP responses and OpenAPI declaration matches are lower-layer binding evidence and never operation outputs.",
  "scenarios": [
    {
      "id": "OAPI31-FI-01",
      "rules": [
        "OBI-B-02",
        "OAPI31-P-03"
      ],
      "section": "9.5",
      "description": "An error-shaped JSON value returned with an artifact-defined successful status remains an ordinary output value.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": {
              "title": "Result object",
              "version": "1"
            },
            "servers": [
              {
                "url": "https://api.example"
              }
            ],
            "paths": {
              "/jobs": {
                "post": {
                  "operationId": "fidelityJobs",
                  "responses": {
                    "200": {
                      "description": "operation result",
                      "content": {
                        "application/json": {}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1jobs/post"
        },
        "invocation": {
          "inputPresent": false
        },
        "peer": {
          "status": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"error\":{\"code\":\"REJECTED\"}}"
        }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            {
              "path": "/outputs",
              "equals": [
                {
                  "error": {
                    "code": "REJECTED"
                  }
                }
              ]
            },
            {
              "path": "/error",
              "absent": true
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI31-FI-02",
      "rules": [
        "OBI-B-02",
        "OAPI31-P-03"
      ],
      "section": "9.5",
      "description": "A declared JSON 404 completes unsuccessfully without becoming an operation output, while its application-authored JSON value is preserved as opaque failure data.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": {
              "title": "Declared failure",
              "version": "1"
            },
            "servers": [
              {
                "url": "https://api.example"
              }
            ],
            "paths": {
              "/items": {
                "get": {
                  "operationId": "fidelityItems",
                  "responses": {
                    "default": {
                      "description": "failure",
                      "content": {
                        "application/json": {}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1items/get"
        },
        "invocation": {
          "inputPresent": false
        },
        "peer": {
          "status": 404,
          "headers": {
            "Content-Type": "application/json",
            "X-Request-Id": "req-404"
          },
          "body": "{\"error\":\"missing\"}"
        }
      },
      "expected": [
        {
          "disposition": "error",
          "phase": "response",
          "assertions": [
            {
              "path": "/outputs",
              "equals": []
            },
            {
              "path": "/error/code",
              "equals": "ERR_EXECUTION_FAILED"
            },
            {
              "path": "/error/data",
              "equals": {
                "error": "missing"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI31-FI-03",
      "rules": [
        "OBI-B-02",
        "OAPI31-P-03"
      ],
      "section": "9.5",
      "description": "An undeclared non-empty binary 500 completes unsuccessfully as a protocol error because no Response Object governs its body.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": {
              "title": "Binary failure",
              "version": "1"
            },
            "servers": [
              {
                "url": "https://api.example"
              }
            ],
            "paths": {
              "/binary": {
                "get": {
                  "operationId": "fidelityBinary",
                  "responses": {
                    "200": {
                      "description": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1binary/get"
        },
        "invocation": {
          "inputPresent": false
        },
        "peer": {
          "status": 500,
          "headers": {
            "Content-Type": "application/octet-stream"
          },
          "bodyBase64": "AP+AQQ=="
        }
      },
      "expected": [
        {
          "disposition": "error",
          "phase": "response",
          "assertions": [
            {
              "path": "/outputs",
              "equals": []
            },
            {
              "path": "/error/code",
              "equals": "ERR_EXECUTION_FAILED"
            },
            {
              "path": "/error/data",
              "absent": true
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI31-FI-04",
      "rules": [
        "OBI-B-02",
        "OAPI31-P-03"
      ],
      "section": "9.5",
      "description": "A 504 completes unsuccessfully and is not converted into an output object. Its declared text/plain body decodes through the same text lane a successful response would use (§9.5 names §9.2's lanes, ruled 2026-08-13) and rides the error data member as application-authored failure data.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": {
              "title": "Gateway timeout",
              "version": "1"
            },
            "servers": [
              {
                "url": "https://api.example"
              }
            ],
            "paths": {
              "/slow": {
                "get": {
                  "operationId": "fidelitySlow",
                  "responses": {
                    "504": {
                      "description": "timeout",
                      "content": {
                        "text/plain": {
                          "schema": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1slow/get"
        },
        "invocation": {
          "inputPresent": false
        },
        "peer": {
          "status": 504,
          "headers": {
            "Content-Type": "text/plain; charset=utf-8"
          },
          "body": "gateway timeout"
        }
      },
      "expected": [
        {
          "disposition": "error",
          "phase": "response",
          "assertions": [
            {
              "path": "/outputs",
              "equals": []
            },
            {
              "path": "/error/code",
              "equals": "ERR_EXECUTION_FAILED"
            },
            {
              "path": "/error/data",
              "equals": "gateway timeout"
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI31-FI-07",
      "rules": [
        "OBI-B-02",
        "OAPI31-P-03",
        "OAPI31-S-01"
      ],
      "section": "9.1",
      "description": "Configured wildcard carriage leaves the operation input as a pure application object while binding evidence proves the concrete JSON realization.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": {
              "title": "Wildcard abstraction",
              "version": "1"
            },
            "servers": [
              {
                "url": "https://api.example"
              }
            ],
            "paths": {
              "/items": {
                "post": {
                  "operationId": "fidelityCreateItem",
                  "requestBody": {
                    "required": true,
                    "content": {
                      "*/*": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "name"
                          ]
                        }
                      }
                    }
                  },
                  "responses": {
                    "204": {
                      "description": "stored"
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1items/post"
        },
        "configuration": {
          "requestMedia": "application/json"
        },
        "invocation": {
          "inputPresent": true,
          "input": {
            "name": "Ada"
          }
        },
        "peer": {
          "status": 204,
          "body": ""
        }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            {
              "path": "/outputs",
              "equals": []
            },
            {
              "path": "/error",
              "absent": true
            },
            {
              "path": "/dispatch/headers/Content-Type",
              "equals": "application/json"
            },
            {
              "path": "/dispatch/body",
              "equals": {
                "name": "Ada"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI31-FI-08",
      "rules": [
        "OBI-B-02",
        "OAPI31-P-03",
        "OAPI31-S-01"
      ],
      "section": "9.1",
      "description": "A wildcard-only operation with no concrete media choice requests retryable configuration without dispatching or changing the application input contract.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": {
              "title": "Wildcard context",
              "version": "1"
            },
            "servers": [
              {
                "url": "https://api.example"
              }
            ],
            "paths": {
              "/items": {
                "post": {
                  "operationId": "fidelityCreateItemWithContext",
                  "requestBody": {
                    "required": true,
                    "content": {
                      "*/*": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "responses": {
                    "204": {
                      "description": "stored"
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1items/post"
        },
        "invocation": {
          "inputPresent": true,
          "input": {
            "name": "Ada"
          }
        }
      },
      "expected": [
        {
          "disposition": "context-required",
          "phase": "pre-dispatch",
          "assertions": [
            {
              "path": "/outputs",
              "equals": []
            },
            {
              "path": "/dispatch",
              "absent": true
            },
            {
              "path": "/context/alternatives/0/requirements/0/type",
              "equals": "config.value"
            },
            {
              "path": "/context/alternatives/0/requirements/0/point",
              "equals": "requestMedia"
            },
            {
              "path": "/context/alternatives/0/requirements/0/path",
              "equals": ""
            }
          ]
        }
      ]
    },
    {
      "id": "OAPI31-FI-11",
      "rules": [
        "OBI-B-02",
        "OAPI31-P-02",
        "OAPI31-P-03",
        "OAPI31-P-04",
        "OAPI31-S-01"
      ],
      "section": "9.2",
      "description": "Joined synthesis preserves a declaration-complex JSON schema and value as one protocol-neutral property while the private route keeps a same-named query value independent.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": {
              "title": "Whole JSON abstraction",
              "version": "1"
            },
            "servers": [
              {
                "url": "https://api.example"
              }
            ],
            "paths": {
              "/items": {
                "post": {
                  "operationId": "fidelityWholeJSON",
                  "parameters": [
                    {
                      "name": "kind",
                      "in": "query",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "requestBody": {
                    "required": true,
                    "content": {
                      "application/json": {
                        "schema": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "const": "named"
                                },
                                "name": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "kind",
                                "name"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          ]
                        }
                      }
                    }
                  },
                  "responses": {
                    "204": {
                      "description": "stored"
                    }
                  }
                }
              }
            }
          }
        },
        "binding": {
          "selector": "#/paths/~1items/post"
        },
        "invocation": {
          "inputPresent": true,
          "input": {
            "kind": "query-value",
            "payload": {
              "kind": "named",
              "name": "Ada"
            }
          }
        },
        "peer": {
          "status": 204,
          "body": ""
        }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            {
              "path": "/outputs",
              "equals": []
            },
            {
              "path": "/error",
              "absent": true
            },
            {
              "path": "/dispatch/url",
              "equals": "https://api.example/items?kind=query-value"
            },
            {
              "path": "/dispatch/headers/Content-Type",
              "equals": "application/json"
            },
            {
              "path": "/dispatch/body",
              "equals": {
                "kind": "named",
                "name": "Ada"
              }
            }
          ]
        }
      ]
    }
  ]
}
