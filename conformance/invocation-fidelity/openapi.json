{
  "format": "openbindings.invocation-fidelity-scenarios@1",
  "bindingSpec": "openbindings.openapi@6",
  "family": "openapi",
  "description": "OpenAPI fidelity scenarios with separate abstract and diagnostic assertions. Application values and completion behavior form the operation proof; native HTTP responses and OpenAPI declaration matches are lower-layer binding evidence and never operation outputs.",
  "scenarios": [
    {
      "id": "OAPI-FI-01",
      "rules": ["OBI-B-02", "OAPI-P-07", "OAPI-P-08"],
      "section": "9.5",
      "description": "An error-shaped JSON value returned with an artifact-defined successful status remains an ordinary output value.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": { "title": "Result object", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/jobs": {
          "post": {
            "operationId": "fidelityJobs",
                  "responses": {
                    "200": {
                      "description": "operation result",
                      "content": { "application/json": {} }
                    }
                  }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1jobs/post" },
        "invocation": { "inputPresent": false },
        "peer": {
          "status": 200,
          "headers": { "Content-Type": "application/json" },
          "body": "{\"error\":{\"code\":\"REJECTED\"}}"
        }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            { "path": "/outputs", "equals": [{ "error": { "code": "REJECTED" } }] },
            { "path": "/error", "absent": true }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-02",
      "rules": ["OBI-B-02", "OAPI-P-06", "OAPI-P-08"],
      "section": "9.5",
      "description": "A declared JSON 404 completes unsuccessfully without becoming an operation output; optional diagnostics retain the native observation.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": { "title": "Declared failure", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/items": {
          "get": {
            "operationId": "fidelityItems",
                  "responses": {
                    "default": {
                      "description": "failure",
                      "content": { "application/json": {} }
                    }
                  }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1items/get" },
        "invocation": { "inputPresent": false },
        "peer": {
          "status": 404,
          "headers": {
            "Content-Type": "application/json",
            "X-Request-Id": "req-404"
          },
          "body": "{\"error\":\"missing\"}"
        }
      },
      "expected": [
        {
          "disposition": "error",
          "phase": "response",
          "assertions": [
            { "path": "/outputs", "equals": [] },
            { "path": "/error/code", "equals": "ERR_EXECUTION_FAILED" },
            { "path": "/error/message", "equals": "Invocation completed unsuccessfully" },
            { "path": "/error/details", "absent": true },
            { "path": "/error/diagnostics/status", "equals": 404 },
            { "path": "/error/diagnostics/httpResponse/status", "equals": 404 },
            { "path": "/error/diagnostics/httpResponse/headers/content-type", "equals": ["application/json"] },
            { "path": "/error/diagnostics/httpResponse/headers/x-request-id", "equals": ["req-404"] },
            { "path": "/error/diagnostics/httpResponse/body/base64", "equals": "eyJlcnJvciI6Im1pc3NpbmcifQ==" },
            { "path": "/error/diagnostics/httpResponse/body/byteLength", "equals": 19 },
            { "path": "/error/diagnostics/openapi/declared", "equals": true },
            { "path": "/error/diagnostics/openapi/responseKey", "equals": "default" },
            { "path": "/error/diagnostics/openapi/governingMedia", "equals": "application/json" }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-03",
      "rules": ["OBI-B-02", "OAPI-P-08"],
      "section": "9.5",
      "description": "An undeclared binary 500 completes unsuccessfully; a diagnostic assertion separately proves exact bounded body capture instead of a lossy text rendering.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": { "title": "Binary failure", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/binary": {
          "get": {
            "operationId": "fidelityBinary",
                  "responses": { "200": { "description": "ok" } }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1binary/get" },
        "invocation": { "inputPresent": false },
        "peer": {
          "status": 500,
          "headers": { "Content-Type": "application/octet-stream" },
          "bodyBase64": "AP+AQQ=="
        }
      },
      "expected": [
        {
          "disposition": "error",
          "phase": "response",
          "assertions": [
            { "path": "/outputs", "equals": [] },
            { "path": "/error/code", "equals": "ERR_EXECUTION_FAILED" },
            { "path": "/error/message", "equals": "Invocation completed unsuccessfully" },
            { "path": "/error/details", "absent": true },
            { "path": "/error/diagnostics/httpResponse/body/base64", "equals": "AP+AQQ==" },
            { "path": "/error/diagnostics/httpResponse/body/byteLength", "equals": 4 },
            { "path": "/error/diagnostics/openapi/declared", "equals": false },
            { "path": "/error/diagnostics/openapi/responseKey", "absent": true }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-04",
      "rules": ["OBI-B-02", "OAPI-P-08"],
      "section": "9.5",
      "description": "A 504 completes unsuccessfully and is not converted into an output object; optional diagnostics retain the native response without defining retry semantics.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": { "title": "Gateway timeout", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/slow": {
          "get": {
            "operationId": "fidelitySlow",
                  "responses": {
                    "504": {
                      "description": "timeout",
                      "content": { "text/plain": {} }
                    }
                  }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1slow/get" },
        "invocation": { "inputPresent": false },
        "peer": {
          "status": 504,
          "headers": { "Content-Type": "text/plain; charset=utf-8" },
          "body": "gateway timeout"
        }
      },
      "expected": [
        {
          "disposition": "error",
          "phase": "response",
          "assertions": [
            { "path": "/outputs", "equals": [] },
            { "path": "/error/code", "equals": "ERR_EXECUTION_FAILED" },
            { "path": "/error/message", "equals": "Invocation completed unsuccessfully" },
            { "path": "/error/details", "absent": true },
            { "path": "/error/diagnostics/httpResponse/body/base64", "equals": "Z2F0ZXdheSB0aW1lb3V0" },
            { "path": "/error/diagnostics/openapi/responseKey", "equals": "504" },
            { "path": "/error/diagnostics/openapi/governingMedia", "equals": "text/plain" }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-05",
      "rules": ["OBI-B-02", "OAPI-P-06", "OAPI-P-08"],
      "section": "8",
      "description": "A non-2xx event-stream response completes unsuccessfully; a diagnostic assertion proves its bounded body is not discarded when streaming framing is detected.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": { "title": "Event-stream failure", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/events": {
                "get": {
                  "operationId": "fidelitySSEFailure",
                  "responses": {
                    "200": {
                      "description": "events",
                      "content": { "text/event-stream": {} }
                    },
                    "503": {
                      "description": "unavailable",
                      "content": { "text/event-stream": {} }
                    }
                  }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1events/get" },
        "invocation": { "inputPresent": false },
        "peer": {
          "status": 503,
          "headers": {
            "Content-Type": "text/event-stream",
            "X-Request-Id": "req-sse-503"
          },
          "body": "event: error\ndata: {\"error\":\"unavailable\"}\n\n"
        }
      },
      "expected": [
        {
          "disposition": "error",
          "phase": "response",
          "assertions": [
            { "path": "/outputs", "equals": [] },
            { "path": "/error/code", "equals": "ERR_EXECUTION_FAILED" },
            { "path": "/error/message", "equals": "Invocation completed unsuccessfully" },
            { "path": "/error/details", "absent": true },
            { "path": "/error/diagnostics/httpResponse/status", "equals": 503 },
            { "path": "/error/diagnostics/httpResponse/headers/content-type", "equals": ["text/event-stream"] },
            { "path": "/error/diagnostics/httpResponse/headers/x-request-id", "equals": ["req-sse-503"] },
            { "path": "/error/diagnostics/httpResponse/body/base64", "equals": "ZXZlbnQ6IGVycm9yCmRhdGE6IHsiZXJyb3IiOiJ1bmF2YWlsYWJsZSJ9Cgo=" },
            { "path": "/error/diagnostics/httpResponse/body/byteLength", "equals": 44 },
            { "path": "/error/diagnostics/openapi/declared", "equals": true },
            { "path": "/error/diagnostics/openapi/responseKey", "equals": "503" },
            { "path": "/error/diagnostics/openapi/governingMedia", "equals": "text/event-stream" }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-06",
      "rules": ["OBI-B-02", "OAPI-P-03", "OAPI-P-04"],
      "section": "9.2",
      "description": "A synthesized generic binary operation accepts a protocol-independent Base64 string field while concrete binding evidence proves byte-exact image upload.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.0.4",
            "info": { "title": "Binary abstraction", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/image": {
                "put": {
                  "operationId": "fidelityUploadImage",
                  "requestBody": {
                    "required": true,
                    "content": {
                      "image/png": {
                        "schema": { "type": "string", "format": "binary" }
                      }
                    }
                  },
                  "responses": { "204": { "description": "stored" } }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1image/put" },
        "invocation": {
          "inputPresent": true,
          "input": { "body": "AAH+/w==" }
        },
        "peer": { "status": 204, "body": "" }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            { "path": "/outputs", "equals": [] },
            { "path": "/error", "absent": true },
            { "path": "/dispatch/headers/Content-Type", "equals": "image/png" },
            { "path": "/dispatch/bodyBase64", "equals": "AAH+/w==" }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-07",
      "rules": ["OBI-B-02", "OAPI-P-04"],
      "section": "9.2",
      "description": "Configured wildcard carriage leaves the operation input as a pure application object while binding evidence proves the concrete JSON realization.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": { "title": "Wildcard abstraction", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/items": {
                "post": {
                  "operationId": "fidelityCreateItem",
                  "requestBody": {
                    "required": true,
                    "content": {
                      "*/*": {
                        "schema": {
                          "type": "object",
                          "properties": { "name": { "type": "string" } },
                          "required": ["name"]
                        }
                      }
                    }
                  },
                  "responses": { "204": { "description": "stored" } }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1items/post" },
        "configuration": { "requestMedia": "application/json" },
        "invocation": {
          "inputPresent": true,
          "input": { "name": "Ada" }
        },
        "peer": { "status": 204, "body": "" }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            { "path": "/outputs", "equals": [] },
            { "path": "/error", "absent": true },
            { "path": "/dispatch/headers/Content-Type", "equals": "application/json" },
            { "path": "/dispatch/body", "equals": { "name": "Ada" } }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-08",
      "rules": ["OBI-B-02", "OAPI-P-04"],
      "section": "9.2",
      "description": "A wildcard-only operation with no concrete media choice requests retryable configuration without dispatching or changing the application input contract.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": { "title": "Wildcard context", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/items": {
                "post": {
                  "operationId": "fidelityCreateItemWithContext",
                  "requestBody": {
                    "required": true,
                    "content": {
                      "*/*": {
                        "schema": {
                          "type": "object",
                          "properties": { "name": { "type": "string" } }
                        }
                      }
                    }
                  },
                  "responses": { "204": { "description": "stored" } }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1items/post" },
        "invocation": {
          "inputPresent": true,
          "input": { "name": "Ada" }
        }
      },
      "expected": [
        {
          "disposition": "context-required",
          "phase": "pre-dispatch",
          "assertions": [
            { "path": "/outputs", "equals": [] },
            { "path": "/dispatch", "absent": true },
            { "path": "/context/alternatives/0/requirements/0/type", "equals": "config.value" },
            { "path": "/context/alternatives/0/requirements/0/point", "equals": "requestMedia" }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-09",
      "rules": ["OBI-B-02", "OAPI-P-06", "OAPI-P-07"],
      "section": "9.5",
      "description": "A schema-omitted ranged binary response becomes one protocol-independent Base64 application value without exposing status, media, or headers in that value.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": { "title": "Binary abstraction", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/image": {
                "get": {
                  "operationId": "fidelityImage",
                  "responses": {
                    "200": { "description": "image", "content": { "image/*": {} } }
                  }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1image/get" },
        "invocation": { "inputPresent": false },
        "peer": {
          "status": 200,
          "headers": { "Content-Type": "image/png", "X-Trace": "native-only" },
          "bodyBase64": "AAH+/w=="
        }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            { "path": "/outputs", "equals": ["AAH+/w=="] },
            { "path": "/error", "absent": true }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-10",
      "rules": ["OBI-B-02", "OAPI-P-03", "OAPI-P-04"],
      "section": "9.1",
      "description": "Joined synthesis keeps an explicitly dynamic body as one protocol-neutral application object while private routing preserves an independent same-named query value and exact form carriage.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.0.4",
            "info": { "title": "Dynamic abstraction", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/items": {
                "post": {
                  "operationId": "fidelityDynamicItem",
                  "parameters": [
                    { "name": "id", "in": "query", "required": true, "schema": { "type": "string" } }
                  ],
                  "requestBody": {
                    "required": true,
                    "content": {
                      "application/x-www-form-urlencoded": {
                        "schema": {
                          "type": "object",
                          "properties": { "fixed": { "type": "string" } },
                          "additionalProperties": { "type": "string" }
                        }
                      }
                    }
                  },
                  "responses": { "204": { "description": "stored" } }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1items/post" },
        "invocation": {
          "inputPresent": true,
          "input": {
            "id": "query-value",
            "payload": { "id": "body-value", "extra": "a b", "fixed": "yes" }
          }
        },
        "peer": { "status": 204, "body": "" }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            { "path": "/outputs", "equals": [] },
            { "path": "/error", "absent": true },
            { "path": "/dispatch/url", "equals": "https://api.example/items?id=query-value" },
            { "path": "/dispatch/headers/Content-Type", "equals": "application/x-www-form-urlencoded" },
            { "path": "/dispatch/body", "equals": "extra=a+b&fixed=yes&id=body-value" }
          ]
        }
      ]
    },
    {
      "id": "OAPI-FI-11",
      "rules": ["OBI-B-02", "OAPI-P-03", "OAPI-P-04"],
      "section": "9.1",
      "description": "Joined synthesis preserves a declaration-complex JSON schema and value as one protocol-neutral property while the private route keeps a same-named query value independent.",
      "given": {
        "source": {
          "location": "https://api.example/openapi.json",
          "content": {
            "openapi": "3.1.2",
            "info": { "title": "Whole JSON abstraction", "version": "1" },
            "servers": [{ "url": "https://api.example" }],
            "paths": {
              "/items": {
                "post": {
                  "operationId": "fidelityWholeJSON",
                  "parameters": [
                    { "name": "kind", "in": "query", "required": true, "schema": { "type": "string" } }
                  ],
                  "requestBody": {
                    "required": true,
                    "content": {
                      "application/json": {
                        "schema": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": { "kind": { "const": "named" }, "name": { "type": "string" } },
                              "required": ["kind", "name"],
                              "additionalProperties": false
                            },
                            { "type": "array", "items": { "type": "string" } }
                          ]
                        }
                      }
                    }
                  },
                  "responses": { "204": { "description": "stored" } }
                }
              }
            }
          }
        },
        "binding": { "ref": "#/paths/~1items/post" },
        "invocation": {
          "inputPresent": true,
          "input": {
            "kind": "query-value",
            "payload": { "kind": "named", "name": "Ada" }
          }
        },
        "peer": { "status": 204, "body": "" }
      },
      "expected": [
        {
          "disposition": "complete",
          "phase": "completion",
          "assertions": [
            { "path": "/outputs", "equals": [] },
            { "path": "/error", "absent": true },
            { "path": "/dispatch/url", "equals": "https://api.example/items?kind=query-value" },
            { "path": "/dispatch/headers/Content-Type", "equals": "application/json" },
            { "path": "/dispatch/body", "equals": { "kind": "named", "name": "Ada" } }
          ]
        }
      ]
    }
  ]
}
