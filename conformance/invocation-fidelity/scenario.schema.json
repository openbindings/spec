{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbindings.com/conformance/invocation-fidelity/scenario.schema.json",
  "title": "OpenBindings invocation-fidelity scenarios",
  "type": "object",
  "required": [
    "format",
    "bindingSpec",
    "family",
    "description",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "openbindings.invocation-fidelity-scenarios@1"
    },
    "bindingSpec": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rules",
          "section",
          "description",
          "given",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-FI-[0-9]{2}$"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "given": {
            "type": "object",
            "required": [
              "source",
              "binding",
              "invocation"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "object"
              },
              "binding": {
                "type": "object"
              },
              "configuration": {
                "type": "object"
              },
              "invocation": {
                "type": "object",
                "required": [
                  "inputPresent"
                ],
                "properties": {
                  "inputPresent": {
                    "type": "boolean"
                  },
                  "input": {},
                  "writes": {
                    "type": "array"
                  }
                },
                "additionalProperties": true
              },
              "peer": {
                "type": "object"
              },
              "runtime": {
                "type": "object"
              }
            }
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "disposition",
                "phase",
                "assertions"
              ],
              "additionalProperties": false,
              "properties": {
                "disposition": {
                  "enum": [
                    "complete",
                    "error",
                    "refusal",
                    "context-required"
                  ]
                },
                "phase": {
                  "enum": [
                    "load",
                    "resolution",
                    "pre-dispatch",
                    "dispatch",
                    "response",
                    "completion"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "assertions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "path"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^/"
                      },
                      "equals": {},
                      "absent": {
                        "const": true
                      },
                      "oneOf": {
                        "type": "array",
                        "minItems": 1
                      },
                      "setEquals": {
                        "type": "array",
                        "uniqueItems": true
                      },
                      "contains": {}
                    },
                    "oneOf": [
                      {
                        "required": [
                          "equals"
                        ]
                      },
                      {
                        "required": [
                          "absent"
                        ]
                      },
                      {
                        "required": [
                          "oneOf"
                        ]
                      },
                      {
                        "required": [
                          "setEquals"
                        ]
                      },
                      {
                        "required": [
                          "contains"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
