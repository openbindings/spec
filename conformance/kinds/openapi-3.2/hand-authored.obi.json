{
  "openbindings": "0.2.0",
  "name": "Independent hand-authored task correspondence",
  "operations": {
    "submitTask": {
      "description": "Submit the supplied task fields under the supplied task key.",
      "input": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "note": true
        },
        "required": [
          "key",
          "name",
          "labels",
          "enabled",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "sources": {
    "httpApi": {
      "kind": "openbindings.openapi-3.2@1",
      "content": {
        "document": {
          "openapi": "3.2.0",
          "info": {
            "title": "Independent probe",
            "version": "1"
          },
          "servers": [
            {
              "url": "https://wire.example/base"
            }
          ],
          "paths": {
            "/things/{id}": {
              "post": {
                "parameters": [
                  {
                    "in": "path",
                    "name": "id",
                    "required": true,
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "in": "query",
                    "name": "tag",
                    "schema": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "in": "query",
                    "name": "flag",
                    "schema": {
                      "type": "boolean"
                    }
                  }
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {}
                  }
                },
                "responses": {
                  "200": {
                    "content": {
                      "application/json": {}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "bindings": {
    "submitTask.http": {
      "operation": "submitTask",
      "source": "httpApi",
      "content": {
        "target": "/paths/~1things~1{id}/post",
        "input": "{\"parameters\": {\"id\": $lookup($, \"key\"), \"tag\": $lookup($, \"labels\"), \"flag\": $lookup($, \"enabled\")}, \"body\": {\"title\": $lookup($, \"name\"), \"done\": false, \"note\": $lookup($, \"note\"), \"omitted\": $lookup($, \"notThere\")}}",
        "output": "$lookup($, \"result\")"
      }
    }
  }
}
