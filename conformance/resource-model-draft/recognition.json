  {
    "name": "a $dynamicAnchor outside an $id resource is reported for OBI-14",
    "document": {
      "openbindings": "0.2.0",
      "operations": {
        "getTree": {
          "output": {
            "$ref": "https://example.com/tree.json"
          }
        }
      },
      "schemas": {
        "Tree": {
          "$id": "https://example.com/tree.json",
          "$dynamicAnchor": "node",
          "properties": {
            "children": {
              "items": {
                "$dynamicRef": "#node"
              }
            }
          }
        },
        "LabeledNode": {
          "$dynamicAnchor": "node",
          "$ref": "https://example.com/tree.json"
        }
      }
    },
    "entries": [
      "/operations/getTree/output",
      "/schemas/LabeledNode",
      "/schemas/Tree"
    ],
    "schemas": [
      "/operations/getTree/output",
      "/schemas/LabeledNode",
      "/schemas/Tree",
      "/schemas/Tree/properties/children",
      "/schemas/Tree/properties/children/items"
    ],
    "unresolved": [],
    "documentDynamicAnchors": [
      "/schemas/LabeledNode"
    ],
    "metaValid": true
  },
