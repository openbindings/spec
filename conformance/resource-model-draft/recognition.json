      "schemas": {
        "Task": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        },
        "Unused": {
          "type": "string"
        },
        "Never": false
      }
    },
    "entries": [
      "/operations/get/output",
      "/schemas/Never",
      "/schemas/Task",
      "/schemas/Unused"
    ],
    "schemas": [
