  {
    "name": "identifiers and anchors inside resources declare nothing",
    "document": {
      "openbindings": "0.2.0",
      "operations": {
        "get": {
          "output": {
            "$ref": "#stored"
          }
        },
        "put": {
          "input": {
            "$ref": "https://example.com/stored.json"
          }
        }
      },
      "resources": {
        "stored": {
          "$id": "https://example.com/stored.json",
          "$anchor": "stored",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": 42
        }
      }
    },
    "entries": [
      "/operations/get/output",
      "/operations/put/input"
    ],
    "schemas": [
      "/operations/get/output",
      "/operations/put/input"
    ],
    "unresolved": [
      "/operations/get/output#$ref"
    ],
    "documentDynamicAnchors": [],
    "metaValid": true
  },
  {
    "name": "binding content and examples are not traversed",
    "document": {
      "openbindings": "0.2.0",
      "operations": {
        "run": {
          "input": {
            "const": {
              "$ref": "#/nowhere"
            },
            "examples": [
              {
                "$ref": "#/nowhere"
              }
            ],
            "x-schema": {
              "$ref": "#/nowhere"
            }
          },
          "examples": {
            "one": {
              "input": {
                "$ref": "#/nowhere"
              }
            }
          }
        }
      },
      "bindings": {
        "run.local": {
          "operation": "run",
          "kind": "example.local@1",
          "content": {
            "schema": {
              "$ref": "#/nowhere",
              "type": 42
            }
          }
        }
      }
    },
    "entries": [
      "/operations/run/input"
    ],
    "schemas": [
      "/operations/run/input"
    ],
    "unresolved": [],
    "documentDynamicAnchors": [],
    "metaValid": true
  },
