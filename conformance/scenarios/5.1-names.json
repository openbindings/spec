{
  "format": "openbindings.core-scenarios@4",
  "section": "5.1",
  "description": "Which operation a string identifies, and that operation's bindings: a string identifies an operation exactly when it equals the operation's key or one of its aliases, and the operation's bindings are those whose operation member holds its key (section 5.1, Aliases).",
  "scenarios": [
    {
      "id": "NAMES-01",
      "description": "An alias identifies its operation, whose bindings are those whose operation member holds its key (section 5.1, Aliases).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "aliases": [
                "op.alias"
              ]
            }
          },
          "bindings": {
            "b1": {
              "operation": "op",
              "kind": "k@1"
            },
            "b2": {
              "operation": "op",
              "kind": "k@1"
            }
          }
        },
        "name": "op.alias"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "op",
        "bindingKeys": [
          "b1",
          "b2"
        ]
      }
    },
    {
      "id": "NAMES-02",
      "description": "The document's name is a label, not an identifier (section 5): it identifies no operation.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "name": "createTask",
          "operations": {
            "other": {}
          }
        },
        "name": "createTask"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-03",
      "description": "Deprecation is a hint to migrate away (section 5.1), not a removal: a deprecated operation's key still identifies it, with its bindings.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "legacyTask": {
              "deprecated": true
            }
          },
          "bindings": {
            "legacy": {
              "operation": "legacyTask",
              "kind": "example.test@1"
            }
          }
        },
        "name": "legacyTask"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "legacyTask",
        "bindingKeys": [
          "legacy"
        ]
      }
    },
    {
      "id": "NAMES-04",
      "description": "A binding's deprecated, preference, and content members do not remove it from its operation's bindings (section 5.3): deprecation recommends migrating away, preference expresses author preference among them, and content's presence and value carry no core meaning.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {}
          },
          "bindings": {
            "deprecated": {
              "operation": "createTask",
              "deprecated": true,
              "kind": "example.test@1"
            },
            "nullContent": {
              "operation": "createTask",
              "content": null,
              "kind": "example.test@1"
            },
            "noContent": {
              "operation": "createTask",
              "kind": "example.test@1"
            },
            "zeroPreference": {
              "operation": "createTask",
              "preference": 0,
              "kind": "example.test@1"
            },
            "negativePreference": {
              "operation": "createTask",
              "preference": -5,
              "kind": "example.test@1"
            },
            "preferred": {
              "operation": "createTask",
              "preference": 10,
              "kind": "example.test@1"
            }
          }
        },
        "name": "createTask"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "createTask",
        "bindingKeys": [
          "deprecated",
          "negativePreference",
          "noContent",
          "nullContent",
          "preferred",
          "zeroPreference"
        ]
      }
    },
    {
      "id": "NAMES-05",
      "description": "An x-aliases extension adds no identifier: an extension never changes the meaning of a core field (section 12).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {
              "x-aliases": [
                "tasks.create"
              ]
            }
          }
        },
        "name": "tasks.create"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-06",
      "description": "An x-operation extension on a binding does not move the binding to another operation (section 12).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {},
            "other": {}
          },
          "bindings": {
            "b": {
              "operation": "createTask",
              "x-operation": "other",
              "kind": "k@1"
            }
          }
        },
        "name": "other"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "other",
        "bindingKeys": []
      }
    },
    {
      "id": "NAMES-07",
      "description": "An operation's key identifies it, and its bindings are those whose operation member holds that key (section 5.1).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {}
          },
          "bindings": {
            "primary": {
              "operation": "createTask",
              "kind": "example.test@1"
            }
          }
        },
        "name": "createTask"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "createTask",
        "bindingKeys": [
          "primary"
        ]
      }
    },
    {
      "id": "NAMES-08",
      "description": "An alias identifies its operation as its key does; the operation's bindings are those whose operation member holds the key, never the alias (section 5.1).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {
              "aliases": [
                "tasks.create",
                "addTask"
              ]
            }
          },
          "bindings": {
            "canonical": {
              "operation": "createTask",
              "kind": "example.test@1"
            }
          }
        },
        "name": "tasks.create"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "createTask",
        "bindingKeys": [
          "canonical"
        ]
      }
    },
    {
      "id": "NAMES-09",
      "description": "A string equal to no key or alias identifies no operation (section 5.1).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {
              "aliases": [
                "tasks.create"
              ]
            }
          }
        },
        "name": "tasks.delete"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-10",
      "description": "A host-language prototype name identifies no operation unless the document defines one by that name.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "ordinary": {}
          }
        },
        "name": "constructor"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-11",
      "description": "A document may define an operation whose key is a host-language prototype name, and that key identifies it.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "constructor": {}
          }
        },
        "name": "constructor"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "constructor",
        "bindingKeys": []
      }
    },
    {
      "id": "NAMES-12",
      "description": "Strings are equal only when their code units are (section 5): a lower-cased key identifies no operation.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {}
          }
        },
        "name": "createtask"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-13",
      "description": "Leading white space is part of the string, so it identifies no operation (section 5).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {}
          }
        },
        "name": " createTask"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-14",
      "description": "A trailing newline is part of the string, so it identifies no operation (section 5).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {}
          }
        },
        "name": "createTask\n"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-15",
      "description": "A prefix of a key identifies no operation: only an equal string does (section 5.1).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {}
          }
        },
        "name": "create"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-16",
      "description": "Dots carry no structure (section 5): a trailing segment of a qualified alias identifies no operation.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "aliases": [
                "acme.tasks.createTask"
              ]
            }
          }
        },
        "name": "createTask"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-17",
      "description": "An alias that differs only in case from another operation's key identifies the alias's operation (section 5).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "Task": {},
            "other": {
              "aliases": [
                "task"
              ]
            }
          }
        },
        "name": "task"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "other",
        "bindingKeys": []
      }
    },
    {
      "id": "NAMES-18",
      "description": "A map key beginning with x- names an ordinary operation, not an extension field (section 12), and identifies it.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "x-internal": {}
          }
        },
        "name": "x-internal"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "x-internal",
        "bindingKeys": []
      }
    },
    {
      "id": "NAMES-19",
      "description": "A binding key is not an operation identifier: a string equal to one identifies no operation.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {}
          },
          "bindings": {
            "tasks.http": {
              "operation": "createTask",
              "kind": "example.test@1"
            }
          }
        },
        "name": "tasks.http"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-20",
      "description": "A dependency key is not an operation identifier: a string equal to one identifies no operation, not even the one the dependency consumes.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {}
          },
          "dependencies": {
            "taskSink": {
              "operation": "createTask"
            }
          }
        },
        "name": "taskSink"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "NAMES-21",
      "description": "Resource and schema keys are not operation identifiers: a string equal to both identifies no operation (§5.1).",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {}
          },
          "schemas": {
            "Task": {
              "type": "object"
            }
          },
          "resources": {
            "Task": {}
          }
        },
        "name": "Task"
      },
      "expected": {
        "outcome": "not-found"
      }
    }
  ]
}
