{
  "format": "openbindings.core-scenarios@4",
  "section": "6",
  "description": "Whether a binding meets a dependency's kinds constraint: exactly when the kind of its source is the same kind as one listed, two kinds being the same exactly when their strings are equal (section 5.5; section 6, Comparison).",
  "scenarios": [
    {
      "id": "KINDS-01",
      "description": "The kind of the binding's source, identical to a listed kind, meets the constraint (section 6).",
      "action": "check-dependency-kind",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {}
          },
          "sources": {
            "s": {
              "kind": "example.openapi@1"
            }
          },
          "bindings": {
            "b": {
              "operation": "op",
              "source": "s"
            }
          },
          "dependencies": {
            "d": {
              "operation": "op",
              "kinds": [
                "example.openapi@1"
              ]
            }
          }
        },
        "dependency": "d",
        "binding": "b"
      },
      "expected": {
        "outcome": "meets"
      }
    },
    {
      "id": "KINDS-02",
      "description": "A source kind differing from the listed kind only in letter case is a different kind (section 6).",
      "action": "check-dependency-kind",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {}
          },
          "sources": {
