            }
          },
          "dependencies": {
            "d": {
              "operation": "op",
              "kinds": [
                "example.openapi@1"
              ]
            }
          }
        },
        "dependency": "d",
        "binding": "b"
      },
      "expected": {
        "outcome": "does-not-meet"
      }
    },
    {
