{
  "format": "openbindings.core-tool-scenarios@2",
  "rule": "OBI-T-01",
  "section": "10.3",
  "description": "Kind comparison for a dependency's kinds constraint is exact, with no normalization, case folding, decomposition, inferred compatibility or order, or retrieval.",
  "scenarios": [
    {
      "id": "T01-S-01",
      "clauses": [
        "OBI-T-01/c1"
      ],
      "description": "An identical kind string meets the constraint.",
      "action": "check-dependency-kind",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {}
          },
          "sources": {
            "s": {
              "kind": "example.openapi@1"
            }
          },
          "bindings": {
            "b": {
              "operation": "op",
              "source": "s"
            }
          },
          "dependencies": {
            "d": {
              "operation": "op",
              "kinds": [
                "example.openapi@1"
              ]
            }
          }
        },
        "dependency": "d",
        "binding": "b"
      },
      "expected": {
        "outcome": "meets"
      }
    },
    {
      "id": "T01-S-02",
      "clauses": [
        "OBI-T-01/c2b"
      ],
