{
  "format": "openbindings.core-tool-scenarios@2",
  "rule": "OBI-T-02",
  "section": "10.3",
  "description": "Defined fields carry their defined meanings, presence included, and unknown fields carry none. Representative fields only; the clause covers every field.",
  "scenarios": [
    {
      "id": "T02-S-01",
      "clauses": [
        "OBI-T-02/c3"
      ],
      "description": "A member spelled like aliases in another case is an unknown field and gives the operation no alias.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "createTask": {
              "Aliases": [
                "tasks.create"
              ]
            }
          }
        },
        "nonConformant": [
          "OBI-D-02"
        ],
        "name": "tasks.create"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "T02-S-02",
      "clauses": [
        "OBI-T-02/c3"
      ],
      "description": "An unknown dependency member named like kinds imposes no kind constraint.",
      "action": "check-dependency-kind",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {}
          },
          "sources": {
            "s": {
              "kind": "b@1"
            }
          },
          "bindings": {
            "b": {
              "operation": "op",
              "source": "s"
            }
          },
          "dependencies": {
            "d": {
              "operation": "op",
              "kind": [
                "a@1"
              ]
            }
          }
        },
        "nonConformant": [
          "OBI-D-02"
        ],
        "dependency": "d",
        "binding": "b"
      },
      "expected": {
        "outcome": "meets"
      }
    },
    {
      "id": "T02-S-03",
      "clauses": [
        "OBI-T-02/c1"
      ],
      "description": "The version field is an interface label; it never enters the version decision.",
      "action": "validate-document",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "version": "999.0.0",
          "operations": {}
        }
      },
      "requiresSupports": "0.2.0",
      "requiresUnsupported": "999.0.0",
      "expected": {
        "outcome": "conformant"
      }
    },
    {
      "id": "T02-S-04",
      "clauses": [
        "OBI-T-02/c1"
      ],
      "description": "A binding's operation member is a key reference; resolving its alias finds the binding by key.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "aliases": [
                "op.alias"
              ]
            }
          },
          "sources": {
            "s": {
              "kind": "k@1"
            }
          },
          "bindings": {
            "b1": {
              "operation": "op",
              "source": "s"
            },
            "b2": {
              "operation": "op",
              "source": "s"
            }
          }
        },
        "name": "op.alias"
      },
      "expected": {
        "outcome": "resolved",
        "operationKey": "op",
        "bindingKeys": [
          "b1",
          "b2"
        ]
      }
    },
    {
      "id": "T02-S-05",
      "clauses": [
        "OBI-T-02/c1"
      ],
      "description": "The document's name is a label, not an identifier (section 5): it names no operation.",
      "action": "resolve-operation",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "name": "createTask",
          "operations": {
            "other": {}
          }
        },
        "name": "createTask"
      },
      "expected": {
        "outcome": "not-found"
      }
    },
    {
      "id": "T02-S-06",
      "clauses": [
        "OBI-T-02/c2"
      ],
      "description": "An explicit null example member is a value that satisfies type null; an example value where no contract is stated makes no claim (section 5.1).",
      "action": "check-examples",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "loose": {
              "output": {
                "type": "null"
              },
              "examples": {
                "anyInput": {
                  "input": {
                    "free": true
                  },
                  "output": null
                }
              }
            }
          }
        },
        "operation": "loose"
      },
      "expected": {
        "examples": {
          "anyInput": {
            "input": "no-claim",
            "output": "holds"
          }
        }
      }
    }
  ]
}
