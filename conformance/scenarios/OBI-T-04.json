        "OBI-T-04/c1a"
      ],
      "description": "A supported line with an ill-formed byte elsewhere is interpreted, and a validator finds it non-conformant.",
      "action": "validate-document",
      "given": {
        "documentBase64": "eyJvcGVuYmluZGluZ3MiOiIwLjIuMCIsImRlc2NyaXB0aW9uIjoieP8iLCJvcGVyYXRpb25zIjp7fX0="
