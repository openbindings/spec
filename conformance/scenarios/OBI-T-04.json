    {
      "id": "T04-S-18",
      "clauses": [
        "OBI-T-04/c4.p3",
        "OBI-T-04/c6",
        "OBI-T-04/c7"
      ],
      "description": "A repeated openbindings member (supported value first) declares no version. A detecting tool makes no refusal and finds OBI-D-01; a duplicate-blind tool reading 0.2.0 cannot establish OBI-D-01, so it concludes undetermined; one reading 999.0.0 may refuse.",
      "action": "validate-document",
      "given": {
        "documentText": "{\"openbindings\":\"0.2.0\",\"openbindings\":\"999.0.0\",\"operations\":{}}"
      },
      "expected": {
        "outcome": "non-conformant",
        "violates": [
          "OBI-D-01"
        ],
        "duplicateBlind": {
          "0.2.0": "conformance-undetermined",
          "999.0.0": "version-refusal"
        }
      },
      "requiresSupports": "0.2.0",
      "requiresUnsupported": "999.0.0"
    },
