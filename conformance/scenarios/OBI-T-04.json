      "clauses": [
        "OBI-T-04/c8",
        "OBI-T-04/c5"
      ],
      "description": "An ill-formed byte in another string leaves the version declared, so the line decision is made.",
      "action": "validate-document",
      "given": {
        "documentBase64": "eyJvcGVuYmluZGluZ3MiOiI5OTkuMC4wIiwiZGVzY3JpcHRpb24iOiJ4/yIsIm9wZXJhdGlvbnMiOnt9fQ=="
      },
      "expected": {
        "outcome": "version-refusal"
      },
      "requiresUnsupported": "999.0.0"
    },
    {
      "id": "T04-S-09",
      "clauses": [
        "OBI-T-04/c8"
      ],
      "description": "A repeated member elsewhere leaves the version declared, so the line decision is made.",
      "action": "validate-document",
      "given": {
        "documentText": "{\"openbindings\":\"999.0.0\",\"operations\":{},\"operations\":{}}"
