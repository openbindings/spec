{
  "format": "openbindings.core-tool-scenarios@2",
  "rule": "OBI-T-04",
  "section": "10.3",
  "description": "The line decision: when a text declares a version, a processor interprets it only under a supported line or an included prerelease, refuses otherwise, reports a refusal apart from non-conformance, and never refuses a text that declares no version.",
  "scenarios": [
    {
      "id": "T04-S-01",
      "clauses": [
        "OBI-T-04/c1a"
      ],
      "description": "A release of a supported line is interpreted.",
      "action": "validate-document",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {}
        }
      },
      "expected": {
        "outcome": "conformant"
      },
      "requiresSupports": "0.2.0"
    },
    {
      "id": "T04-S-02",
      "clauses": [
        "OBI-T-04/c1a"
      ],
      "description": "A later patch of a supported line is interpreted; the patch carries no meaning.",
      "action": "validate-document",
      "given": {
        "document": {
          "openbindings": "0.2.1",
          "operations": {}
        }
      },
      "expected": {
        "outcome": "conformant"
      },
      "requiresSupports": "0.2.0"
    },
    {
      "id": "T04-S-03",
      "clauses": [
        "OBI-T-04/c1a",
        "OBI-T-04/c9.i3"
      ],
      "description": "Build metadata is ignored in the decision.",
      "action": "validate-document",
      "given": {
        "document": {
          "openbindings": "0.2.0+build.1",
          "operations": {}
        }
      },
      "expected": {
        "outcome": "conformant"
      },
      "requiresSupports": "0.2.0"
    },
    {
      "id": "T04-S-04",
      "clauses": [
        "OBI-T-04/c2",
        "OBI-T-04/c3"
      ],
      "description": "An unsupported major line is refused, not judged.",
      "action": "validate-document",
      "given": {
        "document": {
          "openbindings": "999.0.0",
          "operations": {}
        }
      },
      "expected": {
        "outcome": "version-refusal"
      },
      "requiresUnsupported": "999.0.0"
    },
    {
      "id": "T04-S-05",
      "clauses": [
        "OBI-T-04/c2",
        "OBI-T-04/c3"
      ],
