{
  "format": "openbindings.core-tool-scenarios@2",
  "rule": "OBI-T-04",
  "section": "10.3",
  "description": "A tool that claims a derived form preserves a schema's meaning must have a form that agrees with the schema on every probe; otherwise it must not make that claim.",
  "scenarios": [
    {
      "id": "T04-S-01",
      "clauses": [
        "OBI-T-04/c1"
      ],
      "description": "A derived form that cannot represent pattern must not be claimed to preserve the schema.",
      "action": "derive-form",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "input": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            }
          }
        },
        "operation": "op",
        "side": "input",
        "probes": [
          "123",
          "abc"
        ]
      },
      "expected": {
        "probeVerdicts": [
          "valid",
          "instance-mismatch"
        ]
      }
    },
    {
      "id": "T04-S-02",
      "clauses": [
        "OBI-T-04/c1"
      ],
      "description": "A derived form whose numbers cannot carry an exact const must not be claimed to preserve the schema.",
      "action": "derive-form",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "input": {
                "type": "integer",
                "const": 9007199254740993
              }
            }
          }
        },
        "operation": "op",
        "side": "input",
        "probes": [
          9007199254740993,
          9007199254740992
        ]
      },
      "expected": {
        "probeVerdicts": [
          "valid",
          "instance-mismatch"
        ]
      }
    },
    {
      "id": "T04-S-03",
      "clauses": [
        "OBI-T-04/c1"
      ],
      "description": "A derived form that admits unknown members must not be claimed to preserve unevaluatedProperties: false.",
      "action": "derive-form",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "input": {
                "type": "object",
                "properties": {
                  "a": {
                    "type": "string"
                  }
                },
                "unevaluatedProperties": false
              }
            }
          }
        },
        "operation": "op",
        "side": "input",
        "probes": [
          {
            "a": "x"
          },
          {
            "a": "x",
            "b": 1
          }
        ]
      },
      "expected": {
        "probeVerdicts": [
          "valid",
          "instance-mismatch"
        ]
      }
    },
    {
      "id": "T04-S-04",
      "clauses": [
        "OBI-T-04/c1"
      ],
      "description": "A derived form using binary floating point must not be claimed to preserve a decimal multipleOf.",
      "action": "derive-form",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "input": {
                "type": "number",
                "multipleOf": 0.01
              }
            }
          }
        },
        "operation": "op",
        "side": "input",
        "probes": [
          0.07,
          0.075
        ]
      },
      "expected": {
        "probeVerdicts": [
          "valid",
          "instance-mismatch"
        ]
      }
    }
  ]
}
