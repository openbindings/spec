{
  "format": "openbindings.core-tool-scenarios@1",
  "rule": "OBI-T-06",
  "section": "10.3",
  "description": "A productive recursive schema keeps its JSON Schema meaning; the presence of a reference cycle alone is not a reason to reject a finite value.",
  "scenarios": [
    {
      "id": "T06-S-01",
      "description": "A productive recursive schema accepts a finite matching value.",
      "action": "resolve-schema-cycle",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": { "cycle": { "input": { "$ref": "#/schemas/Node" } } },
          "schemas": {
            "Node": {
              "type": "object",
              "properties": { "next": { "$ref": "#/schemas/Node" } }
            }
          }
        },
        "operation": "cycle",
        "side": "input",
        "value": { "next": {} }
      },
      "expected": {
        "allowedOutcomes": ["valid"]
      }
    },
    {
      "id": "T06-S-02",
      "description": "A productive recursive object schema rejects a finite mismatching value.",
      "action": "resolve-schema-cycle",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": { "walk": { "input": { "$ref": "#/schemas/Node" } } },
          "schemas": {
            "Node": {
              "type": "object",
              "required": ["value"],
              "properties": {
                "value": { "type": "string" },
                "next": { "$ref": "#/schemas/Node" }
              }
            }
          }
        },
        "operation": "walk",
        "side": "input",
        "value": { "value": "root", "next": { "value": 7 } }
      },
      "expected": {
        "allowedOutcomes": ["instance-mismatch"]
      }
    }
  ]
}
