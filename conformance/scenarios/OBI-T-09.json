{
  "format": "openbindings.core-tool-scenarios@1",
  "rule": "OBI-T-09",
  "section": "10.3",
  "description": "A claimed overall conformance conclusion follows the document-rule evidence; the scenario terms are corpus-normalized outcomes, not a required report format.",
  "scenarios": [
    {
      "id": "T09-S-01",
      "description": "Every applicable rule satisfied, and an inapplicable rule, permit a conformant conclusion",
      "action": "conclude-conformance",
      "given": {
        "evidence": {
          "OBI-D-01": "satisfied",
          "OBI-D-02": "satisfied",
          "OBI-D-03": "satisfied",
          "OBI-D-04": "satisfied",
          "OBI-D-05": "satisfied",
          "OBI-D-06": "satisfied",
          "OBI-D-07": "satisfied",
          "OBI-D-08": "satisfied",
          "OBI-D-09": "satisfied",
          "OBI-D-10": "satisfied",
          "OBI-D-11": "not-applicable"
        }
      },
      "expected": {
        "conclusion": "conformant"
      }
    },
    {
      "id": "T09-S-02",
      "description": "An inconclusive applicable rule prevents a conformant conclusion",
      "action": "conclude-conformance",
      "given": {
        "evidence": {
          "OBI-D-02": "satisfied",
          "OBI-D-01": "inconclusive"
        }
      },
      "expected": {
        "conclusion": "conformance-undetermined"
      }
    },
    {
      "id": "T09-S-03",
      "description": "A known violation establishes non-conformance even if other checks remain incomplete",
      "action": "conclude-conformance",
      "given": {
        "evidence": {
          "OBI-D-02": "satisfied",
          "OBI-D-03": "violated",
          "OBI-D-10": "inconclusive"
        }
      },
      "expected": {
        "conclusion": "non-conformant"
      }
    },
    {
      "id": "T09-S-04",
      "description": "More than one known violation still establishes non-conformance",
      "action": "conclude-conformance",
      "given": {
        "evidence": {
          "OBI-D-10": "inconclusive",
          "OBI-D-08": "violated",
          "OBI-D-02": "violated",
          "OBI-D-11": "not-applicable",
          "OBI-D-01": "inconclusive"
        }
      },
      "expected": {
        "conclusion": "non-conformant"
      }
    },
    {
      "id": "T09-S-05",
      "description": "A violated rule determines non-conformance even when all other considered rules are inapplicable",
      "action": "conclude-conformance",
      "given": {
        "evidence": {
          "OBI-D-11": "not-applicable",
          "OBI-D-05": "violated"
        }
      },
      "expected": {
        "conclusion": "non-conformant"
      }
    }
  ]
}
