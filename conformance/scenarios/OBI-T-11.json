{
  "format": "openbindings.core-tool-scenarios@2",
  "rule": "OBI-T-11",
  "section": "10.3",
  "description": "When checking examples, a mismatch is a false claim against an authoritative schema; examples never widen, narrow, or override it.",
  "scenarios": [
    {
      "id": "T11-S-01",
      "clauses": [
        "OBI-T-11/c1",
        "OBI-T-02/c2"
      ],
      "description": "Each example value is checked against its schema; a mismatch is a false claim, and an explicit null is a value.",
      "action": "check-examples",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "input": {
                "type": "string"
              },
              "output": {
                "type": "integer"
              },
              "examples": {
                "good": {
                  "input": "a",
                  "output": 1
                },
                "badInput": {
                  "input": 42
                },
                "nullOutput": {
                  "output": null
                },
                "describedOnly": {
                  "description": "no values"
                }
              }
            }
          }
        },
        "operation": "op"
      },
      "expected": {
        "examples": {
          "good": {
            "input": "holds",
            "output": "holds"
          },
          "badInput": {
            "input": "false-claim"
          },
          "nullOutput": {
            "output": "false-claim"
          },
          "describedOnly": {}
        }
      }
    },
    {
      "id": "T11-S-06",
      "clauses": [
        "OBI-T-11/c2a"
      ],
      "description": "An example the schema rejects is a false claim; the checker does not widen the schema to admit it.",
      "action": "check-examples",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "input": {
                "type": "string",
                "maxLength": 3
              },
              "examples": {
                "long": {
                  "input": "abcdef"
                },
                "short": {
                  "input": "ab"
                }
              }
            }
          }
        },
        "operation": "op"
      },
      "expected": {
        "examples": {
          "long": {
            "input": "false-claim"
          },
          "short": {
            "input": "holds"
          }
        }
      }
    },
    {
      "id": "T11-S-07",
      "clauses": [
        "OBI-T-11/c2b"
      ],
      "description": "Each example is checked against the schema alone; other examples do not narrow it.",
      "action": "check-examples",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "input": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                }
              },
              "examples": {
                "one": {
                  "input": {
                    "id": "a"
                  }
                },
                "two": {
                  "input": {
                    "id": 7
                  }
                },
                "three": {
                  "input": {}
                }
              }
            }
          }
        },
        "operation": "op"
      },
      "expected": {
        "examples": {
          "one": {
            "input": "holds"
          },
          "two": {
            "input": "holds"
          },
          "three": {
            "input": "holds"
          }
        }
      }
    },
    {
      "id": "T11-S-08",
      "clauses": [
        "OBI-T-11/c2c"
      ],
      "description": "An example outside an enum is a false claim; the example does not override the enum.",
      "action": "check-examples",
      "given": {
        "document": {
          "openbindings": "0.2.0",
          "operations": {
            "op": {
              "input": {
                "enum": [
                  "a"
                ]
              },
              "examples": {
                "other": {
                  "input": "b"
                }
              }
            }
          }
        },
        "operation": "op"
      },
      "expected": {
        "examples": {
          "other": {
            "input": "false-claim"
          }
        }
      }
    }
  ]
}
