{
  "rule": "OBI-T-01",
  "section": "10.3",
  "coverage": "positive-only",
  "description": "Kind comparisons are exact and kinds are not implicitly dereferenced. An unfamiliar kind has no effect on core document validity.",
  "notes": "These positive documents show that unfamiliar kinds are valid. The fixture format cannot distinguish exact support comparison or implicit dereferencing; a tool may decline a kind-dependent action.",
  "tests": [
    {
      "description": "document declares an unknown kind",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "exotic": {
            "kind": "totally-fictional-format@9.9.9"
          }
        },
        "bindings": {
          "createTask.exotic": {
            "operation": "createTask",
            "source": "exotic"
          }
        }
      },
      "valid": true
    },
    {
      "description": "document mixes familiar and unfamiliar kinds without a core validity defect",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "http": {
            "kind": "example.openapi@1"
          },
          "exotic": {
            "kind": "totally-fictional-format@9.9.9"
          }
        },
        "bindings": {
          "createTask.http": {
            "operation": "createTask",
            "source": "http",
            "content": {
              "target": "#/paths/~1tasks/post"
            }
          },
          "createTask.exotic": {
            "operation": "createTask",
            "source": "exotic"
          }
        }
      },
      "valid": true
    },
    {
      "description": "dependency lists only an unknown kind without making the document invalid",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "kinds": [
              "totally-fictional-format@9.9.9"
            ]
          }
        }
      },
      "valid": true
    }
  ]
}
