{
  "rule": "OBI-T-01",
  "section": "10.3",
  "coverage": "positive-only",
  "description": "Does not fail processing a document solely because it contains an unsupported kind. Kind comparisons are exact; processors infer no equivalence or version relation, and do not implicitly dereference a kind.",
  "notes": "All tests are positive (valid: true) and exercise the anti-failure part of the rule: the tool does not refuse to process these inputs. A tool may emit diagnostics. Exact comparison and no implicit dereferencing are tool behavior not discriminated by this fixture format.",
  "tests": [
    {
      "description": "document declares an unknown kind",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "exotic": {
            "kind": "totally-fictional-format@9.9.9"
          }
        },
        "bindings": {
          "createTask.exotic": {
            "operation": "createTask",
            "source": "exotic"
          }
        }
      },
      "valid": true
    },
    {
      "description": "document mixes a supported and an unsupported kind; processing does not fail because of the unsupported one",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "createTask": {}
        },
        "sources": {
          "http": {
            "kind": "example.openapi@1"
          },
          "exotic": {
            "kind": "totally-fictional-format@9.9.9"
          }
        },
        "bindings": {
          "createTask.http": {
            "operation": "createTask",
            "source": "http",
            "content": {
              "target": "#/paths/~1tasks/post"
            }
          },
          "createTask.exotic": {
            "operation": "createTask",
            "source": "exotic"
          }
        }
      },
      "valid": true
    },
    {
      "description": "dependency lists only an unknown kind without making the document invalid",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "deliverEvent": {}
        },
        "dependencies": {
          "delivery": {
            "operation": "deliverEvent",
            "kinds": [
              "totally-fictional-format@9.9.9"
            ]
          }
        }
      },
      "valid": true
    }
  ]
}
