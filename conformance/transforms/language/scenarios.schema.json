{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "kind",
    "language",
    "sources",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "language-semantics"
    },
    "language": {
      "const": "jsonata-2.1"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "expr",
          "inputJSON",
          "authority",
          "reason",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LANG-[0-9]+$"
          },
          "expr": {
            "type": "string"
          },
          "inputJSON": {
            "type": "string"
          },
          "authority": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "json"
                ],
                "properties": {
                  "status": {
                    "const": "json"
                  },
                  "json": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "failure"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
