{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference transform numerical-contract scenarios",
  "type": "object",
  "required": ["format", "rule", "capacity", "cases"],
  "additionalProperties": false,
  "properties": {
    "format": {"const":"openbindings.transform-numerical-scenarios@1"},
    "rule": {"const":"OBI-T-10"},
    "capacity": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/capacity"}},
    "cases": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/case"}}
  },
  "$defs": {
    "magnitude": {"type":"string","pattern":"^(binary64-min-positive|binary64-max-finite|[1-9][0-9]*(\\.[0-9]+)?([eE][+-]?[0-9]+)?)$","maxLength":1024},
    "capacity": {
      "type":"object","additionalProperties":false,
      "required":["id","radix","precision","minimumPositive","maximumFinite","underflowStep","rounding","eligible"],
      "properties": {
        "id":{"type":"string","minLength":1},
        "radix":{"type":"integer","minimum":2,"maximum":36},
        "precision":{"type":"integer","minimum":1,"maximum":4096},
        "minimumPositive":{"$ref":"#/$defs/magnitude"},
        "maximumFinite":{"$ref":"#/$defs/magnitude"},
        "underflowStep":{"$ref":"#/$defs/magnitude"},
        "rounding":{"enum":["nearest-ties-even","toward-zero"]},
        "eligible":{"type":"boolean"}
      }
    },
    "outcome": {
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["status","json"],"properties":{"status":{"const":"json"},"json":{"type":"string"}}},
        {"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"const":"failure"}}}
      ]
    },
    "case": {
      "type":"object","additionalProperties":false,
      "required":["id","expr","inputJSON","syntaxValid","reference","exact34"],
      "properties": {
        "id":{"type":"string","minLength":1},
        "expr":{"type":"string"},
        "inputJSON":{"type":"string"},
        "syntaxValid":{"type":"boolean"},
        "reference":{"$ref":"#/$defs/outcome"},
        "exact34":{"$ref":"#/$defs/outcome"}
      }
    }
  }
}
