{
  "openbindings": "0.2.0",
  "name": "OpenBlendings",
  "version": "1.0.0",
  "description": "A coffee shop with bindings across six families: REST (OpenAPI), events (AsyncAPI/SSE), AI tools (MCP), internal RPC (gRPC), Connect (Buf), and GraphQL. One interface, six binding specifications.",
  "schemas": {
    "MenuItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "price": {
                "type": "number"
              }
            },
            "required": [
              "label",
              "price"
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "sizes"
      ]
    },
    "Menu": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/MenuItem"
          }
        }
      }
    },
    "PlaceOrderInput": {
      "type": "object",
      "properties": {
        "drink": {
          "type": "string",
          "description": "Menu item ID"
        },
        "size": {
          "type": "string",
          "description": "Size label (v1, v2, or v3)"
        },
        "customer": {
          "type": "string",
          "description": "Customer name"
        }
      },
      "required": [
        "drink",
        "size",
        "customer"
      ]
    },
    "Order": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "drink": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "customer": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "preparing",
            "ready",
            "picked_up",
            "cancelled"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "drink",
        "size",
        "customer",
        "status",
        "createdAt"
      ]
    },
    "OrderStatusInput": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        }
      },
      "required": [
        "orderId"
      ]
    },
    "CancelOrderInput": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        }
      },
      "required": [
        "orderId"
      ]
    },
    "CancelOrderOutput": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "OrderUpdate": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "preparing",
            "ready",
            "picked_up",
            "cancelled"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderId",
        "status",
        "updatedAt"
      ]
    }
  },
  "operations": {
    "getMenu": {
      "description": "Returns the full menu with drinks, sizes, and prices.",
      "idempotent": true,
      "output": {
        "$ref": "#/schemas/Menu"
      }
    },
    "placeOrder": {
      "description": "Place a new order. Returns the order with its ID and initial status.",
      "input": {
        "$ref": "#/schemas/PlaceOrderInput"
      },
      "output": {
        "$ref": "#/schemas/Order"
      }
    },
    "getOrderStatus": {
      "description": "Check the current status of an order by ID.",
      "idempotent": true,
      "input": {
        "$ref": "#/schemas/OrderStatusInput"
      },
      "output": {
        "$ref": "#/schemas/Order"
      }
    },
    "cancelOrder": {
      "description": "Cancel a pending order. Only works if the order has not started preparation.",
      "input": {
        "$ref": "#/schemas/CancelOrderInput"
      },
      "output": {
        "$ref": "#/schemas/CancelOrderOutput"
      }
    },
    "orderUpdates": {
      "description": "Stream of order state transitions. Emitted whenever an order changes status.",
      "output": {
        "$ref": "#/schemas/OrderUpdate"
      }
    }
  },
  "sources": {
    "rest": {
      "bindingSpec": "openbindings.openapi-3.1@1",
      "content": {
        "location": "https://blend.openbindings.com/openapi.json"
      },
      "description": "REST API for the ordering app"
    },
    "events": {
      "bindingSpec": "openbindings.asyncapi@1",
      "content": {
        "location": "https://blend.openbindings.com/asyncapi.json"
      },
      "description": "SSE event stream for the barista dashboard"
    },
    "mcp": {
      "bindingSpec": "openbindings.mcp@1",
      "content": {
        "location": "https://blend.openbindings.com/mcp"
      },
      "description": "MCP tools for AI assistants"
    },
    "grpc": {
      "bindingSpec": "openbindings.grpc@1",
      "content": {
        "location": "blend.openbindings.com:9090"
      },
      "description": "gRPC service for backend microservices"
    },
    "connect": {
      "bindingSpec": "openbindings.connect@1",
      "content": {
        "location": "https://blend.openbindings.com"
      },
      "description": "Connect (Buf) — same protobuf service over HTTP/1.1 + JSON"
    },
    "graphql": {
      "bindingSpec": "openbindings.graphql@1",
      "content": {
        "location": "https://blend.openbindings.com/graphql"
      },
      "description": "GraphQL API — flexible queries and subscriptions"
    }
  },
  "bindings": {
    "getMenu.rest": {
      "operation": "getMenu",
      "source": "rest",
      "content": {
        "target": "#/paths/~1api~1menu/get"
      }
    },
    "getMenu.mcp": {
      "operation": "getMenu",
      "source": "mcp",
      "content": {
        "target": "tools/getMenu"
      }
    },
    "getMenu.grpc": {
      "operation": "getMenu",
      "source": "grpc",
      "content": {
        "target": "blend.CoffeeShop/GetMenu"
      }
    },
    "getMenu.connect": {
      "operation": "getMenu",
      "source": "connect",
      "content": {
        "target": "blend.CoffeeShop/GetMenu"
      }
    },
    "placeOrder.rest": {
      "operation": "placeOrder",
      "source": "rest",
      "content": {
        "target": "#/paths/~1api~1orders/post"
      }
    },
    "placeOrder.mcp": {
      "operation": "placeOrder",
      "source": "mcp",
      "content": {
        "target": "tools/placeOrder"
      }
    },
    "placeOrder.grpc": {
      "operation": "placeOrder",
      "source": "grpc",
      "content": {
        "target": "blend.CoffeeShop/PlaceOrder"
      }
    },
    "placeOrder.connect": {
      "operation": "placeOrder",
      "source": "connect",
      "content": {
        "target": "blend.CoffeeShop/PlaceOrder"
      }
    },
    "getOrderStatus.rest": {
      "operation": "getOrderStatus",
      "source": "rest",
      "content": {
        "target": "#/paths/~1api~1orders~1{orderId}/get"
      }
    },
    "getOrderStatus.mcp": {
      "operation": "getOrderStatus",
      "source": "mcp",
      "content": {
        "target": "tools/getOrderStatus"
      }
    },
    "getOrderStatus.grpc": {
      "operation": "getOrderStatus",
      "source": "grpc",
      "content": {
        "target": "blend.CoffeeShop/GetOrderStatus"
      }
    },
    "getOrderStatus.connect": {
      "operation": "getOrderStatus",
      "source": "connect",
      "content": {
        "target": "blend.CoffeeShop/GetOrderStatus"
      }
    },
    "cancelOrder.rest": {
      "operation": "cancelOrder",
      "source": "rest",
      "content": {
        "target": "#/paths/~1api~1orders~1{orderId}~1cancel/post"
      }
    },
    "cancelOrder.mcp": {
      "operation": "cancelOrder",
      "source": "mcp",
      "content": {
        "target": "tools/cancelOrder"
      }
    },
    "cancelOrder.grpc": {
      "operation": "cancelOrder",
      "source": "grpc",
      "content": {
        "target": "blend.CoffeeShop/CancelOrder"
      }
    },
    "cancelOrder.connect": {
      "operation": "cancelOrder",
      "source": "connect",
      "content": {
        "target": "blend.CoffeeShop/CancelOrder"
      }
    },
    "orderUpdates.events": {
      "operation": "orderUpdates",
      "source": "events",
      "content": {
        "target": "#/operations/onOrderUpdate"
      }
    },
    "orderUpdates.grpc": {
      "operation": "orderUpdates",
      "source": "grpc",
      "content": {
        "target": "blend.CoffeeShop/OrderUpdates"
      }
    },
    "getMenu.graphql": {
      "operation": "getMenu",
      "source": "graphql",
      "content": {
        "target": "Query/getMenu"
      }
    },
    "placeOrder.graphql": {
      "operation": "placeOrder",
      "source": "graphql",
      "content": {
        "target": "Mutation/placeOrder"
      }
    },
    "getOrderStatus.graphql": {
      "operation": "getOrderStatus",
      "source": "graphql",
      "content": {
        "target": "Query/getOrderStatus"
      }
    },
    "cancelOrder.graphql": {
      "operation": "cancelOrder",
      "source": "graphql",
      "content": {
        "target": "Mutation/cancelOrder"
      }
    },
    "orderUpdates.graphql": {
      "operation": "orderUpdates",
      "source": "graphql",
      "content": {
        "target": "Subscription/orderUpdates"
      }
    }
  }
}
