{
  "openbindings": "0.2.0",
  "name": "Task Export Service",
  "version": "1.0",
  "description": "A service that provides export creation and consumes a caller-supplied delivery operation.",
  "operations": {
    "exports.create": {
      "description": "Start an export.",
      "input": {
        "type": "object",
        "properties": {
          "format": {
            "enum": ["csv", "json"]
          }
        },
        "required": ["format"]
      },
      "output": {
        "type": "object",
        "properties": {
          "exportId": {
            "type": "string"
          }
        },
        "required": ["exportId"]
      }
    },
    "exports.deliver": {
      "description": "Deliver a completed export to a consumer.",
      "input": {
        "type": "object",
        "properties": {
          "exportId": {
            "type": "string"
          },
          "downloadUrl": {
            "type": "string"
          }
        },
        "required": ["exportId", "downloadUrl"]
      },
      "output": {
        "type": "object"
      }
    }
  },
  "dependencies": {
    "completedExportDelivery": {
      "operation": "exports.deliver",
      "kinds": [
        "openbindings.openapi-3.1@1",
        "openbindings.grpc@1"
      ]
    }
  },
  "sources": {
    "exportsApi": {
      "kind": "openbindings.openapi-3.1@1",
      "content": { "location": "https://exports.example.com/openapi.json" }
    }
  },
  "bindings": {
    "exports.create.http": {
      "operation": "exports.create",
      "source": "exportsApi",
      "content": { "target": "#/paths/~1exports/post" }
    }
  }
}
