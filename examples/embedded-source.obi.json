{
  "openbindings": "0.2.0",
  "name": "Task Service",
  "description": "One embedded OpenAPI document, carried as a source's data and shared by two bindings; the operations use a copy of its Task schema, held in schemas.",
  "operations": {
    "createTask": {
      "input": {
        "type": "object",
        "properties": {
          "title": {"type": "string"}
        },
        "required": ["title"]
      },
      "output": {"$ref": "#/schemas/Task"}
    },
    "listTasks": {
      "input": {"type": "object", "maxProperties": 0},
      "output": {"$ref": "#/schemas/TaskList"}
    }
  },
  "sources": {
    "tasksApi": {
      "kind": "example.openapi@1",
      "data": {
        "openapi": "3.1.0",
        "info": {"title": "Tasks API", "version": "1.0.0"},
        "servers": [
          {"url": "https://tasks.example.com"}
        ],
        "paths": {
          "/tasks": {
            "get": {
              "responses": {
                "200": {
                  "description": "Task list",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "array",
                        "items": {"$ref": "#/components/schemas/Task"}
                      }
                    }
                  }
                }
              }
            },
            "post": {
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "title": {"type": "string"}
                      },
                      "required": ["title"]
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "Created task",
                  "content": {
                    "application/json": {
                      "schema": {"$ref": "#/components/schemas/Task"}
                    }
                  }
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "Task": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "title": {"type": "string"}
              },
              "required": ["id", "title"]
            }
          }
        }
      }
    }
  },
  "bindings": {
    "createTask.http": {
      "operation": "createTask",
      "source": "tasksApi",
      "data": {"target": "#/paths/~1tasks/post"}
    },
    "listTasks.http": {
      "operation": "listTasks",
      "source": "tasksApi",
      "data": {"target": "#/paths/~1tasks/get"}
    }
  },
  "schemas": {
    "Task": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"}
      },
      "required": ["id", "title"]
    },
    "TaskList": {
      "type": "array",
      "items": {"$ref": "#/schemas/Task"}
    }
  }
}
