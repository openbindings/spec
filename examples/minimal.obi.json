{
  "openbindings": "0.2.0",
  "name": "Echo Service",
  "version": "1.0.0",
  "description": "A minimal OpenBindings interface with a single operation, one source, and one binding.",
  "operations": {
    "echo": {
      "description": "Echo a message back unchanged.",
      "input": {
        "type": "object",
        "properties": {
          "message": {"type": "string", "description": "The message to echo back"}
        },
        "required": ["message"]
      },
      "output": {
        "type": "object",
        "properties": {
          "message": {"type": "string"}
        }
      }
    }
  },
  "sources": {
    "restApi": {
      "kind": "example.openapi@1",
      "data": {"location": "https://api.example.com/openapi.json"}
    }
  },
  "bindings": {
    "echo.restApi": {
      "operation": "echo",
      "source": "restApi",
      "data": {"target": "#/paths/~1echo/post"},
      "idempotent": true
    }
  }
}
