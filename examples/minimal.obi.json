{
  "openbindings": "0.2.0",
  "name": "Echo Service",
  "version": "1.0.0",
  "description": "A minimal OpenBindings interface with a single operation and one binding.",
  "operations": {
    "echo": {
      "description": "Echo a message back unchanged.",
      "input": {
        "type": "object",
        "properties": {
          "message": {"type": "string", "description": "The message to echo back"}
        },
        "required": ["message"]
      },
      "output": {
        "type": "object",
        "properties": {
          "message": {"type": "string"}
        }
      }
    }
  },
  "bindings": {
    "echo.restApi": {
      "operation": "echo",
      "kind": "example.openapi@1",
      "content": {
        "document": {"location": "https://api.example.com/openapi.json"},
        "target": "#/paths/~1echo/post"
      },
      "idempotent": true
    }
  }
}
